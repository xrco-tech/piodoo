# Minimal Asterisk image built from Debian — multi-arch (works on the ARM64 box).
# NB: bookworm (Debian 12) dropped the asterisk package; trixie (Debian 13) ships
# Asterisk 20.x with chan_pjsip, res_http_websocket and res_srtp (DTLS-SRTP) —
# everything WebRTC needs.
FROM debian:trixie-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      asterisk \
      asterisk-modules \
      asterisk-core-sounds-en-gsm \
      ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# Config is mounted at runtime; entrypoint (mounted) renders templates then
# execs `asterisk -f`.
CMD ["asterisk", "-f"]
