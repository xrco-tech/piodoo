# Copy to .env (same dir as docker-compose.asterisk.yml) and fill in.
# ── Vox SIP trunk ────────────────────────────────────────────────────────────
VOX_SIP_HOST=sip.vox.co.za          # confirm with Vox
VOX_SIP_PORT=5060
VOX_USERNAME=your_vox_trunk_user    # if registration auth; leave blank for IP auth
VOX_SECRET=your_vox_trunk_secret
VOX_DID=+2710XXXXXXX                # your caller-ID number from Vox
VOX_CODECS=alaw,ulaw

# ── This host (for WebRTC media reachability) ────────────────────────────────
# Public IP of the ubuntu box, or the TURN/external address browsers reach.
# Media (RTP) does NOT go through the Cloudflare tunnel.
EXTERNAL_IP=CHANGE_ME
LOCAL_NET=100.64.0.0/10             # tailscale/LAN that should NOT be NATed

# ── ARI (must match asterisk/etc/ari.conf and the bridge service) ────────────
ARI_USERNAME=odoo
ARI_PASSWORD=CHANGE_ME_STRONG
ARI_APP=comm_dialer

# ── WebRTC / TLS ─────────────────────────────────────────────────────────────
WSS_CERT=/etc/asterisk/keys/fullchain.pem
WSS_KEY=/etc/asterisk/keys/privkey.pem

# ── TURN (coturn) — relays agent WebRTC audio when the box isn't directly
# reachable. coturn itself must be PUBLICLY reachable, so EXTERNAL_IP above must
# be a public IP. Odoo mints time-limited ICE creds from TURN_SECRET.
# Open on the host: 3478 (udp+tcp), 5349/tcp (turns), 20000-20200/udp (relay).
TURN_REALM=dialer.tselaglobalnavtech.co.za
TURN_SECRET=CHANGE_ME_TURN_SHARED_SECRET
