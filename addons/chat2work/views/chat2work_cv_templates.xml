<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Public CV page (/cv/<token>). Self-contained: inline CSS and system fonts, so it loads fast
         on low-end phones and little data. A small script splits the CV form into
         steps (static/src/js/cv_steps.js); without it the form stays one long page. -->
    <template id="cv_page" name="Chat2Work CV page">&lt;!DOCTYPE html&gt;
        <t t-set="d" t-value="details or {}"/>
        <html lang="en">
        <head>
            <meta charset="utf-8"/>
            <meta name="viewport" content="width=device-width, initial-scale=1"/>
            <meta name="robots" content="noindex, nofollow"/>
            <title>Chat2Work · Your CV</title>
            <style>
                :root { --hivis:#ffc414; --navy:#1b2a41; --ink:#16202e; --muted:#586273; --paper:#f7f6f1; --line:#dcdcd4; --ok:#1f8a5b; --bad:#a3261b; }
                * { box-sizing:border-box; }
                body { margin:0; background:var(--paper); color:var(--ink); font:16px/1.5 -apple-system, "Segoe UI", Roboto, Arial, sans-serif; }
                header { background:var(--hivis); padding:20px 16px 18px; }
                header .brand { display:block; }
                header h1 { margin:6px 0 0; font-size:26px; line-height:1.15; }
                main { max-width:640px; margin:0 auto; padding:16px; display:grid; gap:14px; }
                .card { background:#fff; border:1px solid var(--line); border-radius:8px; }
                details > summary { list-style:none; cursor:pointer; padding:16px; font-weight:700; font-size:18px; display:flex; justify-content:space-between; gap:12px; }
                details > summary::-webkit-details-marker { display:none; }
                details > summary::after { content:"+"; font-size:22px; line-height:1; color:var(--muted); }
                details[open] > summary::after { content:"–"; }
                details > summary small { display:block; font-weight:400; font-size:14px; color:var(--muted); }
                .body { padding:0 16px 16px; display:grid; gap:12px; }
                label { display:grid; gap:4px; font-weight:700; font-size:14px; }
                label span { font-weight:400; color:var(--muted); }
                input, textarea, select { width:100%; font:inherit; font-weight:400; padding:10px 12px; border:1px solid #b9bcc2; border-radius:6px; background:#fff; color:var(--ink); }
                textarea { min-height:84px; }
                fieldset { border:1px dashed var(--line); border-radius:6px; padding:10px 12px; display:grid; gap:10px; margin:0; }
                legend { font-weight:700; font-size:14px; padding:0 4px; }
                .btn { display:inline-block; width:100%; text-align:center; padding:13px 16px; border:0; border-radius:6px; font:inherit; font-weight:700; background:var(--navy); color:#fff; cursor:pointer; text-decoration:none; }
                .btn.alt { background:var(--hivis); color:var(--ink); }
                .msg { padding:12px 14px; border-radius:6px; font-weight:700; }
                .msg.ok { background:#e3f3ea; color:var(--ok); }
                .msg.bad { background:#f8e3e1; color:var(--bad); }
                .status { padding:14px 16px; font-size:15px; }
                .fine { font-size:13px; color:var(--muted); text-align:center; }
                :focus-visible { outline:3px solid var(--navy); outline-offset:2px; }
                [hidden] { display:none !important; }
                h2 { margin:0; font-size:20px; line-height:1.2; }
                h2:focus { outline:none; }
                .step { display:grid; gap:12px; }
                .step + .step { margin-top:12px; }
                .js-only { display:none; }
                .js-on .js-only { display:revert; }
                .js-on .no-js { display:none !important; }
                .js-on .row-card { display:flex; }
                .js-on .steps-nav, .js-on .progress-box, .js-on #job_ask, .js-on #job_none_note, .js-on #cv_review { display:grid; }
                .js-on .row { border:0; padding:0; }
                .js-on .row legend { display:none; }
                .js-on .step + .step { margin-top:0; }
                .js-on.building > .card:not(.build), .js-on.building > .status, .js-on.building > .fine { display:none; }
                .js-on.building .build > summary { display:none; }
                .js-on.building .build > form { padding-top:16px; }
                .row-fields { display:grid; gap:10px; }
                .row-card { display:flex; align-items:flex-start; gap:12px; border:1px solid var(--line); border-radius:8px; padding:10px 12px; background:#fff; }
                .row-card > div { flex:1 1 auto; min-width:0; overflow-wrap:anywhere; }
                .row-card b { display:block; }
                .row-card small { display:block; font-size:14px; color:var(--muted); }
                .row-card small.pre { white-space:pre-line; }
                .link { background:none; border:0; padding:0; min-width:44px; min-height:44px; font:inherit; font-size:14px; color:var(--ink); text-decoration:underline; cursor:pointer; }
                .link.bad { color:var(--bad); }
                .btn.line { background:#fff; color:var(--ink); border:1px solid var(--navy); }
                .btn:disabled { background:#d5d7db; color:#4a5261; cursor:not-allowed; }
                .js-on .chips-fs { border:0; padding:0; }
                .chips-fs { display:block; }
                .chips-fs legend { padding:0 0 8px; }
                .chips { display:flex; flex-wrap:wrap; gap:8px; }
                .chip { display:block; font-weight:400; font-size:15px; position:relative; }
                .chip input { position:absolute; opacity:0; width:100%; height:100%; margin:0; padding:0; cursor:pointer; }
                .chip span { display:block; min-height:44px; padding:9px 14px; border:1px solid var(--navy); border-radius:22px; background:#fff; color:var(--ink); }
                .chip input:checked + span { background:var(--navy); color:#fff; }
                .chip input:focus-visible + span { outline:3px solid var(--navy); outline-offset:2px; }
                .progress-box { display:grid; gap:6px; }
                .progress-top { display:flex; justify-content:space-between; font-size:14px; font-weight:700; }
                .progress-top span:last-child { font-weight:400; color:var(--muted); }
                .progress { display:grid; grid-template-columns:repeat(5, minmax(0, 1fr)); gap:4px; }
                .progress i { height:6px; border-radius:3px; background:#e8e6da; }
                .progress i.on { background:var(--navy); }
                .steps-nav { position:sticky; bottom:0; display:grid; grid-template-columns:1fr 2fr; gap:10px; background:#fff; padding:12px 0 4px; border-top:1px solid var(--line); }
            </style>
        </head>
        <body>
            <header>
                <img class="brand" src="/chat2work/static/src/img/chat2work_logo_navy.svg" alt="Chat2Work" width="124" height="50"/>
                <h1 t-if="candidate">
                    <t t-if="first_name">Hi <t t-out="first_name"/>, let's</t><t t-else="">Let's</t> get your CV ready
                </h1>
                <h1 t-else="">This link has expired</h1>
            </header>
            <main>
                <t t-if="not candidate">
                    <div class="card status">
                        CV links work for 30 days. To get a new one, dial <b>*134*433*48#</b> or send
                        "Ispani" on WhatsApp.
                    </div>
                </t>
                <t t-else="">
                    <div t-if="notice == 'uploaded'" class="msg ok">Thanks! We've received your CV.</div>
                    <div t-if="notice == 'built'" class="msg ok">Your CV is ready. <a t-attf-href="/cv/#{token}/download">Download it (PDF)</a>.</div>
                    <div t-if="notice == 'built'" class="card status"><b>What happens next</b><br/>Chat2Work can now consider you for work that fits. We'll contact you on WhatsApp or by SMS. Joining doesn't guarantee a job.</div>
                    <div t-if="notice == 'help'" class="msg ok">Got it. A Chat2Work agent will call you to help with your CV.</div>
                    <div t-if="error" class="msg bad" role="alert" t-out="error"/>

                    <div class="card status" t-if="candidate.cv_state != 'none' and not notice">
                        <t t-if="candidate.cv_state == 'started'">We saved your answers, so you can carry on where you stopped.</t>
                        <t t-if="candidate.cv_state == 'uploaded'">We have your uploaded CV. You can upload a new one or build one below.</t>
                        <t t-if="candidate.cv_state == 'built'">Your CV is ready. <a t-attf-href="/cv/#{token}/download">Download it (PDF)</a>, or update it below.</t>
                        <t t-if="candidate.cv_state == 'help_requested'">An agent will call you<t t-if="masked_phone"> on <t t-out="masked_phone"/></t> to help with your CV.</t>
                    </div>

                    <details class="card" t-att-open="'open' if error and not open_build else None">
                        <summary><div>I have a CV<small>Upload a PDF, Word file or a photo of it</small></div></summary>
                        <form class="body" method="post" enctype="multipart/form-data" t-attf-action="/cv/#{token}/upload">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <label for="cv_file">Your CV <span>PDF, DOC, DOCX, JPG or PNG, up to 5 MB</span>
                                <input id="cv_file" type="file" name="cv_file" required="required"
                                       accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.heic,image/*"/>
                            </label>
                            <button class="btn" type="submit">Upload my CV</button>
                        </form>
                    </details>

                    <details class="card build" t-att-open="'open' if open_build else None">
                        <summary><div>Build my CV<small>5 short steps, and we'll make a polished PDF.<span class="js-only"> Your answers are saved as you go, so you can stop and come back.</span></small></div></summary>
                        <form id="cv_build_form" class="body" method="post" t-attf-action="/cv/#{token}/build"
                              t-attf-data-draft-url="/cv/#{token}/draft" t-att-data-start-step="start_step">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                            <div class="progress-box js-only">
                                <div class="progress-top"><span id="cv_step_label">Step 1 of 5</span><span id="cv_saved" role="status"/></div>
                                <div id="cv_progress" class="progress" role="img" aria-label="Step 1 of 5"><i/><i/><i/><i/><i/></div>
                            </div>

                            <section class="step">
                                <h2 tabindex="-1">About you</h2>
                                <div id="name_err" class="msg bad" role="alert" hidden="hidden">Please enter your full name.</div>
                                <label for="full_name">Full name
                                    <input id="full_name" name="full_name" required="required" maxlength="80" autocomplete="name"
                                           t-att-value="d.get('full_name') or candidate.name or ''"/>
                                </label>
                                <label for="town">Town or area <span>e.g. Soweto</span>
                                    <input id="town" name="town" maxlength="80" t-att-value="d.get('town') or candidate.location or ''"/>
                                </label>
                                <label for="email">Email <span>optional</span>
                                    <input id="email" name="email" type="email" maxlength="120" autocomplete="email" t-att-value="d.get('email', '')"/>
                                </label>
                            </section>

                            <section class="step">
                                <h2 tabindex="-1">Work experience</h2>
                                <div id="job_ask" class="step js-only">
                                    <p style="margin:0">Have you worked before? Piece jobs, helping in a family business and volunteering all count.</p>
                                    <button id="job_add_first" type="button" class="btn">Yes, add a job</button>
                                    <button id="job_none" type="button" class="btn line">I don't have work experience yet</button>
                                </div>
                                <div id="job_none_note" class="step js-only" hidden="hidden">
                                    <div class="msg ok" style="font-weight:400" role="status"><b>No problem.</b> Lots of people start here. Your CV will lead with your education and skills instead.</div>
                                    <button id="job_none_undo" type="button" class="link">Actually, I have worked before</button>
                                </div>
                                <label class="no-js" style="display:flex; gap:8px; align-items:center; font-weight:400">
                                    <input id="no_experience" type="checkbox" name="no_experience" value="1" style="width:auto"
                                           t-att-checked="'checked' if d.get('no_experience') else None"/>
                                    I don't have work experience yet
                                </label>
                                <t t-foreach="rows" t-as="i">
                                    <t t-set="job" t-value="(d.get('experience') or [])[i] if i &lt; len(d.get('experience') or []) else {}"/>
                                    <fieldset class="row" data-kind="job" t-attf-data-required="job_role_#{i}" t-attf-data-sub="job_employer_#{i},job_dates_#{i}">
                                        <legend>Job <t t-out="i + 1"/> <small style="font-weight:400">(optional)</small></legend>
                                        <div class="row-err msg bad" role="alert" hidden="hidden">Please enter what your job was.</div>
                                        <div class="row-fields">
                                            <label t-attf-for="job_role_#{i}">What was the job? <span>e.g. Cashier</span>
                                                <input t-attf-id="job_role_#{i}" t-attf-name="job_role_#{i}" maxlength="120" t-att-value="job.get('role', '')"/>
                                            </label>
                                            <label t-attf-for="job_employer_#{i}">Where did you work? <span>business or person's name</span>
                                                <input t-attf-id="job_employer_#{i}" t-attf-name="job_employer_#{i}" maxlength="120" t-att-value="job.get('employer', '')"/>
                                            </label>
                                            <label t-attf-for="job_dates_#{i}">When? <span>e.g. 2023 to 2024</span>
                                                <input t-attf-id="job_dates_#{i}" t-attf-name="job_dates_#{i}" maxlength="120" t-att-value="job.get('dates', '')"/>
                                            </label>
                                            <label t-attf-for="job_duties_#{i}">What did you do there? <span>optional</span>
                                                <textarea t-attf-id="job_duties_#{i}" t-attf-name="job_duties_#{i}" maxlength="400"><t t-out="job.get('duties', '')"/></textarea>
                                            </label>
                                            <button type="button" class="btn row-save js-only">Save this job</button>
                                            <button type="button" class="link row-cancel js-only">Cancel</button>
                                        </div>
                                        <div class="row-card js-only" hidden="hidden">
                                            <div><b/><small/></div>
                                            <button type="button" class="link row-edit">Edit</button>
                                            <button type="button" class="link bad row-remove">Remove</button>
                                        </div>
                                    </fieldset>
                                </t>
                                <button id="job_add" type="button" class="btn line js-only" hidden="hidden">Add another job</button>
                            </section>

                            <section class="step">
                                <h2 tabindex="-1">Education</h2>
                                <t t-foreach="rows" t-as="i">
                                    <t t-set="edu" t-value="(d.get('education') or [])[i] if i &lt; len(d.get('education') or []) else {}"/>
                                    <fieldset class="row" data-kind="edu" t-attf-data-required="edu_school_#{i}" t-attf-data-sub="edu_qualification_#{i},edu_year_#{i}">
                                        <legend>School or course <t t-out="i + 1"/> <small style="font-weight:400">(optional)</small></legend>
                                        <div class="row-err msg bad" role="alert" hidden="hidden">Please enter your school or college.</div>
                                        <div class="row-fields">
                                            <label t-attf-for="edu_school_#{i}">School or college
                                                <input t-attf-id="edu_school_#{i}" t-attf-name="edu_school_#{i}" maxlength="120" t-att-value="edu.get('school', '')"/>
                                            </label>
                                            <label t-attf-for="edu_qualification_#{i}">What did you finish or study? <span>e.g. Matric, or Grade 11</span>
                                                <input t-attf-id="edu_qualification_#{i}" t-attf-name="edu_qualification_#{i}" maxlength="120" t-att-value="edu.get('qualification', '')"/>
                                            </label>
                                            <label t-attf-for="edu_year_#{i}">Year <span>optional</span>
                                                <input t-attf-id="edu_year_#{i}" t-attf-name="edu_year_#{i}" maxlength="20" inputmode="numeric" t-att-value="edu.get('year', '')"/>
                                            </label>
                                            <button type="button" class="btn row-save js-only">Save this</button>
                                            <button type="button" class="link row-cancel js-only">Cancel</button>
                                        </div>
                                        <div class="row-card js-only" hidden="hidden">
                                            <div><b/><small/></div>
                                            <button type="button" class="link row-edit">Edit</button>
                                            <button type="button" class="link bad row-remove">Remove</button>
                                        </div>
                                    </fieldset>
                                </t>
                                <button id="edu_add" type="button" class="btn line js-only">Add your school or course</button>
                            </section>

                            <section class="step">
                                <h2 tabindex="-1">Your skills</h2>
                                <fieldset class="chips-fs">
                                    <legend>What can you do? Tap all that fit.</legend>
                                    <div class="chips">
                                        <label t-foreach="skill_options" t-as="opt" class="chip">
                                            <input type="checkbox" name="skill_opt" t-att-value="opt" t-att-checked="'checked' if opt in skills_ticked else None"/>
                                            <span t-out="opt"/>
                                        </label>
                                    </div>
                                </fieldset>
                                <label for="skills">Anything else? <span>optional, e.g. hair braiding, forklift</span>
                                    <input id="skills" name="skills" maxlength="200" t-att-value="skills_other"/>
                                </label>
                                <fieldset class="chips-fs">
                                    <legend>Which languages do you speak?</legend>
                                    <div class="chips">
                                        <label t-foreach="language_options" t-as="opt" class="chip">
                                            <input type="checkbox" name="lang_opt" t-att-value="opt" t-att-checked="'checked' if opt in langs_ticked else None"/>
                                            <span t-out="opt"/>
                                        </label>
                                    </div>
                                </fieldset>
                                <label for="languages">Other languages <span>optional</span>
                                    <input id="languages" name="languages" maxlength="100" t-att-value="langs_other"/>
                                </label>
                                <label for="licence">Driver's licence
                                    <select id="licence" name="licence">
                                        <t t-foreach="['None', 'Learner\'s', 'Code 8 (B)', 'Code 10 (C1)', 'Code 14 (EC)']" t-as="opt">
                                            <option t-att-value="opt" t-att-selected="'selected' if d.get('licence') == opt else None" t-out="opt"/>
                                        </t>
                                    </select>
                                </label>
                            </section>

                            <section class="step">
                                <h2 tabindex="-1" class="js-only">Check your CV</h2>
                                <label for="summary">About you <span>optional: 2 or 3 sentences about your strengths and the work you want</span>
                                    <textarea id="summary" name="summary" maxlength="600"><t t-out="d.get('summary', '')"/></textarea>
                                </label>
                                <div id="cv_review" class="step js-only"/>
                                <button class="btn no-js" type="submit">Create my CV</button>
                            </section>

                            <div id="cv_nav" class="steps-nav js-only">
                                <button id="cv_back" type="button" class="btn line">Back</button>
                                <button id="cv_next" type="button" class="btn alt">Next</button>
                            </div>
                        </form>
                    </details>

                    <details class="card">
                        <summary><div>Help me<small>An agent calls you and helps you write it</small></div></summary>
                        <form class="body" method="post" t-attf-action="/cv/#{token}/help">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <p style="margin:0">We'll call you<t t-if="masked_phone"> on <b t-out="masked_phone"/></t> within one business day.</p>
                            <button class="btn alt" type="submit">Ask for help</button>
                        </form>
                    </details>
                    <p class="fine">This link is personal and works until <t t-out="candidate.cv_token_expires.strftime('%d %b %Y')"/>. Chat2Work never asks for money.</p>
                </t>
            </main>
            <script t-if="candidate" src="/chat2work/static/src/js/cv_steps.js?v=3" defer="defer"/>
        </body>
        </html>
    </template>

    <!-- The standard CV, rendered to PDF from the form answers (cv_data). -->
    <record id="paperformat_cv" model="report.paperformat">
        <field name="name">Chat2Work CV (A4, no letterhead)</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">15</field>
        <field name="margin_right">15</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
    <record id="action_report_cv" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_cv"/>
        <field name="name">Chat2Work CV</field>
        <field name="model">chat2work.candidate</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">chat2work.report_cv</field>
        <field name="print_report_name">'CV - %s' % (object.name or 'Candidate')</field>
        <field name="binding_type">report</field>
    </record>

    <template id="report_cv">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc"><t t-call="web.basic_layout">
                <t t-set="d" t-value="doc.sudo().cv_data or {}"/>
                <div class="page" style="font-family: Arial, Helvetica, sans-serif; color:#16202e; font-size:11pt; line-height:1.45;">
                    <div style="border-bottom:3px solid #ffc414; padding-bottom:8px; margin-bottom:14px;">
                        <div style="font-size:24pt; font-weight:bold;" t-out="d.get('full_name') or doc.name"/>
                        <div style="color:#586273;">
                            <t t-out="doc._c2w_display_phone()"/>
                            <t t-if="d.get('email')"> · <t t-out="d['email']"/></t>
                            <t t-if="d.get('town')"> · <t t-out="d['town']"/></t>
                        </div>
                    </div>
                    <t t-if="d.get('summary')">
                        <h3 style="font-size:12pt; text-transform:uppercase; letter-spacing:1px; color:#1b2a41; margin:14px 0 4px;">Profile</h3>
                        <p style="margin:0" t-out="d['summary']"/>
                    </t>
                    <t t-if="d.get('experience')">
                        <h3 style="font-size:12pt; text-transform:uppercase; letter-spacing:1px; color:#1b2a41; margin:14px 0 4px;">Work experience</h3>
                        <div t-foreach="d['experience']" t-as="job" style="margin-bottom:8px;">
                            <b t-out="job.get('role')"/><t t-if="job.get('employer')">, <t t-out="job['employer']"/></t>
                            <span t-if="job.get('dates')" style="color:#586273;"> · <t t-out="job['dates']"/></span>
                            <div t-if="job.get('duties')" t-out="job['duties']"/>
                        </div>
                    </t>
                    <t t-if="d.get('education')">
                        <h3 style="font-size:12pt; text-transform:uppercase; letter-spacing:1px; color:#1b2a41; margin:14px 0 4px;">Education</h3>
                        <div t-foreach="d['education']" t-as="edu" style="margin-bottom:6px;">
                            <b t-out="edu.get('qualification')"/><t t-if="edu.get('school')">, <t t-out="edu['school']"/></t>
                            <span t-if="edu.get('year')" style="color:#586273;"> · <t t-out="edu['year']"/></span>
                        </div>
                    </t>
                    <t t-if="d.get('skills')">
                        <h3 style="font-size:12pt; text-transform:uppercase; letter-spacing:1px; color:#1b2a41; margin:14px 0 4px;">Skills</h3>
                        <p style="margin:0" t-out="d['skills']"/>
                    </t>
                    <h3 style="font-size:12pt; text-transform:uppercase; letter-spacing:1px; color:#1b2a41; margin:14px 0 4px;">Other</h3>
                    <div t-if="d.get('languages')"><b>Languages:</b> <t t-out="d['languages']"/></div>
                    <div><b>Driver's licence:</b> <t t-out="d.get('licence') or 'None'"/></div>
                    <div><b>References:</b> available on request</div>
                </div>
            </t></t>
        </t>
    </template>
</odoo>
