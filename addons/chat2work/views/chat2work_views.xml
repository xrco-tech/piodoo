<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ── Job ─────────────────────────────────────────────────────────── -->
    <record id="view_chat2work_job_list" model="ir.ui.view">
        <field name="name">chat2work.job.list</field>
        <field name="model">chat2work.job</field>
        <field name="arch" type="xml">
            <list string="Jobs">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="location"/>
                <field name="salary_text"/>
                <field name="available_slot_count" string="Slots"/>
            </list>
        </field>
    </record>
    <record id="view_chat2work_job_form" model="ir.ui.view">
        <field name="name">chat2work.job.form</field>
        <field name="model">chat2work.job</field>
        <field name="arch" type="xml">
            <form string="Job">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Call Centre Agent"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="location"/>
                            <field name="salary_text"/>
                            <field name="requirements"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="available_slot_count"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Job description…"/>
                    <notebook>
                        <page string="Interview Slots" name="slots">
                            <field name="slot_ids">
                                <list editable="bottom">
                                    <field name="start_datetime"/>
                                    <field name="capacity"/>
                                    <field name="booked_count"/>
                                    <field name="is_available"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_chat2work_job" model="ir.actions.act_window">
        <field name="name">Jobs</field>
        <field name="res_model">chat2work.job</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ── Interview Slot ──────────────────────────────────────────────── -->
    <record id="view_chat2work_slot_list" model="ir.ui.view">
        <field name="name">chat2work.interview.slot.list</field>
        <field name="model">chat2work.interview.slot</field>
        <field name="arch" type="xml">
            <list string="Interview Slots" decoration-muted="not is_available">
                <field name="job_id"/>
                <field name="start_datetime"/>
                <field name="capacity"/>
                <field name="booked_count"/>
                <field name="is_available"/>
            </list>
        </field>
    </record>
    <record id="action_chat2work_slot" model="ir.actions.act_window">
        <field name="name">Interview Slots</field>
        <field name="res_model">chat2work.interview.slot</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ── Booking ─────────────────────────────────────────────────────── -->
    <record id="view_chat2work_booking_list" model="ir.ui.view">
        <field name="name">chat2work.interview.booking.list</field>
        <field name="model">chat2work.interview.booking</field>
        <field name="arch" type="xml">
            <list string="Bookings" decoration-success="state == 'booked'" decoration-muted="state == 'cancelled'">
                <field name="reference"/>
                <field name="partner_id"/>
                <field name="phone"/>
                <field name="job_id"/>
                <field name="slot_id"/>
                <field name="state" widget="badge"/>
                <field name="channel"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>
    <record id="action_chat2work_booking" model="ir.actions.act_window">
        <field name="name">Bookings</field>
        <field name="res_model">chat2work.interview.booking</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ── Candidate ───────────────────────────────────────────────────── -->
    <record id="view_chat2work_candidate_list" model="ir.ui.view">
        <field name="name">chat2work.candidate.list</field>
        <field name="model">chat2work.candidate</field>
        <field name="arch" type="xml">
            <list string="Candidates">
                <field name="name"/>
                <field name="phone"/>
                <field name="stage" widget="badge"/>
                <field name="employment_status"/>
                <field name="job_seeking"/>
                <field name="whatsapp_opt_in"/>
                <field name="province" optional="show"/>
                <field name="location" optional="hide"/>
                <field name="field" optional="hide"/>
                <field name="registered_via"/>
                <field name="cv_state" optional="show"/>
                <field name="cv_link_state" optional="show"/>
                <field name="source_tag" optional="hide"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>
    <record id="view_chat2work_candidate_form" model="ir.ui.view">
        <field name="name">chat2work.candidate.form</field>
        <field name="model">chat2work.candidate</field>
        <field name="arch" type="xml">
            <form string="Candidate">
                <header>
                    <button name="action_c2w_erase" type="object" string="Delete candidate data"
                            groups="base.group_system" class="btn-danger"
                            confirm="This permanently deletes this candidate's profile, CV, callback requests and Chat2Work conversation history (POPIA deletion request). It can't be undone. Continue?"/>
                    <field name="stage" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_callbacks" type="object" class="oe_stat_button" icon="fa-phone">
                            <field name="open_callback_count" widget="statinfo" string="Open callbacks"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="phone"/>
                            <field name="province"/>
                            <field name="location"/>
                            <field name="field"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="registered_via"/>
                            <field name="active"/>
                        </group>
                        <group string="Status">
                            <field name="employment_status"/>
                            <field name="job_seeking"/>
                            <field name="status_updated_at"/>
                        </group>
                        <group string="Contact &amp; Consent">
                            <field name="whatsapp_opt_in"/>
                            <field name="consent_at"/>
                            <field name="last_active_at"/>
                            <field name="has_id_number"/>
                            <field name="source_tag"/>
                        </group>
                        <group string="CV">
                            <field name="cv_state"/>
                            <field name="cv_text_state" invisible="cv_text_state == 'none'"/>
                            <field name="cv_build_step" invisible="cv_state != 'started'"/>
                            <field name="cv_attachment_id" invisible="not cv_attachment_id"/>
                            <field name="cv_submitted_at" invisible="not cv_submitted_at"/>
                        </group>
                        <group string="CV Link">
                            <field name="cv_link_state"/>
                            <field name="cv_url" widget="url" invisible="not cv_url"/>
                            <field name="cv_link_sent_at" invisible="not cv_link_sent_at"/>
                            <field name="cv_token_expires" invisible="not cv_token_expires"/>
                            <field name="cv_link_error" invisible="not cv_link_error"/>
                            <button name="action_resend_cv_link" type="object" string="Send CV link again"
                                    class="btn-secondary" colspan="2"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_chat2work_candidate_kanban" model="ir.ui.view">
        <field name="name">chat2work.candidate.kanban</field>
        <field name="model">chat2work.candidate</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage" group_create="false" group_delete="false" group_edit="false"
                    quick_create="false" sample="1">
                <field name="whatsapp_opt_in"/>
                <field name="open_callback_count"/>
                <field name="cv_link_state"/>
                <progressbar field="activity_state"
                             colors='{"planned": "success", "today": "warning", "overdue": "danger"}'/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-start">
                            <field name="name" class="fw-bold fs-5 flex-grow-1"/>
                            <span t-if="record.whatsapp_opt_in.raw_value" class="fa fa-whatsapp text-success fs-5" title="Uses WhatsApp"/>
                        </div>
                        <field name="phone" widget="phone"/>
                        <div class="text-muted">
                            <field name="province"/>
                            <span t-if="record.province.raw_value and record.employment_status.raw_value"> · </span>
                            <field name="employment_status"/>
                        </div>
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            <span t-if="record.open_callback_count.raw_value" class="badge text-bg-danger">
                                <i class="fa fa-phone"/> Callback requested
                            </span>
                            <field name="cv_state" widget="badge"
                                   decoration-success="cv_state in ('uploaded', 'built')"
                                   decoration-warning="cv_state == 'help_requested'"
                                   decoration-info="cv_state == 'started'"
                                   decoration-muted="cv_state == 'none'"/>
                            <span t-if="record.cv_link_state.raw_value == 'failed'" class="badge text-bg-danger">CV link failed</span>
                            <field name="source_tag" widget="badge" invisible="not source_tag"/>
                        </div>
                        <footer class="pt-1">
                            <field name="activity_ids" widget="kanban_activity"/>
                            <span class="ms-auto text-muted small" title="Last active">
                                <i class="fa fa-clock-o"/> <field name="last_active_at" options="{'show_time': false}"/>
                            </span>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_chat2work_candidate_search" model="ir.ui.view">
        <field name="name">chat2work.candidate.search</field>
        <field name="model">chat2work.candidate</field>
        <field name="arch" type="xml">
            <search string="Candidates">
                <field name="name"/>
                <field name="phone"/>
                <field name="location"/>
                <field name="source_tag"/>
                <filter name="my_activities" string="My follow-ups" domain="[('activity_user_id', '=', uid)]"/>
                <filter name="late_activities" string="Overdue follow-ups"
                        domain="[('activity_date_deadline', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="no_activity" string="No follow-up planned" domain="[('activity_ids', '=', False)]"/>
                <separator/>
                <filter name="open_callbacks" string="Callback requested"
                        domain="[('callback_ids.state', 'in', ('new', 'in_progress'))]"/>
                <filter name="no_cv" string="No CV yet" domain="[('cv_state', '=', 'none')]"/>
                <filter name="cv_started" string="CV started, not finished" domain="[('cv_state', '=', 'started')]"/>
                <filter name="whatsapp" string="Uses WhatsApp" domain="[('whatsapp_opt_in', '=', True)]"/>
                <filter name="job_seeking" string="Looking for work" domain="[('job_seeking', '=', True)]"/>
                <filter name="cv_unreadable" string="CV not readable" domain="[('cv_text_state', '=', 'unreadable')]"/>
                <separator/>
                <filter name="group_stage" string="Stage" context="{'group_by': 'stage'}"/>
                <filter name="group_province" string="Province" context="{'group_by': 'province'}"/>
                <filter name="group_field" string="Type of work" context="{'group_by': 'field'}"/>
                <filter name="group_source" string="Campaign source" context="{'group_by': 'source_tag'}"/>
                <filter name="group_via" string="Registered via" context="{'group_by': 'registered_via'}"/>
                <filter name="group_employment" string="Employment status" context="{'group_by': 'employment_status'}"/>
            </search>
        </field>
    </record>
    <record id="action_chat2work_candidate" model="ir.actions.act_window">
        <field name="name">Candidates</field>
        <field name="res_model">chat2work.candidate</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_chat2work_candidate_search"/>
    </record>

    <!-- ── Callback request ────────────────────────────────────────────── -->
    <record id="view_chat2work_callback_list" model="ir.ui.view">
        <field name="name">chat2work.callback.request.list</field>
        <field name="model">chat2work.callback.request</field>
        <field name="arch" type="xml">
            <list string="Callback Requests" decoration-warning="state == 'new'" decoration-muted="state in ('done','cancelled')">
                <field name="create_date" string="Requested"/>
                <field name="partner_id"/>
                <field name="phone"/>
                <field name="candidate_id"/>
                <field name="channel"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_chat2work_callback_form" model="ir.ui.view">
        <field name="name">chat2work.callback.request.form</field>
        <field name="model">chat2work.callback.request</field>
        <field name="arch" type="xml">
            <form string="Callback Request">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="phone"/>
                            <field name="candidate_id"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="channel"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Consultant notes…"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_chat2work_callback" model="ir.actions.act_window">
        <field name="name">Callback Requests</field>
        <field name="res_model">chat2work.callback.request</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- ── Menus ───────────────────────────────────────────────────────── -->
    <menuitem id="menu_chat2work_root" name="Chat2Work" sequence="45"/>
    <menuitem id="menu_chat2work_candidates" name="Candidates" parent="menu_chat2work_root" action="action_chat2work_candidate" sequence="5"/>
    <menuitem id="menu_chat2work_jobs" name="Jobs" parent="menu_chat2work_root" action="action_chat2work_job" sequence="10"/>
    <menuitem id="menu_chat2work_slots" name="Interview Slots" parent="menu_chat2work_root" action="action_chat2work_slot" sequence="20"/>
    <menuitem id="menu_chat2work_bookings" name="Bookings" parent="menu_chat2work_root" action="action_chat2work_booking" sequence="30"/>
    <menuitem id="menu_chat2work_callbacks" name="Callback Requests" parent="menu_chat2work_root" action="action_chat2work_callback" sequence="40"/>
</odoo>
