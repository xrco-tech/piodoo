<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reference: the Library's verified findings on the topics marked as shown in
         the Contact Centre. Read-only; leads never show. -->
    <record id="sediba_space_contact_centre" model="sediba.space">
        <field name="name">Contact Centre</field>
        <field name="code">contact_centre</field>
    </record>

    <record id="contact_centre.group_contact_centre_agent" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('sediba.group_reader'))]"/>
    </record>

    <record id="action_contact_centre_reference" model="ir.actions.client">
        <field name="name">Reference</field>
        <field name="tag">sediba_workspace</field>
        <field name="params" eval="{'space': 'contact_centre'}"/>
    </record>
    <menuitem id="menu_contact_centre_reference" name="Reference" parent="contact_centre.menu_contact_centre_main"
              action="action_contact_centre_reference" sequence="13"
              groups="contact_centre.group_contact_centre_agent"/>
</odoo>
