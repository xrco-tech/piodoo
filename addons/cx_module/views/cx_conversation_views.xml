<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Phase 1 — Conversations actions.

        Per the settled reuse decision, UCX does NOT re-model conversations:
        these actions target comm_chatbot's comm.conversation directly (its own
        list/form views), and UCX owns only the action + menu surface. Channel
        splits are plain domains on primary_channel_id.code.
    -->

    <!-- Inbox (All Channels) is the OWL client action in cx_inbox_views.xml.
         The per-channel items below stay as plain filtered list views. -->

    <!-- Workspace > Live Queue: open/waiting conversations across all channels. -->
    <record id="action_cx_live_queue" model="ir.actions.act_window">
        <field name="name">Live Queue</field>
        <field name="res_model">comm.conversation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('lifecycle_state', 'in', ['open', 'waiting'])]</field>
    </record>

    <!-- Live Chat: web-widget conversations only. -->
    <record id="action_cx_livechat" model="ir.actions.act_window">
        <field name="name">Live Chat</field>
        <field name="res_model">comm.conversation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('primary_channel_id.code', '=', 'web')]</field>
    </record>

    <!-- Email: email-channel conversations only. -->
    <record id="action_cx_email" model="ir.actions.act_window">
        <field name="name">Email</field>
        <field name="res_model">comm.conversation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('primary_channel_id.code', '=', 'email')]</field>
    </record>

    <!-- WhatsApp &amp; SMS: the two messaging channels together. -->
    <record id="action_cx_wa_sms" model="ir.actions.act_window">
        <field name="name">WhatsApp &amp; SMS</field>
        <field name="res_model">comm.conversation</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('primary_channel_id.code', 'in', ['whatsapp', 'sms'])]</field>
    </record>

    <!-- Customers &gt; Companies: res.partner filtered to companies. -->
    <record id="action_cx_companies" model="ir.actions.act_window">
        <field name="name">Companies</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('is_company', '=', True)]</field>
        <field name="context">{'default_is_company': True}</field>
    </record>

    <!-- ── Disposition on the conversation (shared taxonomy) ─────────── -->
    <record id="view_comm_conversation_form_cx_disposition" model="ir.ui.view">
        <field name="name">comm.conversation.form.cx.disposition</field>
        <field name="model">comm.conversation</field>
        <field name="inherit_id" ref="comm_chatbot.view_comm_conversation_form"/>
        <field name="arch" type="xml">
            <sheet position="inside">
                <group string="Disposition" col="2">
                    <field name="disposition_id" options="{'no_quick_create': True}"/>
                    <field name="disposition_note"
                           placeholder="Wrap-up note (reason, follow-up, …)"/>
                </group>
            </sheet>
        </field>
    </record>

    <record id="view_comm_conversation_list_cx_disposition" model="ir.ui.view">
        <field name="name">comm.conversation.list.cx.disposition</field>
        <field name="model">comm.conversation</field>
        <field name="inherit_id" ref="comm_chatbot.view_comm_conversation_list"/>
        <field name="arch" type="xml">
            <list position="inside">
                <field name="disposition_id" string="Disposition"
                       optional="show" options="{'no_create_edit': True}"/>
            </list>
        </field>
    </record>

    <record id="view_comm_conversation_search_cx_disposition" model="ir.ui.view">
        <field name="name">comm.conversation.search.cx.disposition</field>
        <field name="model">comm.conversation</field>
        <field name="inherit_id" ref="comm_chatbot.view_comm_conversation_search"/>
        <field name="arch" type="xml">
            <search position="inside">
                <field name="disposition_id"/>
                <filter string="Not dispositioned" name="cx_no_disposition"
                        domain="[('disposition_id', '=', False)]"/>
                <filter string="Disposition" name="cx_group_disposition"
                        context="{'group_by': 'disposition_id'}"/>
            </search>
        </field>
    </record>

</odoo>
