<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Workspace > Queues. A kanban board over comm.conversation (reused, not
        re-modelled) showing the live backlog grouped by lifecycle state, plus
        My / Team / All scoped actions. Agents get "My Queues"; Team/All are
        manager-gated in the menu.
    -->

    <record id="view_cx_queue_kanban" model="ir.ui.view">
        <field name="name">cx.queue.kanban</field>
        <field name="model">comm.conversation</field>
        <field name="priority">32</field>
        <field name="arch" type="xml">
            <kanban default_group_by="lifecycle_state" class="o_kanban_small_column" sample="1">
                <field name="partner_id"/>
                <field name="primary_channel_id"/>
                <field name="assigned_agent_id"/>
                <field name="lifecycle_state"/>
                <field name="opened_at"/>
                <field name="interaction_count"/>
                <field name="ai_sentiment"/>
                <field name="campaign_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong class="o_kanban_record_title"><field name="partner_id"/></strong>
                            </div>
                            <div class="o_kanban_record_body">
                                <span class="badge text-bg-secondary"><field name="primary_channel_id"/></span>
                                <span t-if="record.interaction_count.raw_value" class="ms-1 text-muted">
                                    <field name="interaction_count"/> msgs
                                </span>
                                <span t-if="record.ai_sentiment.raw_value === 'positive'" class="badge text-bg-success ms-1">positive</span>
                                <span t-if="record.ai_sentiment.raw_value === 'negative'" class="badge text-bg-danger ms-1">negative</span>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left text-muted">
                                    <field name="opened_at"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="assigned_agent_id" widget="many2one_avatar_user"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- My Queues: conversations assigned to the current user, still active. -->
    <record id="action_cx_queue_me" model="ir.actions.act_window">
        <field name="name">My Queues</field>
        <field name="res_model">comm.conversation</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('assigned_agent_id', '=', uid), ('lifecycle_state', 'in', ['open', 'waiting', 'handoff'])]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'sequence': 1, 'view_mode': 'kanban', 'view_id': ref('view_cx_queue_kanban')}),
            (0, 0, {'sequence': 2, 'view_mode': 'list'}),
            (0, 0, {'sequence': 3, 'view_mode': 'form'})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Your queue is clear</p>
            <p>Conversations assigned to you that are still open, waiting or handed off appear here.</p>
        </field>
    </record>

    <!-- Team Queues: active conversations that belong to a team. -->
    <record id="action_cx_queue_team" model="ir.actions.act_window">
        <field name="name">Team Queues</field>
        <field name="res_model">comm.conversation</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('assigned_team_code', '!=', False), ('lifecycle_state', 'in', ['open', 'waiting', 'handoff'])]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'sequence': 1, 'view_mode': 'kanban', 'view_id': ref('view_cx_queue_kanban')}),
            (0, 0, {'sequence': 2, 'view_mode': 'list'}),
            (0, 0, {'sequence': 3, 'view_mode': 'form'})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No team backlog</p>
            <p>Active conversations routed to a team appear here — tip: group by Team to watch each queue.</p>
        </field>
    </record>

    <!-- All Queues: every active conversation across all channels/teams/agents. -->
    <record id="action_cx_queue_all" model="ir.actions.act_window">
        <field name="name">All Queues</field>
        <field name="res_model">comm.conversation</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('lifecycle_state', 'in', ['open', 'waiting', 'handoff'])]</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'sequence': 1, 'view_mode': 'kanban', 'view_id': ref('view_cx_queue_kanban')}),
            (0, 0, {'sequence': 2, 'view_mode': 'list'}),
            (0, 0, {'sequence': 3, 'view_mode': 'form'})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Everything's handled</p>
            <p>The full live backlog across every channel, team and agent.</p>
        </field>
    </record>
</odoo>
