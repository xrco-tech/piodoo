<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        UCX menu skeleton (Phase 0).

        Structure, sequence numbers, and groups= gating follow the
        "Odoo XML Menu Skeleton" and "Access Groups" sections of
        Unified_CX_Menu_Structure.docx exactly.

        Phase 0 is standalone, so only leaves that resolve against base Odoo
        are wired now (Customers > Contacts). Every other tab is created as a
        parent here; its leaves are added by the phase that builds the backing
        action — see the note under each tab. An empty parent menu simply does
        not render until it has a visible child, so shipping the parents early
        is harmless and keeps sequence/gating in one place.
    -->

    <!-- ============ Root App ============ -->
    <menuitem id="menu_cx_root"
              name="UCX"
              web_icon="cx_module,static/description/icon.png"
              sequence="10"/>

    <!-- ============ Workspace (Phase 6) ============ -->
    <menuitem id="menu_cx_workspace"
              name="Workspace"
              parent="menu_cx_root"
              sequence="10"/>

    <menuitem id="menu_cx_dashboard"
              name="My Dashboard"
              parent="menu_cx_workspace"
              action="action_cx_dash_me"
              sequence="10"/>

    <menuitem id="menu_cx_dash_team"
              name="Team Dashboard"
              parent="menu_cx_workspace"
              action="action_cx_dash_team"
              groups="cx_module.group_cx_manager"
              sequence="12"/>

    <menuitem id="menu_cx_dash_org"
              name="Manager Dashboard"
              parent="menu_cx_workspace"
              action="action_cx_dash_org"
              groups="cx_module.group_cx_manager"
              sequence="14"/>

    <!-- Queues (kanban backlog over comm.conversation). -->
    <menuitem id="menu_cx_queue_me"
              name="My Queues"
              parent="menu_cx_workspace"
              action="action_cx_queue_me"
              sequence="20"/>

    <menuitem id="menu_cx_queue_team"
              name="Team Queues"
              parent="menu_cx_workspace"
              action="action_cx_queue_team"
              groups="cx_module.group_cx_manager"
              sequence="22"/>

    <menuitem id="menu_cx_queue_all"
              name="All Queues"
              parent="menu_cx_workspace"
              action="action_cx_queue_all"
              groups="cx_module.group_cx_manager"
              sequence="24"/>

    <!-- ============ Conversations (Phase 1) ============ -->
    <menuitem id="menu_cx_conversations"
              name="Conversations"
              parent="menu_cx_root"
              sequence="20"/>

    <menuitem id="menu_cx_inbox"
              name="Inbox (All Channels)"
              parent="menu_cx_conversations"
              action="action_cx_inbox_screen"
              sequence="10"/>

    <!-- Second design: CC skin over Gen-2 comm.conversation (UCX-native). -->
    <menuitem id="menu_cx_inbox_cc"
              name="Inbox (CC design)"
              parent="menu_cx_conversations"
              action="action_cx_inbox_cc"
              sequence="12"/>

    <!-- The original Contact Centre inbox (Gen-1 data + voice-script/call-picker)
         used to be surfaced here at sequence 14. It now lives in the optional
         glue module cx_module_contact_centre, so UCX itself carries no
         dependency on contact_centre_inbox. Install that module to get the
         menu item back. -->

    <menuitem id="menu_cx_livechat"
              name="Live Chat"
              parent="menu_cx_conversations"
              action="action_cx_livechat"
              sequence="20"/>

    <menuitem id="menu_cx_email"
              name="Email"
              parent="menu_cx_conversations"
              action="action_cx_email"
              sequence="40"/>

    <menuitem id="menu_cx_wa_sms"
              name="WhatsApp &amp; SMS"
              parent="menu_cx_conversations"
              action="action_cx_wa_sms"
              sequence="50"/>

    <!-- Raw message-level log (comm.interaction), re-surfaced from Comm Bots. -->
    <menuitem id="menu_cx_interactions"
              name="Interactions (message log)"
              parent="menu_cx_conversations"
              action="comm_chatbot.action_comm_interaction"
              sequence="60"/>

    <!-- ============ Messages (per-channel message logs) ============ -->
    <!-- Mirrors the Voice tab: one place for the message logs, split by channel.
         Backed by comm.interaction (one row per message). -->
    <menuitem id="menu_cx_messages_tab"
              name="Messages"
              parent="menu_cx_root"
              sequence="23"/>

    <menuitem id="menu_cx_msg_whatsapp"
              name="WhatsApp"
              parent="menu_cx_messages_tab"
              action="action_cx_msg_whatsapp"
              sequence="10"/>

    <menuitem id="menu_cx_msg_sms"
              name="SMS"
              parent="menu_cx_messages_tab"
              action="action_cx_msg_sms"
              sequence="20"/>

    <menuitem id="menu_cx_msg_email"
              name="Email"
              parent="menu_cx_messages_tab"
              action="action_cx_msg_email"
              sequence="30"/>

    <menuitem id="menu_cx_msg_all"
              name="All Messages"
              parent="menu_cx_messages_tab"
              action="comm_chatbot.action_comm_interaction"
              sequence="40"/>

    <!-- ============ Voice (voice operations) ============ -->
    <!-- All voice under one tab: the live call log (agents), the manager
         dashboard, and admin teams/routing. From comm_whatsapp_calling. -->
    <menuitem id="menu_cx_voice_tab"
              name="Voice"
              parent="menu_cx_root"
              sequence="25"/>

    <menuitem id="menu_cx_voice_calls"
              name="Calls"
              parent="menu_cx_voice_tab"
              action="comm_whatsapp_calling.action_whatsapp_call_log"
              sequence="5"/>

    <!-- VoIP call log (SIP / Infobip Voice / Twilio, once wired). -->
    <menuitem id="menu_cx_voice_voip_calls"
              name="VoIP Calls"
              parent="menu_cx_voice_tab"
              action="comm_chatbot_voip.action_comm_voip_call"
              sequence="8"/>

    <!-- Outbound dialer: campaigns (progressive / predictive) + the agent
         console. From comm_dialer. -->
    <menuitem id="menu_cx_voice_dialer"
              name="Dialer Campaigns"
              parent="menu_cx_voice_tab"
              action="comm_dialer.action_comm_dialer_campaign"
              groups="cx_module.group_cx_manager"
              sequence="11"/>

    <menuitem id="menu_cx_voice_dialer_console"
              name="My Dialer Console"
              parent="menu_cx_voice_tab"
              action="comm_dialer.action_comm_dialer_my_console"
              sequence="12"/>

    <!-- Supervisor monitoring: live calls board (Listen/Whisper/Barge) + the
         audit list of monitor sessions. Gated to the Dialer Supervisor group. -->
    <menuitem id="menu_cx_voice_live_monitor"
              name="Live Calls (Monitor)"
              parent="menu_cx_voice_tab"
              action="comm_dialer.action_comm_dialer_live_monitor"
              groups="comm_dialer.group_dialer_supervisor"
              sequence="13"/>

    <menuitem id="menu_cx_voice_monitor_sessions"
              name="Monitor Sessions"
              parent="menu_cx_voice_tab"
              action="comm_dialer.action_comm_dialer_barge"
              groups="comm_dialer.group_dialer_supervisor"
              sequence="14"/>

    <menuitem id="menu_cx_voice_dashboard"
              name="Calls Dashboard"
              parent="menu_cx_voice_tab"
              action="comm_whatsapp_calling.action_whatsapp_call_log_dashboard"
              groups="cx_module.group_cx_manager"
              sequence="10"/>

    <menuitem id="menu_cx_voice_routing"
              name="Call Routing"
              parent="menu_cx_voice_tab"
              action="comm_whatsapp_calling.action_whatsapp_call_routing_rule"
              groups="cx_module.group_cx_admin"
              sequence="30"/>

    <!-- Disposition taxonomy management (outcome codes for calls, and later
         conversations). Managed by admins / Call Managers. -->
    <menuitem id="menu_cx_voice_dispositions"
              name="Dispositions"
              parent="menu_cx_voice_tab"
              action="comm_whatsapp_calling.action_comm_disposition"
              groups="cx_module.group_cx_admin"
              sequence="40"/>

    <!-- ============ Tickets ============ -->
    <!-- Phase 5: All / My / Escalated / SLA (helpdesk) + Knowledge Base. -->
    <menuitem id="menu_cx_tickets"
              name="Tickets"
              parent="menu_cx_root"
              sequence="30"/>

    <!-- ============ Sales ============ -->
    <!-- Leads / Opportunities (crm), Quotations / Orders (sale) — pending the
         crm/sale dependency decision (see Open Questions). -->
    <menuitem id="menu_cx_sales"
              name="Sales"
              parent="menu_cx_root"
              sequence="40"/>

    <!-- ============ Bots & Automation ============ -->
    <!-- The Gen-2 flow builder (bots + steps/triggers/tools + web sessions)
         and WhatsApp channel content, re-surfaced from Comm Bots / WhatsApp
         Light into one tab. -->
    <menuitem id="menu_cx_bots"
              name="Bots &amp; Automation"
              parent="menu_cx_root"
              sequence="45"
              groups="cx_module.group_cx_admin"/>

    <!-- Bots &amp; Flows: comm.bot list; each bot's form has the Flow Canvas button. -->
    <menuitem id="menu_cx_bots_builder"
              name="Bots &amp; Flows"
              parent="menu_cx_bots"
              action="comm_chatbot.action_comm_bot"
              sequence="5"/>

    <!-- WhatsApp / USSD chatbots are the separate Gen-1 whatsapp.chatbot model
         (e.g. the USSD menu flows) — surfaced here alongside the Gen-2 bots. -->
    <menuitem id="menu_cx_bots_wa_chatbots"
              name="WhatsApp / USSD Chatbots"
              parent="menu_cx_bots"
              action="comm_whatsapp_chatbot.action_whatsapp_chatbot"
              sequence="7"/>

    <menuitem id="menu_cx_bots_steps"
              name="Flow Steps"
              parent="menu_cx_bots"
              action="comm_chatbot.action_comm_bot_step"
              sequence="10"/>

    <menuitem id="menu_cx_bots_triggers"
              name="Triggers"
              parent="menu_cx_bots"
              action="comm_chatbot.action_comm_bot_trigger"
              sequence="20"/>

    <menuitem id="menu_cx_bots_llm"
              name="LLM Tools"
              parent="menu_cx_bots"
              action="comm_chatbot.action_comm_bot_llm_tool"
              sequence="30"/>

    <menuitem id="menu_cx_bots_web"
              name="Web Sessions"
              parent="menu_cx_bots"
              action="comm_chatbot_web.action_comm_bot_web_session"
              sequence="40"/>

    <menuitem id="menu_cx_bots_wa_templates"
              name="WhatsApp Templates"
              parent="menu_cx_bots"
              action="comm_whatsapp.action_whatsapp_template"
              sequence="50"/>

    <menuitem id="menu_cx_bots_wa_flows"
              name="WhatsApp Flows"
              parent="menu_cx_bots"
              action="comm_whatsapp.action_whatsapp_flow"
              sequence="60"/>

    <!-- ============ Marketing (Phase 4) ============ -->
    <!-- Reuses comm_campaign. Journeys/Templates map to Enterprise
         marketing_automation models not installed here — left as placeholders. -->
    <menuitem id="menu_cx_marketing"
              name="Marketing"
              parent="menu_cx_root"
              sequence="50"/>

    <menuitem id="menu_cx_campaigns"
              name="Campaigns"
              parent="menu_cx_marketing"
              action="comm_campaign.action_comm_campaign"
              sequence="10"/>

    <!-- Per-recipient send/delivery log, re-surfaced from Comm Campaign. -->
    <menuitem id="menu_cx_campaign_sends"
              name="Sends (delivery log)"
              parent="menu_cx_marketing"
              action="comm_campaign.action_comm_campaign_send"
              groups="cx_module.group_cx_manager"
              sequence="15"/>

    <menuitem id="menu_cx_segments"
              name="Audiences / Segments"
              parent="menu_cx_marketing"
              action="action_cx_audience"
              sequence="20"/>

    <menuitem id="menu_cx_comm_prefs"
              name="Communication Preferences"
              parent="menu_cx_marketing"
              action="comm_campaign.action_comm_partner_pref"
              sequence="25"/>

    <!-- Journeys (Manager+) and Templates: no comm_* reuse target yet
         (marketing.journey / marketing.segment / mail.template are Enterprise
         or out of the reuse trunk). Wired in a later pass. -->


    <!-- ============ Customers ============ -->
    <menuitem id="menu_cx_customers"
              name="Customers"
              parent="menu_cx_root"
              sequence="60"/>

    <!-- Wired now: standalone against the contacts app. -->
    <menuitem id="menu_cx_contacts"
              name="Contacts"
              parent="menu_cx_customers"
              action="contacts.action_contacts"
              sequence="10"/>

    <!-- Companies: res.partner filtered to is_company. -->
    <menuitem id="menu_cx_companies"
              name="Companies"
              parent="menu_cx_customers"
              action="action_cx_companies"
              sequence="20"/>
    <!-- Phase 6 remaining: Interaction Timeline (cx.timeline). -->

    <!-- ============ Reporting (Manager+, Phase 6) ============ -->
    <!-- Agent + Channel performance over cx.report.conversation. SLA / CSAT /
         ROI need helpdesk / survey / sales data not on this instance — later. -->
    <menuitem id="menu_cx_reporting"
              name="Reporting"
              parent="menu_cx_root"
              sequence="70"
              groups="cx_module.group_cx_manager"/>

    <menuitem id="menu_cx_report_dashboard"
              name="Performance Report"
              parent="menu_cx_reporting"
              action="action_cx_report_dashboard"
              sequence="5"/>

    <menuitem id="menu_cx_report_agent"
              name="Agent Performance (pivot)"
              parent="menu_cx_reporting"
              action="action_cx_report_agent"
              sequence="10"/>

    <menuitem id="menu_cx_report_channel"
              name="Channel Performance (pivot)"
              parent="menu_cx_reporting"
              action="action_cx_report_channel"
              sequence="20"/>

    <!-- ============ Billing (Phase 3) ============ -->
    <!-- Reuses comm_billing_core's shared ledger + the WhatsApp cost simulator.
         Budgets &amp; Alerts is deferred to Phase 4 (comm_campaign). -->
    <menuitem id="menu_cx_billing"
              name="Billing"
              parent="menu_cx_root"
              sequence="75"/>

    <menuitem id="menu_cx_billing_dashboard"
              name="Spend Dashboard"
              parent="menu_cx_billing"
              action="action_cx_billing_dashboard"
              sequence="10"
              groups="cx_module.group_cx_manager"/>

    <menuitem id="menu_cx_billing_ledger"
              name="Billing Ledger"
              parent="menu_cx_billing"
              action="comm_billing_core.action_comm_billing_dashboard"
              sequence="15"
              groups="cx_module.group_cx_manager"/>

    <menuitem id="menu_cx_billing_channel"
              name="Cost by Channel"
              parent="menu_cx_billing"
              action="comm_billing_core.action_comm_billing_event"
              sequence="20"
              groups="cx_module.group_cx_manager"/>

    <menuitem id="menu_cx_billing_estimate"
              name="Campaign Cost Estimator"
              parent="menu_cx_billing"
              action="comm_whatsapp_billing.action_whatsapp_cost_simulation"
              sequence="30"/>

    <!-- Budgets &amp; Alerts reuses comm_campaign's per-campaign soft/hard budget
         caps + 80%/100% notifications (no new threshold logic added). -->
    <menuitem id="menu_cx_billing_budgets"
              name="Budgets &amp; Alerts"
              parent="menu_cx_billing"
              action="action_cx_budgets"
              sequence="40"
              groups="cx_module.group_cx_manager"/>

    <menuitem id="menu_cx_billing_ratecards"
              name="Rate Cards"
              parent="menu_cx_billing"
              action="comm_billing_core.action_comm_billing_rate_card"
              sequence="60"
              groups="cx_module.group_cx_admin"/>

    <!-- ============ Configuration (Admin only) ============ -->
    <!-- Later phases: Channels &amp; Routing / Teams / SLA Policies / Tags /
         Integrations / General Settings. -->
    <menuitem id="menu_cx_config"
              name="Configuration"
              parent="menu_cx_root"
              sequence="80"
              groups="cx_module.group_cx_admin"/>

    <!-- Channel registry: the comm.channel definitions (WhatsApp/SMS/web/voice/email). -->
    <menuitem id="menu_cx_config_channels"
              name="Channels"
              parent="menu_cx_config"
              action="comm_chatbot.action_comm_channel"
              sequence="10"/>

    <!-- Per-channel account config (provider credentials). -->
    <menuitem id="menu_cx_config_wa_accounts"
              name="WhatsApp Accounts"
              parent="menu_cx_config"
              action="comm_whatsapp.action_comm_whatsapp_account"
              sequence="20"/>

    <menuitem id="menu_cx_config_sms_accounts"
              name="SMS Accounts"
              parent="menu_cx_config"
              action="comm_sms.action_comm_sms_account"
              sequence="30"/>

    <menuitem id="menu_cx_config_voip_accounts"
              name="VoIP Accounts"
              parent="menu_cx_config"
              action="comm_chatbot_voip.action_comm_voip_account"
              sequence="35"/>

    <!-- Do-Not-Call list (POPIA / CPA opt-out) — checked before every dial. -->
    <menuitem id="menu_cx_config_dnc"
              name="Do-Not-Call List"
              parent="menu_cx_config"
              action="comm_dialer.action_comm_dialer_dnc"
              sequence="36"/>

    <!-- Email servers (the Email channel sends via mail.mail / these servers). -->
    <menuitem id="menu_cx_config_mail_out"
              name="Email — Outgoing Servers"
              parent="menu_cx_config"
              action="base.action_ir_mail_server_list"
              sequence="40"/>

    <menuitem id="menu_cx_config_mail_in"
              name="Email — Incoming Servers"
              parent="menu_cx_config"
              action="mail.action_email_server_tree"
              sequence="50"/>

    <!-- Message templates (contact.centre.template, per channel) — the
         templates the inbox "Send Template" picker offers. -->
    <menuitem id="menu_cx_config_templates"
              name="Templates"
              parent="menu_cx_config"
              sequence="55"/>
    <menuitem id="menu_cx_config_tpl_whatsapp"
              name="WhatsApp Templates"
              parent="menu_cx_config_templates"
              action="contact_centre.action_whatsapp_template"
              sequence="10"/>
    <menuitem id="menu_cx_config_tpl_sms"
              name="SMS Templates"
              parent="menu_cx_config_templates"
              action="contact_centre.action_sms_template"
              sequence="20"/>
    <menuitem id="menu_cx_config_tpl_email"
              name="Email Templates"
              parent="menu_cx_config_templates"
              action="contact_centre.action_email_template"
              sequence="30"/>

    <!-- Teams live under Voice (the call-routing team model is the only team
         model in the reused stack). -->
    <menuitem id="menu_cx_config_teams"
              name="Teams"
              parent="menu_cx_voice_tab"
              action="comm_whatsapp_calling.action_whatsapp_call_team"
              groups="cx_module.group_cx_admin"
              sequence="20"/>

    <!-- Tags &amp; Categories: standard contact tags (res.partner.category). -->
    <menuitem id="menu_cx_config_tags"
              name="Tags &amp; Categories"
              parent="menu_cx_config"
              action="base.action_partner_category_form"
              sequence="70"/>

    <!-- General Settings: Odoo's system settings. -->
    <menuitem id="menu_cx_config_settings"
              name="General Settings"
              parent="menu_cx_config"
              action="base_setup.action_general_configuration"
              sequence="90"/>

    <!-- Integrations: MCP connectors + outbound webhooks. -->
    <menuitem id="menu_cx_config_integrations"
              name="Integrations"
              parent="menu_cx_config"
              sequence="80"/>

    <menuitem id="menu_cx_config_integrations_mcp"
              name="MCP Connectors"
              parent="menu_cx_config_integrations"
              action="action_cx_integration_mcp"
              sequence="10"/>

    <menuitem id="menu_cx_config_integrations_webhooks"
              name="Webhooks"
              parent="menu_cx_config_integrations"
              action="action_cx_integration_webhook"
              sequence="20"/>

    <menuitem id="menu_cx_config_integrations_deliveries"
              name="Webhook Deliveries"
              parent="menu_cx_config_integrations"
              action="action_cx_integration_delivery"
              sequence="30"/>


</odoo>
