<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Unified CX menu skeleton (Phase 0).

        Structure, sequence numbers, and groups= gating follow the
        "Odoo XML Menu Skeleton" and "Access Groups" sections of
        Unified_CX_Menu_Structure.docx exactly.

        Phase 0 is standalone, so only leaves that resolve against base Odoo
        are wired now (Customers > Contacts). Every other tab is created as a
        parent here; its leaves are added by the phase that builds the backing
        action — see the note under each tab. An empty parent menu simply does
        not render until it has a visible child, so shipping the parents early
        is harmless and keeps sequence/gating in one place.
    -->

    <!-- ============ Root App ============ -->
    <menuitem id="menu_cx_root"
              name="Unified CX"
              web_icon="cx_module,static/description/icon.png"
              sequence="10"/>

    <!-- ============ Workspace ============ -->
    <!-- Phase 6: My Dashboard (cx.dashboard), Live Queue, Customer 360 Search. -->
    <menuitem id="menu_cx_workspace"
              name="Workspace"
              parent="menu_cx_root"
              sequence="10"/>

    <!-- ============ Conversations (Phase 1) ============ -->
    <menuitem id="menu_cx_conversations"
              name="Conversations"
              parent="menu_cx_root"
              sequence="20"/>

    <menuitem id="menu_cx_inbox"
              name="Inbox (All Channels)"
              parent="menu_cx_conversations"
              action="action_cx_inbox_screen"
              sequence="10"/>

    <menuitem id="menu_cx_livechat"
              name="Live Chat"
              parent="menu_cx_conversations"
              action="action_cx_livechat"
              sequence="20"/>

    <!-- Voice / Calls reuses the comm_whatsapp_calling widget system wholesale. -->
    <menuitem id="menu_cx_voice"
              name="Voice / Calls"
              parent="menu_cx_conversations"
              action="comm_whatsapp_calling.action_whatsapp_call_log"
              sequence="30"/>

    <menuitem id="menu_cx_email"
              name="Email"
              parent="menu_cx_conversations"
              action="action_cx_email"
              sequence="40"/>

    <menuitem id="menu_cx_wa_sms"
              name="WhatsApp &amp; SMS"
              parent="menu_cx_conversations"
              action="action_cx_wa_sms"
              sequence="50"/>

    <!-- ============ Tickets ============ -->
    <!-- Phase 5: All / My / Escalated / SLA (helpdesk) + Knowledge Base. -->
    <menuitem id="menu_cx_tickets"
              name="Tickets"
              parent="menu_cx_root"
              sequence="30"/>

    <!-- ============ Sales ============ -->
    <!-- Leads / Opportunities (crm), Quotations / Orders (sale) — pending the
         crm/sale dependency decision (see Open Questions). -->
    <menuitem id="menu_cx_sales"
              name="Sales"
              parent="menu_cx_root"
              sequence="40"/>

    <!-- ============ Marketing (Phase 4) ============ -->
    <!-- Reuses comm_campaign. Journeys/Templates map to Enterprise
         marketing_automation models not installed here — left as placeholders. -->
    <menuitem id="menu_cx_marketing"
              name="Marketing"
              parent="menu_cx_root"
              sequence="50"/>

    <menuitem id="menu_cx_campaigns"
              name="Campaigns"
              parent="menu_cx_marketing"
              action="comm_campaign.action_comm_campaign"
              sequence="10"/>

    <menuitem id="menu_cx_segments"
              name="Audiences / Segments"
              parent="menu_cx_marketing"
              action="comm_campaign.action_comm_partner_pref"
              sequence="20"/>

    <!-- Journeys (Manager+) and Templates: no comm_* reuse target yet
         (marketing.journey / marketing.segment / mail.template are Enterprise
         or out of the reuse trunk). Wired in a later pass. -->


    <!-- ============ Customers ============ -->
    <menuitem id="menu_cx_customers"
              name="Customers"
              parent="menu_cx_root"
              sequence="60"/>

    <!-- Wired now: standalone against the contacts app. -->
    <menuitem id="menu_cx_contacts"
              name="Contacts"
              parent="menu_cx_customers"
              action="contacts.action_contacts"
              sequence="10"/>
    <!-- Phase 6: Companies (res.partner is_company filter),
         Interaction Timeline (cx.timeline). -->

    <!-- ============ Reporting (Manager+) ============ -->
    <!-- Phase 6: Agent / Channel / SLA / CSAT / ROI reports. -->
    <menuitem id="menu_cx_reporting"
              name="Reporting"
              parent="menu_cx_root"
              sequence="70"
              groups="cx_module.group_cx_manager"/>

    <!-- ============ Billing (Phase 3) ============ -->
    <!-- Reuses comm_billing_core's shared ledger + the WhatsApp cost simulator.
         Budgets &amp; Alerts is deferred to Phase 4 (comm_campaign). -->
    <menuitem id="menu_cx_billing"
              name="Billing"
              parent="menu_cx_root"
              sequence="75"/>

    <menuitem id="menu_cx_billing_dashboard"
              name="Spend Dashboard"
              parent="menu_cx_billing"
              action="comm_billing_core.action_comm_billing_dashboard"
              sequence="10"
              groups="cx_module.group_cx_manager"/>

    <menuitem id="menu_cx_billing_channel"
              name="Cost by Channel"
              parent="menu_cx_billing"
              action="comm_billing_core.action_comm_billing_event"
              sequence="20"
              groups="cx_module.group_cx_manager"/>

    <menuitem id="menu_cx_billing_estimate"
              name="Campaign Cost Estimator"
              parent="menu_cx_billing"
              action="comm_whatsapp_billing.action_whatsapp_cost_simulation"
              sequence="30"/>

    <!-- Budgets &amp; Alerts reuses comm_campaign's per-campaign soft/hard budget
         caps + 80%/100% notifications (no new threshold logic added). -->
    <menuitem id="menu_cx_billing_budgets"
              name="Budgets &amp; Alerts"
              parent="menu_cx_billing"
              action="comm_campaign.action_comm_campaign"
              sequence="40"
              groups="cx_module.group_cx_manager"/>

    <menuitem id="menu_cx_billing_ratecards"
              name="Rate Cards"
              parent="menu_cx_billing"
              action="comm_billing_core.action_comm_billing_rate_card"
              sequence="60"
              groups="cx_module.group_cx_admin"/>

    <!-- ============ Configuration (Admin only) ============ -->
    <!-- Later phases: Channels &amp; Routing / Teams / SLA Policies / Tags /
         Integrations / General Settings. -->
    <menuitem id="menu_cx_config"
              name="Configuration"
              parent="menu_cx_root"
              sequence="80"
              groups="cx_module.group_cx_admin"/>

</odoo>
