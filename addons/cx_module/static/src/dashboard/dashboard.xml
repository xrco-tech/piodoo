<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="cx_module.Dashboard">
        <div class="o_action o_cx_dash">

          <!-- Fixed top: header + filter bar (does not scroll) -->
          <div class="o_cx_dash_top">
            <div class="o_cx_dash_head d-flex flex-wrap align-items-center gap-2">
                <div class="o_cx_dash_title">
                    <t t-esc="state.data ? state.data.scope_label : ''"/> dashboard
                    <span class="o_cx_dash_sub">measuring efficiency · <t t-esc="state.data ? state.data.window_label : ''"/></span>
                </div>
                <div class="flex-grow-1"/>
                <div class="btn-group btn-group-sm" role="group">
                    <t t-foreach="dayOptions" t-as="d" t-key="d">
                        <button class="btn"
                                t-att-class="state.rangeMode === 'days' and state.days === d ? 'btn-primary' : 'btn-outline-secondary'"
                                t-on-click="() => this.setDays(d)"><t t-esc="d"/>d</button>
                    </t>
                </div>
                <div class="o_cx_daterange">
                    <input type="date" class="form-control form-control-sm" t-att-value="state.dateFrom" t-on-change="onDateFrom"/>
                    <span class="text-muted">→</span>
                    <input type="date" class="form-control form-control-sm" t-att-value="state.dateTo" t-on-change="onDateTo"/>
                    <button class="btn btn-sm btn-outline-primary" t-on-click="applyCustomRange"
                            t-att-disabled="!state.dateFrom or !state.dateTo">Apply</button>
                </div>
            </div>

            <!-- Filter bar -->
            <div t-if="state.data" class="o_cx_filters">
                <t t-foreach="filterDims" t-as="dim" t-key="dim.key">
                    <div class="o_cx_filter">
                        <button class="btn btn-sm"
                                t-att-class="state.filters[dim.key].length ? 'btn-primary' : 'btn-outline-secondary'"
                                t-on-click="() => this.togglePanel(dim.key)">
                            <t t-esc="filterLabel(dim)"/> ▾
                        </button>
                        <div t-if="state.openFilter === dim.key" class="o_cx_filter_panel">
                            <div class="o_cx_filter_actions">
                                <a t-on-click="() => this.clearFilter(dim.key)">Clear</a>
                                <a t-on-click="() => this.togglePanel(dim.key)">Close</a>
                            </div>
                            <t t-if="dim.options.length">
                                <label t-foreach="dim.options" t-as="op" t-key="op.id" class="o_cx_filter_opt">
                                    <input type="checkbox" t-att-checked="isChecked(dim.key, op.id)"
                                           t-on-change="() => this.toggleFilter(dim.key, op.id)"/>
                                    <span t-esc="op.name"/>
                                </label>
                            </t>
                            <div t-else="" class="text-muted small p-1">None in this window</div>
                        </div>
                    </div>
                </t>
                <!-- Direction (inbound/outbound) -->
                <div class="btn-group btn-group-sm" role="group">
                    <button class="btn" t-att-class="!state.filters.direction ? 'btn-secondary' : 'btn-outline-secondary'" t-on-click="() => this.setDirection('')">All</button>
                    <button class="btn" t-att-class="state.filters.direction === 'inbound' ? 'btn-secondary' : 'btn-outline-secondary'" t-on-click="() => this.setDirection('inbound')">Inbound</button>
                    <button class="btn" t-att-class="state.filters.direction === 'outbound' ? 'btn-secondary' : 'btn-outline-secondary'" t-on-click="() => this.setDirection('outbound')">Outbound</button>
                </div>
                <a t-if="hasActiveFilters" class="o_cx_clearall" t-on-click="clearAllFilters">Clear all</a>
            </div>
          </div>

          <!-- Scrollable body -->
          <div class="o_cx_dash_body">
            <div t-if="state.loading" class="o_cx_dash_loading text-muted">Loading metrics…</div>

            <t t-if="!state.loading and state.data">
                <!-- KPI cards -->
                <div class="o_cx_kpis">
                    <div class="o_cx_kpi" t-on-click="openConversations" role="button">
                        <div class="o_cx_kpi_val"><t t-esc="fmtNum(state.data.kpis.conversations)"/></div>
                        <div class="o_cx_kpi_lbl">Conversations</div>
                        <div class="o_cx_kpi_foot">
                            <span class="text-warning"><t t-esc="fmtNum(state.data.kpis.open)"/> open</span> ·
                            <span class="text-success"><t t-esc="fmtNum(state.data.kpis.closed)"/> closed</span>
                        </div>
                    </div>
                    <div class="o_cx_kpi">
                        <div class="o_cx_kpi_val"><t t-esc="fmtDuration(state.data.kpis.avg_first_response_secs)"/></div>
                        <div class="o_cx_kpi_lbl">Avg first response</div>
                        <div class="o_cx_kpi_foot">customer waits before a reply</div>
                    </div>
                    <div class="o_cx_kpi">
                        <div class="o_cx_kpi_val"
                             t-att-class="state.data.kpis.first_response_sla_pct !== null and state.data.kpis.first_response_sla_pct >= 80 ? 'text-success' : (state.data.kpis.first_response_sla_pct !== null and state.data.kpis.first_response_sla_pct &lt; 50 ? 'text-danger' : '')">
                            <t t-esc="fmtPct(state.data.kpis.first_response_sla_pct)"/>
                        </div>
                        <div class="o_cx_kpi_lbl">First-response SLA</div>
                        <div class="o_cx_kpi_foot">target ≤ <t t-esc="fmtDuration(state.data.sla_target_secs)"/></div>
                    </div>
                    <div class="o_cx_kpi">
                        <div class="o_cx_kpi_val"><t t-esc="fmtDuration(state.data.kpis.avg_handle_secs)"/></div>
                        <div class="o_cx_kpi_lbl">Avg handling time</div>
                        <div class="o_cx_kpi_foot">open → closed, closed convos</div>
                    </div>
                    <div class="o_cx_kpi">
                        <div class="o_cx_kpi_val"><t t-esc="fmtNum(state.data.kpis.messages)"/></div>
                        <div class="o_cx_kpi_lbl">Messages handled</div>
                        <div class="o_cx_kpi_foot">inbound + outbound</div>
                    </div>
                    <div class="o_cx_kpi">
                        <div class="o_cx_kpi_val">
                            <t t-esc="fmtNum(state.data.kpis.calls_answered)"/>
                            <span class="o_cx_kpi_val_sub text-danger" t-if="state.data.kpis.calls_missed"> / <t t-esc="fmtNum(state.data.kpis.calls_missed)"/> missed</span>
                        </div>
                        <div class="o_cx_kpi_lbl">Voice calls</div>
                        <div class="o_cx_kpi_foot">avg <t t-esc="fmtDuration(state.data.kpis.avg_call_secs)"/> · team-level</div>
                    </div>
                </div>

                <!-- Charts row -->
                <div class="o_cx_dash_row">
                    <!-- Trend -->
                    <div class="o_cx_card o_cx_grow2">
                        <div class="o_cx_card_h">Conversation volume — opened vs same-day closed</div>
                        <div class="o_cx_legend">
                            <span><i class="o_cx_dot" style="background:#3aa0ff"/> Opened</span>
                            <span><i class="o_cx_dot" style="background:#6c757d"/> Closed</span>
                        </div>
                        <div class="o_cx_trend" t-if="trendBars.bars.length">
                            <t t-foreach="trendBars.bars" t-as="b" t-key="b_index">
                                <div class="o_cx_trend_col" t-att-title="b.label + ': ' + b.opened + ' opened, ' + b.closed + ' closed'">
                                    <div class="o_cx_trend_bars">
                                        <div class="o_cx_trend_bar o_cx_op" t-attf-style="height:{{b.openedH}}%"/>
                                        <div class="o_cx_trend_bar o_cx_cl" t-attf-style="height:{{b.closedH}}%"/>
                                    </div>
                                    <div class="o_cx_trend_x"><t t-esc="b.label"/></div>
                                </div>
                            </t>
                        </div>
                        <div t-else="" class="text-muted p-3">No conversations in this window.</div>
                    </div>

                    <!-- Sentiment donut -->
                    <div class="o_cx_card">
                        <div class="o_cx_card_h">Satisfaction (AI sentiment proxy)</div>
                        <div class="o_cx_donut_wrap">
                            <svg viewBox="0 0 120 120" class="o_cx_donut">
                                <t t-foreach="sentimentDonut.segs" t-as="sg" t-key="sg.key">
                                    <path t-if="sg.path" t-att-d="sg.path" t-att-fill="sg.color"/>
                                </t>
                                <text x="60" y="58" text-anchor="middle" class="o_cx_donut_big"
                                      t-esc="sentimentDonut.posPct === null ? '—' : sentimentDonut.posPct + '%'"/>
                                <text x="60" y="72" text-anchor="middle" class="o_cx_donut_small">positive</text>
                            </svg>
                            <div class="o_cx_donut_leg">
                                <t t-foreach="sentimentDonut.segs" t-as="sg" t-key="sg.key">
                                    <div><i class="o_cx_dot" t-attf-style="background:{{sg.color}}"/>
                                        <t t-esc="sg.label"/> <span class="text-muted"><t t-esc="sg.value"/></span></div>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Distribution + DOW -->
                <div class="o_cx_dash_row">
                    <div class="o_cx_card o_cx_grow2">
                        <div class="o_cx_card_h">First-response time distribution</div>
                        <div class="o_cx_dist">
                            <t t-foreach="distribution" t-as="d" t-key="d.bucket">
                                <div class="o_cx_dist_row">
                                    <div class="o_cx_dist_lbl"><t t-esc="d.bucket"/></div>
                                    <div class="o_cx_dist_track"><div class="o_cx_dist_fill" t-attf-style="width:{{d.w}}%"/></div>
                                    <div class="o_cx_dist_val"><t t-esc="d.count"/> <span class="text-muted">(<t t-esc="d.pct"/>%)</span></div>
                                </div>
                            </t>
                        </div>
                    </div>
                    <div class="o_cx_card">
                        <div class="o_cx_card_h">Busiest day of week</div>
                        <div class="o_cx_dow">
                            <t t-foreach="dowBars" t-as="w" t-key="w.dow">
                                <div class="o_cx_dow_col" t-att-title="w.opened + ' conversations'">
                                    <div class="o_cx_dow_bar" t-attf-style="height:{{w.h}}%"/>
                                    <div class="o_cx_dow_x"><t t-esc="w.label"/></div>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>

                <!-- Agent leaderboard (team/org only) -->
                <div t-if="state.scope !== 'me'" class="o_cx_card">
                    <div class="o_cx_card_h">Agent leaderboard <span class="text-muted">— ranked by conversations handled</span></div>
                    <table class="o_cx_board table table-sm">
                        <thead>
                            <tr>
                                <th>#</th><th>Agent</th><th class="text-end">Convos</th>
                                <th class="text-end">Closed</th><th class="text-end">Avg first resp</th>
                                <th class="text-end">Avg handle</th><th class="text-end">Msgs</th>
                                <th class="text-end">Positive</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="state.data.leaderboard.length">
                                <t t-foreach="state.data.leaderboard" t-as="a" t-key="a.agent_id">
                                    <tr>
                                        <td class="text-muted"><t t-esc="a_index + 1"/></td>
                                        <td><t t-esc="a.agent"/></td>
                                        <td class="text-end"><t t-esc="fmtNum(a.conversations)"/></td>
                                        <td class="text-end"><t t-esc="fmtNum(a.closed)"/></td>
                                        <td class="text-end"><t t-esc="fmtDuration(a.avg_first_response_secs)"/></td>
                                        <td class="text-end"><t t-esc="fmtDuration(a.avg_handle_secs)"/></td>
                                        <td class="text-end"><t t-esc="fmtNum(a.messages)"/></td>
                                        <td class="text-end"><t t-esc="a.sentiment_score === null ? '—' : a.sentiment_score + '%'"/></td>
                                    </tr>
                                </t>
                            </t>
                            <tr t-else=""><td colspan="8" class="text-muted text-center p-3">No assigned conversations in this window.</td></tr>
                        </tbody>
                    </table>
                </div>

                <!-- ===== Omni-channel deep-dive (Manager dashboard only) ===== -->
                <t t-if="state.scope === 'org' and omni">
                    <div class="o_cx_omni_head">Omni-channel overview <span class="text-muted">— one module, every channel</span></div>

                    <div class="o_cx_dash_row">
                        <!-- Channel mix -->
                        <div class="o_cx_card o_cx_grow2">
                            <div class="o_cx_card_h">Channel mix — conversations, messages &amp; cost</div>
                            <table class="o_cx_chan table table-sm" t-if="channelBars.length">
                                <thead>
                                    <tr><th>Channel</th><th class="o_cx_chan_barcol">Share of conversations</th>
                                        <th class="text-end">Convos</th><th class="text-end">Msgs</th><th class="text-end">Cost</th></tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="channelBars" t-as="c" t-key="c.channel_id">
                                        <tr>
                                            <td><span class="o_cx_chan_name"><t t-esc="c.name"/></span></td>
                                            <td class="o_cx_chan_barcol">
                                                <div class="o_cx_dist_track"><div class="o_cx_dist_fill" t-attf-style="width:{{c.w}}%"/></div>
                                            </td>
                                            <td class="text-end"><t t-esc="fmtNum(c.conversations)"/></td>
                                            <td class="text-end"><t t-esc="fmtNum(c.messages)"/></td>
                                            <td class="text-end"><t t-esc="fmtMoney(c.cost)"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <div t-else="" class="text-muted p-3">No channel activity in this window.</div>
                        </div>

                        <!-- Live queue by channel -->
                        <div class="o_cx_card">
                            <div class="o_cx_card_h">Live queue <span class="text-muted">— open right now</span></div>
                            <div class="o_cx_queue_hero">
                                <div>
                                    <div class="o_cx_queue_big" t-att-class="omni.queue.total_waiting ? 'text-warning' : 'text-success'"><t t-esc="fmtNum(omni.queue.total_waiting)"/></div>
                                    <div class="o_cx_queue_lbl">waiting</div>
                                </div>
                                <div>
                                    <div class="o_cx_queue_big"><t t-esc="fmtDuration(omni.queue.oldest_secs)"/></div>
                                    <div class="o_cx_queue_lbl">longest wait</div>
                                </div>
                            </div>
                            <table class="table table-sm o_cx_queue_tbl" t-if="omni.queue.rows.length">
                                <tbody>
                                    <t t-foreach="omni.queue.rows" t-as="q" t-key="q_index">
                                        <tr>
                                            <td><t t-esc="q.channel"/></td>
                                            <td class="text-end"><t t-esc="fmtNum(q.waiting)"/></td>
                                            <td class="text-end text-muted"><t t-esc="fmtDuration(q.oldest_secs)"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <div t-else="" class="text-muted p-2">Queue is clear 🎉</div>
                        </div>
                    </div>

                    <div class="o_cx_dash_row">
                        <!-- Campaigns -->
                        <div class="o_cx_card o_cx_grow2">
                            <div class="o_cx_card_h">Campaigns <span class="text-muted">— reach, delivery &amp; conversions</span></div>
                            <table class="o_cx_board table table-sm" t-if="omni.campaigns.list.length">
                                <thead>
                                    <tr><th>Campaign</th><th>State</th><th class="text-end">Sends</th>
                                        <th class="text-end">Delivered</th><th class="text-end">Conversions</th><th class="text-end">Cost</th></tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="omni.campaigns.list" t-as="cp" t-key="cp.id">
                                        <tr>
                                            <td><t t-esc="cp.name"/></td>
                                            <td><span class="o_cx_badge" t-att-data-state="cp.state"><t t-esc="titleCase(cp.state)"/></span></td>
                                            <td class="text-end"><t t-esc="fmtNum(cp.sends)"/></td>
                                            <td class="text-end"><t t-esc="fmtNum(cp.delivered)"/></td>
                                            <td class="text-end"><t t-esc="fmtNum(cp.conversions)"/></td>
                                            <td class="text-end"><t t-esc="fmtMoney(cp.cost)"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <div t-else="" class="text-muted p-3">No campaigns yet.</div>
                            <div t-if="campaignChannelBars.length" class="o_cx_camp_reach">
                                <div class="o_cx_camp_reach_h">Outbound reach by channel</div>
                                <t t-foreach="campaignChannelBars" t-as="b" t-key="b_index">
                                    <div class="o_cx_dist_row">
                                        <div class="o_cx_dist_lbl"><t t-esc="b.channel"/></div>
                                        <div class="o_cx_dist_track"><div class="o_cx_dist_fill o_cx_fill_alt" t-attf-style="width:{{b.w}}%"/></div>
                                        <div class="o_cx_dist_val"><t t-esc="fmtNum(b.sends)"/></div>
                                    </div>
                                </t>
                            </div>
                        </div>

                        <!-- Customers -->
                        <div class="o_cx_card">
                            <div class="o_cx_card_h">Customers reached</div>
                            <div class="o_cx_cust_kpis">
                                <div><div class="o_cx_cust_v"><t t-esc="fmtNum(omni.customers.total)"/></div><div class="o_cx_cust_l">customers</div></div>
                                <div><div class="o_cx_cust_v text-primary"><t t-esc="fmtNum(omni.customers.multi_channel)"/></div><div class="o_cx_cust_l">multi-channel</div></div>
                                <div><div class="o_cx_cust_v"><t t-esc="fmtNum(omni.customers.new)"/> / <t t-esc="fmtNum(omni.customers.returning)"/></div><div class="o_cx_cust_l">new / returning</div></div>
                            </div>
                            <table class="table table-sm o_cx_cust_tbl" t-if="omni.customers.top.length">
                                <tbody>
                                    <t t-foreach="omni.customers.top" t-as="cu" t-key="cu.partner_id">
                                        <tr>
                                            <td><t t-esc="cu.name"/></td>
                                            <td class="text-end"><t t-esc="fmtNum(cu.conversations)"/> convos</td>
                                            <td class="text-end">
                                                <span class="o_cx_chan_badge" t-att-class="cu.channels > 1 ? 'o_cx_multi' : ''"><t t-esc="cu.channels"/> ch</span>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                            <div t-else="" class="text-muted p-2">No customers in this window.</div>
                        </div>
                    </div>
                </t>
            </t>
          </div>
        </div>
    </t>

</templates>
