<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <t t-name="cx_module.Inbox">
        <div class="o_action o_cx_inbox d-flex flex-row" style="height: 100%;">

            <!-- ── Left: conversation list ──────────────────────────── -->
            <div class="o_cx_inbox_list d-flex flex-column" t-if="state.showLeftPane">
                <div class="o_cx_inbox_pane_header">Conversations</div>
                <div class="p-2 border-bottom">
                    <input type="text" class="form-control form-control-sm" placeholder="Search customer..."
                           t-att-value="state.searchQuery" t-on-input="onSearchInput"/>
                </div>
                <div class="p-2 border-bottom d-flex gap-1 flex-wrap">
                    <button class="btn btn-sm" t-att-class="!state.stateFilter ? 'btn-primary' : 'btn-outline-secondary'"
                            t-on-click="() => this.filterByState(false)">All</button>
                    <button class="btn btn-sm" t-att-class="state.stateFilter === 'open' ? 'btn-primary' : 'btn-outline-secondary'"
                            t-on-click="() => this.filterByState('open')">Open</button>
                    <button class="btn btn-sm" t-att-class="state.stateFilter === 'waiting' ? 'btn-primary' : 'btn-outline-secondary'"
                            t-on-click="() => this.filterByState('waiting')">Waiting</button>
                    <button class="btn btn-sm" t-att-class="state.stateFilter === 'handoff' ? 'btn-primary' : 'btn-outline-secondary'"
                            t-on-click="() => this.filterByState('handoff')">Handoff</button>
                    <button class="btn btn-sm" t-att-class="state.stateFilter === 'closed' ? 'btn-primary' : 'btn-outline-secondary'"
                            t-on-click="() => this.filterByState('closed')">Closed</button>
                </div>
                <div class="flex-grow-1 overflow-auto">
                    <div t-if="state.loadingList" class="p-3 text-muted">Loading…</div>
                    <t t-foreach="state.conversations" t-as="conv" t-key="conv.id">
                        <div class="p-2 border-bottom o_cx_inbox_row"
                             t-att-class="{'o_cx_inbox_row_selected': conv.id === state.selectedId}"
                             t-on-click="() => this.selectConversation(conv.id)"
                             style="cursor:pointer;">
                            <div class="d-flex justify-content-between align-items-start">
                                <strong><t t-esc="conv.partner_id ? conv.partner_id[1] : conv.name"/></strong>
                                <span class="badge text-bg-secondary text-uppercase" t-if="conv.primary_channel_code">
                                    <t t-esc="conv.primary_channel_code"/>
                                </span>
                            </div>
                            <div class="d-flex justify-content-between text-muted small">
                                <span><t t-esc="conv.lifecycle_state"/></span>
                                <span t-esc="conv.last_activity_at"/>
                            </div>
                        </div>
                    </t>
                    <div t-if="!state.loadingList and !state.conversations.length" class="p-3 text-muted">
                        No conversations
                    </div>
                </div>
            </div>

            <!-- ── Center: thread + composer ────────────────────────── -->
            <div class="o_cx_inbox_thread flex-grow-1 d-flex flex-column">
                <div class="o_cx_inbox_pane_header d-flex align-items-center gap-2">
                    <button class="btn btn-sm btn-outline-secondary py-0 px-1" t-on-click="toggleLeftPane"
                            title="Show/hide conversations">
                        <i t-att-class="state.showLeftPane ? 'fa fa-angle-double-left' : 'fa fa-angle-double-right'"/>
                    </button>
                    <span>
                        <t t-if="state.selected"><t t-esc="state.selected.partner_id ? state.selected.partner_id[1] : state.selected.name"/></t>
                        <t t-else="">Thread</t>
                    </span>
                    <div class="ms-auto position-relative d-flex gap-2" t-if="state.selectedId">
                        <button class="btn btn-sm btn-outline-secondary d-md-none" t-on-click="toggleSide"
                                title="Disposition &amp; notes">
                            <i class="fa fa-sliders"/>
                        </button>
                        <button class="btn btn-sm btn-primary" t-on-click="toggleTemplatePicker">
                            <i class="fa fa-paper-plane me-1"/>Send Template
                        </button>
                        <div t-if="state.showTemplatePicker"
                             style="position:absolute;right:0;top:112%;z-index:1050;width:300px;background:#fff;color:#111827;border:1px solid #dee2e6;border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,.18);padding:10px 12px;">
                            <div class="fw-semibold small text-muted mb-2">Send a template</div>
                            <label class="form-label small mb-1">Channel</label>
                            <select class="form-select form-select-sm mb-2" t-on-change="onTemplateChannelChange">
                                <option value="whatsapp" t-att-selected="state.templateChannel === 'whatsapp'">WhatsApp</option>
                                <option value="sms" t-att-selected="state.templateChannel === 'sms'">SMS</option>
                                <option value="email" t-att-selected="state.templateChannel === 'email'">Email</option>
                            </select>
                            <label class="form-label small mb-1">Template</label>
                            <select class="form-select form-select-sm mb-2" t-on-change="onTemplateSelect">
                                <option value="">— Select a template —</option>
                                <t t-foreach="state.templates" t-as="tpl" t-key="tpl.id">
                                    <option t-att-value="tpl.id" t-att-selected="tpl.id === state.selectedTemplateId"><t t-esc="tpl.name"/></option>
                                </t>
                            </select>
                            <div t-if="!state.templates.length" class="small text-muted mb-2">No templates for this channel.</div>
                            <div t-if="templateWarning" class="alert alert-warning py-1 px-2 small mb-2">
                                <i class="fa fa-exclamation-triangle me-1"/><t t-esc="templateWarning"/>
                            </div>
                            <div t-if="state.templateError" class="alert alert-danger py-1 px-2 small mb-2"><t t-esc="state.templateError"/></div>
                            <button class="btn btn-primary btn-sm w-100"
                                    t-att-disabled="!state.selectedTemplateId or templateWarning or state.templateSending"
                                    t-on-click="sendTemplate">
                                <t t-esc="state.templateSending ? 'Sending…' : 'Send'"/>
                            </button>
                        </div>
                    </div>
                </div>
                <t t-if="!state.selectedId">
                    <div class="d-flex align-items-center justify-content-center flex-grow-1 text-muted">
                        Select a conversation on the left to see its thread
                    </div>
                </t>
                <t t-else="">
                    <div class="flex-grow-1 overflow-auto p-3" t-ref="thread">
                        <div t-if="state.loadingMessages" class="text-muted">Loading…</div>
                        <t t-foreach="state.messages" t-as="msg" t-key="msg.id">
                            <div class="d-flex mb-2"
                                 t-att-class="msg.direction === 'outbound' ? 'justify-content-end' : 'justify-content-start'">
                                <div class="o_cx_inbox_bubble p-2"
                                     t-att-class="msg.direction === 'outbound' ? 'bg-primary text-white' : 'bg-light'">
                                    <div class="small opacity-75">
                                        <span class="badge text-bg-dark me-1 text-uppercase" t-if="msg.channel_code"><t t-esc="msg.channel_code"/></span>
                                        <t t-esc="msg.at"/>
                                    </div>
                                    <div style="white-space: pre-wrap;"><t t-esc="msg.rendered_body or msg.raw_body"/></div>
                                    <div class="mt-1" t-if="msg.recording_url">
                                        <audio controls="controls" preload="none" t-att-src="msg.recording_url"
                                               style="max-width:260px;height:32px;"/>
                                        <span class="small opacity-75 ms-1" t-if="msg.recording_duration"><t t-esc="msg.recording_duration"/></span>
                                    </div>
                                    <div class="mt-1 small fst-italic opacity-75" t-if="msg.transcript" style="white-space:pre-wrap;">
                                        <i class="fa fa-quote-left me-1"/><t t-esc="msg.transcript"/>
                                    </div>
                                    <div class="mt-1" t-if="msg.source_model === 'whatsapp.message' and msg.recording_url and !msg.transcript">
                                        <button class="btn btn-sm btn-outline-secondary py-0 px-1"
                                                t-att-disabled="state.transcribingId === msg.id"
                                                t-on-click="() => this.transcribeMessage(msg)">
                                            <i class="fa fa-magic me-1"/><t t-esc="state.transcribingId === msg.id ? 'Transcribing…' : 'Transcribe now'"/>
                                        </button>
                                    </div>
                                    <div class="small opacity-75" t-if="msg.direction === 'outbound'"><t t-esc="msg.status"/></div>
                                </div>
                            </div>
                        </t>
                        <div t-if="!state.loadingMessages and !state.messages.length" class="text-muted">
                            No messages yet
                        </div>
                    </div>
                    <div class="border-top p-2 d-flex gap-2 align-items-end">
                        <select class="form-select form-select-sm" style="width: auto;" t-model="state.composerChannel">
                            <option value="whatsapp">WhatsApp</option>
                            <option value="sms">SMS</option>
                            <option value="email">Email</option>
                        </select>
                        <textarea class="form-control form-control-sm o_cx_inbox_composer" rows="1"
                                  t-att-value="state.composerText" t-on-input="onComposerInput"
                                  placeholder="Type a reply..."/>
                        <button class="btn btn-primary btn-sm" t-on-click="sendReply">Send</button>
                    </div>
                </t>
            </div>

            <!-- Mobile-only backdrop: tap outside the drawer to close it. -->
            <div class="o_cx_inbox_backdrop d-md-none" t-if="state.showSide" t-on-click="toggleSide"/>

            <!-- ── Right: disposition + internal notes (comm.conversation is a mail.thread) ── -->
            <div class="o_cx_inbox_side d-flex flex-column overflow-auto"
                 t-att-class="{'o_cx_inbox_side_open': state.showSide}">
                <div class="o_cx_inbox_pane_header">Disposition &amp; Notes</div>
                <t t-if="!state.selectedId">
                    <div class="p-3 text-muted small">Select a conversation to set its outcome and see its internal notes</div>
                </t>
                <t t-else="">
                    <div class="p-2 border-bottom">
                        <label class="form-label small mb-1">Disposition</label>
                        <select class="form-select form-select-sm mb-2" t-on-change="onDispositionChange">
                            <option value="">— none —</option>
                            <t t-foreach="state.dispositions" t-as="d" t-key="d.id">
                                <option t-att-value="d.id" t-att-selected="d.id === state.dispositionId">
                                    <t t-esc="d.name"/>
                                </option>
                            </t>
                        </select>
                        <textarea class="form-control form-control-sm" rows="2"
                                  placeholder="Wrap-up note…"
                                  t-att-value="state.dispositionNote"
                                  t-on-input="onDispositionNoteInput"
                                  t-on-change="saveDispositionNote"/>
                    </div>
                    <div class="p-2">
                        <Chatter threadModel="'comm.conversation'" threadId="state.selectedId"/>
                    </div>
                </t>
            </div>
        </div>
    </t>

</templates>
