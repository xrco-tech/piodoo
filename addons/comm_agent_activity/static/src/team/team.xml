<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="comm_agent_activity.Team">
        <div class="o_action o_caa" t-att-class="{ busy: state.busy }">
            <t t-if="state.view === 'team'" t-call="comm_agent_activity.Team.All"/>
            <t t-elif="state.view === 'agent'" t-call="comm_agent_activity.Team.One"/>
            <t t-elif="state.view === 'targets'" t-call="comm_agent_activity.Team.Targets"/>
            <t t-else="" t-call="comm_agent_activity.Team.Points"/>
        </div>
    </t>

    <!-- The same pills as the spend reports: workspace under the title, period beside it. -->
    <t t-name="comm_agent_activity.Team.Sources">
        <div t-if="sources.length" class="o_caa_chips o_caa_chips_sm" role="group" aria-label="Workspace">
            <button t-foreach="sources" t-as="s" t-key="s.key" type="button" class="o_caa_chip o_caa_chip_sm" t-att-class="{ on: state.source === s.key }"
                    t-att-aria-pressed="state.source === s.key ? 'true' : 'false'" t-on-click="() => this.setSource(s.key)" t-esc="s.label"/>
        </div>
    </t>
    <t t-name="comm_agent_activity.Team.Periods">
        <div class="o_caa_chips" role="group" aria-label="Period">
            <button t-foreach="periods" t-as="p" t-key="p.key" type="button" class="o_caa_chip" t-att-class="{ on: state.period === p.key }"
                    t-att-aria-pressed="state.period === p.key ? 'true' : 'false'" t-on-click="() => this.setPeriod(p.key)" t-esc="p.label"/>
        </div>
    </t>

    <!-- Which agents the page is about: all of them, or the ones ticked. -->
    <t t-name="comm_agent_activity.Team.Agents">
        <div t-if="state.team and state.team.agents.length" class="o_caa_pick">
            <button type="button" class="o_caa_chip o_caa_pickbtn" t-att-class="{ on: state.picked.length }"
                    aria-haspopup="true" t-att-aria-expanded="state.pickOpen ? 'true' : 'false'" t-on-click="togglePick">
                <i class="fa fa-users" aria-hidden="true"/>
                <span t-esc="agentsLabel"/>
                <i class="fa fa-caret-down" aria-hidden="true"/>
            </button>
            <t t-if="state.pickOpen">
                <div class="o_caa_pickback" t-on-click="closePick"/>
                <div class="o_caa_pickmenu o_caa_box" role="group" aria-label="Agents">
                    <label class="o_caa_pickrow o_caa_pickall">
                        <input type="checkbox" class="form-check-input" t-att-checked="allPicked" t-on-change="pickAll"/>
                        <b>All agents</b>
                    </label>
                    <div class="o_caa_picklist">
                        <label t-foreach="state.team.agents" t-as="agent" t-key="agent.id" class="o_caa_pickrow">
                            <input type="checkbox" class="form-check-input" t-att-checked="state.pickDraft[agent.id]"
                                   t-on-change="() => this.pickOne(agent.id)"/>
                            <span class="o_caa_avatar" aria-hidden="true" t-esc="agent.initials"/>
                            <span class="o_caa_pickname" t-esc="agent.name"/>
                        </label>
                    </div>
                    <div class="o_caa_pickfoot">
                        <span class="o_caa_muted" t-esc="pickNote"/>
                        <button type="button" class="btn btn-primary" t-att-disabled="!pickCount" t-on-click="applyPick">Show</button>
                    </div>
                </div>
            </t>
        </div>
    </t>

    <!-- What was done each day (each hour, for one day), with the period before as a dashed line. -->
    <t t-name="comm_agent_activity.Team.Chart">
        <t t-set="ch" t-value="chart"/>
        <section class="o_caa_box o_caa_chart" aria-label="Activity per day">
            <div class="o_caa_charthead">
                <h2 t-esc="ch.title"/>
                <span class="o_caa_muted" t-esc="ch.sub"/>
                <span class="o_caa_grow"/>
                <div class="o_caa_chips" role="group" aria-label="What to count">
                    <button t-foreach="measures" t-as="m" t-key="m.key" type="button" class="o_caa_chip o_caa_chip_sm"
                            t-att-class="{ on: state.measure === m.key }" t-att-aria-pressed="state.measure === m.key ? 'true' : 'false'"
                            t-on-click="() => this.setMeasure(m.key)" t-esc="m.label"/>
                </div>
            </div>
            <div t-if="ch.empty" class="o_caa_none">Nothing recorded in this period yet.</div>
            <t t-else="">
                <div class="o_caa_legend">
                    <span t-foreach="ch.legend" t-as="k" t-key="k.key"><i t-att-class="k.cls" aria-hidden="true"/><t t-esc="k.label"/></span>
                    <span t-if="ch.line"><i class="dash" aria-hidden="true"/><t t-esc="ch.beforeLabel"/></span>
                </div>
                <div class="o_caa_plotwrap">
                    <div class="o_caa_axis" aria-hidden="true"><span t-foreach="ch.ticks" t-as="tick" t-key="tick_index" t-esc="tick"/></div>
                    <div class="o_caa_plotscroll">
                        <div class="o_caa_plotin" t-att-style="ch.width">
                            <div class="o_caa_plot" t-on-mouseleave="() => this.setHover(null)">
                                <div class="o_caa_grid" aria-hidden="true"><span/><span/><span/><span/></div>
                                <div class="o_caa_cols">
                                    <div t-foreach="ch.bars" t-as="bar" t-key="bar.key" class="o_caa_colm" tabindex="0"
                                         t-att-class="{ on: state.hover === bar_index }" t-att-aria-label="bar.aria"
                                         t-on-mouseenter="() => this.setHover(bar_index)" t-on-focus="() => this.setHover(bar_index)"
                                         t-on-blur="() => this.setHover(null)">
                                        <div class="o_caa_stack">
                                            <div t-foreach="bar.segs" t-as="seg" t-key="seg.key" t-att-class="seg.cls" t-att-style="seg.style"/>
                                            <span t-if="bar.top" class="o_caa_top" t-esc="bar.top"/>
                                        </div>
                                    </div>
                                </div>
                                <svg t-if="ch.line" class="o_caa_line" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                                    <polyline class="halo" t-att-points="ch.line"/>
                                    <polyline t-att-points="ch.line"/>
                                </svg>
                                <div t-if="hover" class="o_caa_tip" t-att-style="hover.style" role="status">
                                    <b t-esc="hover.title"/>
                                    <span t-foreach="hover.rows" t-as="row" t-key="row.key"><span t-esc="row.label"/><b t-esc="row.value"/></span>
                                    <span t-if="hover.total" class="all"><span>All</span><b t-esc="hover.total"/></span>
                                    <span t-if="hover.before" class="was"><span t-esc="ch.beforeLabel"/><b t-esc="hover.before"/></span>
                                </div>
                            </div>
                            <div class="o_caa_days" aria-hidden="true">
                                <span t-foreach="ch.bars" t-as="bar" t-key="bar.key" t-att-class="{ weekend: bar.weekend, now: bar.now }" t-esc="bar.label"/>
                            </div>
                        </div>
                    </div>
                </div>
                <span class="o_caa_muted" t-esc="ch.note"/>
            </t>
        </section>
    </t>

    <!-- Everyone, for a supervisor -->
    <t t-name="comm_agent_activity.Team.All">
        <div class="o_caa_head">
            <div class="o_caa_title">
                <h1>Team</h1>
                <span class="o_caa_muted">What each agent did, how fast, and how well.<t t-if="state.team"> <t t-esc="state.team.label"/>.</t></span>
                <t t-call="comm_agent_activity.Team.Sources"/>
            </div>
            <t t-call="comm_agent_activity.Team.Agents"/>
            <t t-call="comm_agent_activity.Team.Periods"/>
            <button t-if="state.team" type="button" class="btn btn-primary" t-on-click="download">
                <i class="fa fa-download me-1" aria-hidden="true"/> Download
            </button>
        </div>
        <div class="o_caa_box o_caa_setline">
            <span class="o_caa_muted">
                <t t-if="state.team" t-esc="targetsNote"/> Points decide the score.
            </span>
            <span class="o_caa_setlinks">
                <button type="button" class="btn btn-link" t-on-click="openTargets">Set targets</button>
                <button type="button" class="btn btn-link" t-on-click="openPoints">Set the points</button>
            </span>
        </div>

        <div t-if="!state.team" class="o_caa_none">Loading…</div>
        <t t-else="">
            <t t-set="team" t-value="state.team"/>
            <div class="o_caa_tiles">
                <div t-foreach="tiles" t-as="tile" t-key="tile.key" class="o_caa_box o_caa_tile">
                    <span class="o_caa_muted" t-esc="tile.label"/>
                    <b t-esc="tile.value"/>
                    <span class="o_caa_muted" t-att-class="{ bad: tile.bad }" t-esc="tile.note"/>
                </div>
            </div>

            <t t-call="comm_agent_activity.Team.Chart"/>

            <section t-if="team.targets.rows.length" class="o_caa_box o_caa_scroll" aria-label="Targets today">
                <div class="o_caa_between o_caa_thead2"><h2>Targets today</h2><span class="o_caa_muted">Each agent against their own targets, whatever period is chosen above</span></div>
                <div class="o_caa_row o_caa_thead o_caa_trow" t-att-style="targetGrid">
                    <span>Agent</span>
                    <span t-foreach="team.targets.columns" t-as="col" t-key="col.key" t-esc="col.label"/>
                    <span>Reached</span>
                </div>
                <div t-foreach="teamTargets" t-as="row" t-key="row.user_id" class="o_caa_row o_caa_trow" t-att-style="targetGrid">
                    <span>
                        <button type="button" class="o_caa_agent" t-on-click="() => this.openAgent(row.user_id)">
                            <span class="o_caa_avatar" aria-hidden="true" t-esc="row.initials"/>
                            <span class="o_caa_who"><b t-esc="row.name"/><span t-if="row.own" class="o_caa_flag">Own targets</span></span>
                        </button>
                    </span>
                    <span t-foreach="row.cells" t-as="cell" t-key="cell.key" class="o_caa_tcell">
                        <span t-att-class="cell.tone" t-esc="cell.text"/>
                        <span class="o_caa_track" aria-hidden="true"><span t-att-class="cell.tone" t-att-style="cell.bar"/></span>
                    </span>
                    <span><span class="o_caa_tpill" t-att-class="row.pill"><t t-esc="row.reached"/> of <t t-esc="row.of"/></span></span>
                </div>
            </section>

            <div t-if="!team.rows.length" class="o_caa_box o_caa_none">Nobody is set up as an agent yet.</div>
            <div t-else="" class="o_caa_box o_caa_scroll">
                <div class="o_caa_table" role="table" aria-label="Agents">
                    <div class="o_caa_row o_caa_thead" role="row" t-att-style="gridStyle">
                        <span role="columnheader">Agent</span>
                        <span role="columnheader">Active time</span>
                        <span t-foreach="team.columns" t-as="col" t-key="col.key" role="columnheader" t-esc="col.label"/>
                        <span role="columnheader">Reply wait</span>
                        <span role="columnheader">Calls, talk time</span>
                        <span role="columnheader">Reversed later</span>
                        <span role="columnheader">Score</span>
                    </div>
                    <div t-foreach="team.rows" t-as="row" t-key="row.user_id" class="o_caa_row" role="row"
                         t-att-class="{ idle: !row.actions }" t-att-style="gridStyle">
                        <span role="cell">
                            <t t-set="flag" t-value="this.flag(row)"/>
                            <button type="button" class="o_caa_agent" t-on-click="() => this.openAgent(row.user_id)">
                                <span class="o_caa_avatar" aria-hidden="true" t-esc="row.initials"/>
                                <span class="o_caa_who">
                                    <b t-esc="row.name"/>
                                    <span class="o_caa_flag" t-att-class="{ warn: flag.warn }" t-esc="flag.text"/>
                                </span>
                            </button>
                        </span>
                        <span role="cell" t-esc="row.actions ? hm(row.active_seconds) : '–'"/>
                        <span t-foreach="team.columns" t-as="col" t-key="col.key" role="cell" t-esc="num(row.counts[col.key])"/>
                        <span role="cell" t-esc="span(row.wait_median)"/>
                        <span role="cell" t-esc="this.calls(row)"/>
                        <span role="cell"><span t-att-class="{ o_caa_pill: this.manyReversed(row) }" t-esc="row.reversed"/></span>
                        <b role="cell" t-esc="num(row.score)"/>
                    </div>
                    <div class="o_caa_row o_caa_total" role="row" t-att-style="gridStyle">
                        <span role="cell">Team</span>
                        <span role="cell" t-esc="hm(team.total.active_seconds)"/>
                        <span t-foreach="team.columns" t-as="col" t-key="col.key" role="cell" t-esc="num(team.total.counts[col.key])"/>
                        <span role="cell" t-esc="span(team.total.wait_median)"/>
                        <span role="cell" t-esc="this.calls(team.total)"/>
                        <span role="cell" t-esc="team.total.reversed"/>
                        <span role="cell" t-esc="num(team.total.score)"/>
                    </div>
                </div>
            </div>

            <div class="o_caa_panels">
                <section t-if="backlog.length" class="o_caa_box o_caa_panel" aria-label="Planning">
                    <h2>Planning: work waiting against the team's pace</h2>
                    <div t-foreach="backlog" t-as="item" t-key="item.key" class="o_caa_backlog">
                        <div class="o_caa_between"><b t-esc="item.title"/><span t-att-class="{ bad: item.behind }" t-esc="item.eta"/></div>
                        <div class="o_caa_track" aria-hidden="true"><div t-att-style="item.bar"/></div>
                        <span class="o_caa_muted" t-esc="item.detail"/>
                    </div>
                    <span class="o_caa_note">
                        <t t-if="team.extra_hours">To clear all of it in two weeks the team needs about <b><t t-esc="team.extra_hours"/> more agent hours a week</b> on this work.</t>
                        <t t-else="">At this pace the team clears what is waiting within two weeks.</t>
                    </span>
                </section>
                <section class="o_caa_box o_caa_panel" aria-label="When people wait longest">
                    <h2>When people wait longest</h2>
                    <span class="o_caa_muted">Median wait for an agent's reply, by the hour the person wrote</span>
                    <div t-if="!hasWaits" class="o_caa_none">No reply with a wait in this period yet.</div>
                    <div t-else="" class="o_caa_bars">
                        <div t-foreach="hours" t-as="h" t-key="h.key" class="o_caa_bar">
                            <span t-esc="h.wait"/>
                            <div t-att-class="h.tone" t-att-style="h.bar" aria-hidden="true"/>
                            <span class="o_caa_muted" t-esc="h.label"/>
                        </div>
                    </div>
                </section>
            </div>
        </t>
    </t>

    <!-- One agent: for a supervisor, or an agent's own figures -->
    <t t-name="comm_agent_activity.Team.One">
        <div t-if="!state.agent" class="o_caa_none">Loading…</div>
        <t t-else="">
            <t t-set="a" t-value="state.agent"/>
            <div class="o_caa_head">
                <button t-if="a.supervisor" type="button" class="o_caa_back" aria-label="Back to the team" t-on-click="openTeam">
                    <i class="fa fa-chevron-left" aria-hidden="true"/>
                </button>
                <span class="o_caa_avatar big" aria-hidden="true" t-esc="a.me.initials"/>
                <div class="o_caa_title">
                    <h1 t-if="a.own and !a.supervisor">My activity</h1>
                    <h1 t-else="" t-esc="a.me.name"/>
                    <span class="o_caa_muted"><t t-if="a.own and !a.supervisor"><t t-esc="a.me.name"/> · </t><t t-esc="a.label"/></span>
                    <t t-call="comm_agent_activity.Team.Sources"/>
                </div>
                <t t-call="comm_agent_activity.Team.Periods"/>
            </div>

            <div class="o_caa_one">
                <div class="o_caa_col">
                    <t t-if="progress.has">
                        <t t-set="pr" t-value="progress"/>
                        <div class="o_caa_score o_caa_phead">
                            <div><b t-esc="pr.head"/><span class="soft" t-esc="pr.hint"/></div>
                        </div>
                        <section t-if="pr.today.length" class="o_caa_box o_caa_panel" aria-label="Today's targets">
                            <h2>Today</h2>
                            <t t-foreach="pr.today" t-as="item" t-key="item.key" t-call="comm_agent_activity.Team.Target"/>
                        </section>
                        <section t-if="pr.week.length" class="o_caa_box o_caa_panel" aria-label="This week's targets">
                            <h2>This week</h2>
                            <t t-foreach="pr.week" t-as="item" t-key="item.key" t-call="comm_agent_activity.Team.Target"/>
                        </section>
                        <section t-if="pr.history.length" class="o_caa_box o_caa_panel" aria-label="Last working days">
                            <h2>Last 5 working days</h2>
                            <div class="o_caa_hist">
                                <div t-foreach="pr.history" t-as="day" t-key="day.key"><b t-att-class="{ ok: day.full }" t-esc="day.reached"/><span class="o_caa_muted" t-esc="day.label"/></div>
                            </div>
                            <span class="o_caa_muted">Daily targets reached each day, out of <t t-esc="pr.today.length"/></span>
                        </section>
                    </t>

                    <div class="o_caa_score">
                        <div><span>Score</span><b t-esc="num(a.me.score)"/></div>
                        <div>
                            <span t-if="a.team.score !== false">Team average is <t t-esc="num(a.team.score)"/></span>
                            <span class="soft" t-esc="scoreNote"/>
                        </div>
                    </div>

                    <div t-if="a.supervisor and !a.own and concerns.length" class="o_caa_concern">
                        <b>Worth a conversation</b>
                        <span t-foreach="concerns" t-as="line" t-key="line_index" t-esc="line"/>
                    </div>

                    <div class="o_caa_box o_caa_compare">
                        <div class="o_caa_crow head"><span/><span t-esc="a.own ? 'Me' : a.me.name"/><span>Team average</span></div>
                        <div t-foreach="compare" t-as="row" t-key="row.key" class="o_caa_crow">
                            <span t-esc="row.label"/>
                            <b t-att-class="row.tone" t-esc="row.me"/>
                            <span class="o_caa_muted" t-esc="row.team"/>
                        </div>
                    </div>
                    <span t-if="!a.supervisor" class="o_caa_muted">You see your own figures and the team average. Supervisors see everyone's.</span>
                    <span t-else="" class="o_caa_muted">The team average is over the <t t-esc="a.agents"/> agents who did something in this period.</span>
                </div>

                <div class="o_caa_col">
                    <section class="o_caa_box o_caa_panel" aria-label="Active time each day">
                        <h2>Active time each day</h2>
                        <div class="o_caa_bars">
                            <div t-foreach="days" t-as="d" t-key="d.key" class="o_caa_bar">
                                <span t-esc="d.time"/>
                                <div t-att-style="d.bar" aria-hidden="true"/>
                                <span class="o_caa_muted" t-esc="d.label"/>
                            </div>
                        </div>
                    </section>

                    <section t-if="a.own and a.today.length" class="o_caa_box o_caa_panel" aria-label="Today">
                        <h2>Today</h2>
                        <div t-foreach="a.today" t-as="t" t-key="t.label" class="o_caa_between"><span t-esc="t.label"/><b t-esc="t.n"/></div>
                    </section>

                    <section class="o_caa_box o_caa_panel" aria-label="Latest activity">
                        <h2>Latest activity</h2>
                        <div t-if="!log.length" class="o_caa_muted">Nothing in this period.</div>
                        <div t-foreach="log" t-as="line" t-key="line.id" class="o_caa_log">
                            <span class="o_caa_muted" t-esc="line.when"/>
                            <b t-esc="line.action"/>
                            <span class="name" t-esc="line.name"/>
                            <span t-att-class="line.tone || 'o_caa_muted'" t-esc="line.result"/>
                        </div>
                    </section>
                </div>
            </div>
        </t>
    </t>

    <!-- One target with its bar -->
    <t t-name="comm_agent_activity.Team.Target">
        <div class="o_caa_target">
            <div class="o_caa_between"><span t-esc="item.label"/><b t-esc="item.text"/></div>
            <div class="o_caa_track" aria-hidden="true"><span t-att-class="item.tone" t-att-style="item.bar"/></div>
            <span class="o_caa_tnote" t-att-class="item.tone" t-esc="item.note"/>
        </div>
    </t>

    <!-- Targets: for every agent, and different for one agent -->
    <t t-name="comm_agent_activity.Team.Targets">
        <div class="o_caa_head">
            <button type="button" class="o_caa_back" aria-label="Back to the team" t-on-click="openTeam">
                <i class="fa fa-chevron-left" aria-hidden="true"/>
            </button>
            <div class="o_caa_title">
                <h1>Targets</h1>
                <span class="o_caa_muted">What each agent should reach. Agents see their own progress in My activity and while they work.</span>
            </div>
            <button type="button" class="btn btn-secondary" t-on-click="openTeam">Cancel</button>
            <button t-if="state.targets" type="button" class="btn btn-primary" t-att-disabled="state.busy" t-on-click="saveTargets">Save targets</button>
        </div>
        <div t-if="!state.targets" class="o_caa_none">Loading…</div>
        <div t-else="" class="o_caa_tgrid">
            <t t-set="tg" t-value="state.targets"/>
            <div class="o_caa_col">
                <section class="o_caa_box o_caa_scroll" aria-label="Targets for every agent">
                    <div class="o_caa_between o_caa_thead2"><h2>For every agent</h2><span class="o_caa_muted">Switch one off to leave it without a target. Daily targets count Monday to Friday.</span></div>
                    <div class="o_caa_srow head"><span>On</span><span>What is measured</span><span>Target</span><span>Counted</span><span>What the team does now</span></div>
                    <div t-foreach="tg.rows" t-as="row" t-key="row.metric" class="o_caa_srow">
                        <t t-set="words" t-value="this.targetWords(row)"/>
                        <t t-set="edit" t-value="state.targetEdits[row.metric]"/>
                        <input type="checkbox" class="form-check-input" t-att-aria-label="'Use a target for: ' + row.label"
                               t-att-checked="edit.on" t-on-change="(ev) => edit.on = ev.target.checked"/>
                        <label t-att-for="'o_caa_t_' + row.metric"><b t-esc="row.label"/><span class="o_caa_muted" t-esc="words.many"/></label>
                        <input t-att-id="'o_caa_t_' + row.metric" type="text" inputmode="decimal" class="form-control"
                               t-att-value="edit.value" t-att-disabled="!edit.on" t-on-input="(ev) => edit.value = ev.target.value"/>
                        <span t-esc="words.per"/>
                        <span class="o_caa_muted" t-esc="words.now"/>
                    </div>
                </section>

                <section class="o_caa_box o_caa_panel" aria-label="Different for one agent">
                    <div class="o_caa_between">
                        <div class="o_caa_who"><h2>Different for one agent</h2><span class="o_caa_muted">For part-time agents, new starters, or someone on other duties</span></div>
                        <button t-if="!state.person and freeAgents.length" type="button" class="btn btn-secondary" t-on-click="() => this.editPerson(null)">Add an agent</button>
                    </div>
                    <div t-if="!tg.people.length and !state.person" class="o_caa_muted">Everyone has the same targets.</div>
                    <div t-foreach="tg.people" t-as="person" t-key="person.user_id" class="o_caa_person">
                        <span class="o_caa_avatar" aria-hidden="true" t-esc="person.initials"/>
                        <span class="o_caa_who"><b t-esc="person.name"/><span class="o_caa_muted" t-esc="person.note"/></span>
                        <span class="o_caa_pwords" t-esc="this.personWords(person)"/>
                        <button type="button" class="btn btn-link" t-on-click="() => this.editPerson(person)">Change</button>
                    </div>
                    <div t-if="state.person" class="o_caa_pedit">
                        <t t-set="p" t-value="state.person"/>
                        <label t-if="p.isNew">Agent
                            <select class="form-select" t-on-change="(ev) => p.user_id = parseInt(ev.target.value)">
                                <option t-foreach="freeAgents" t-as="agent" t-key="agent.id" t-att-value="agent.id" t-att-selected="agent.id === p.user_id" t-esc="agent.name"/>
                            </select>
                        </label>
                        <b t-else="" t-esc="p.name"/>
                        <label>Why they are different
                            <input type="text" class="form-control" placeholder="Part time, 3 days a week" t-att-value="p.note" t-on-input="(ev) => p.note = ev.target.value"/>
                        </label>
                        <span class="o_caa_muted">Fill in only what is different. An empty box means the same as everyone.</span>
                        <div class="o_caa_pfields">
                            <label t-foreach="tg.rows" t-as="row" t-key="row.metric"><t t-esc="row.label"/>
                                <input type="text" inputmode="decimal" class="form-control" t-att-placeholder="state.targetEdits[row.metric].on ? state.targetEdits[row.metric].value : 'No target'"
                                       t-att-value="p.values[row.metric]" t-on-input="(ev) => p.values[row.metric] = ev.target.value"/>
                            </label>
                        </div>
                        <div class="o_caa_pfoot">
                            <button t-if="!p.isNew" type="button" class="btn btn-link text-danger" t-att-disabled="state.busy" t-on-click="removePerson">Remove their own targets</button>
                            <span class="o_caa_muted"/>
                            <button type="button" class="btn btn-secondary" t-on-click="() => state.person = null">Cancel</button>
                            <button type="button" class="btn btn-primary" t-att-disabled="state.busy" t-on-click="savePerson">Save for this agent</button>
                        </div>
                    </div>
                </section>
            </div>

            <section class="o_caa_box o_caa_panel" aria-label="What these targets add up to">
                <h2>What these targets add up to</h2>
                <span class="o_caa_muted">With <t t-esc="tg.agent_count"/> agents, 5 days a week, as last saved</span>
                <div t-if="!tg.effects.length" class="o_caa_muted">Switch on a target for jobs, employers or queued calls to see what it does to the work waiting.</div>
                <div t-foreach="tg.effects" t-as="effect" t-key="effect.key" class="o_caa_note o_caa_effect"><b t-esc="effect.title"/><span t-esc="effect.text"/></div>
            </section>
        </div>
    </t>

    <!-- The points each action is worth -->
    <t t-name="comm_agent_activity.Team.Points">
        <div class="o_caa_head">
            <button type="button" class="o_caa_back" aria-label="Back to the team" t-on-click="openTeam">
                <i class="fa fa-chevron-left" aria-hidden="true"/>
            </button>
            <div class="o_caa_title">
                <h1>How the score is worked out</h1>
                <span class="o_caa_muted">Each action earns points. A decision someone has to undo later loses points, so speed alone does not win.</span>
            </div>
        </div>
        <div t-if="!state.points" class="o_caa_none">Loading…</div>
        <div t-else="" class="o_caa_box o_caa_points">
            <div class="o_caa_prow head"><span>Action</span><span>Points each</span></div>
            <div t-foreach="state.points.rows" t-as="row" t-key="row.action" class="o_caa_prow">
                <label t-att-for="'o_caa_p_' + row.action"><b t-esc="row.label"/><span class="o_caa_muted" t-esc="row.why"/></label>
                <input t-att-id="'o_caa_p_' + row.action" type="text" inputmode="decimal" class="form-control"
                       t-att-value="state.edits[row.action]" t-att-disabled="!state.points.can_edit"
                       t-on-input="(ev) => this.setPoints(row.action, ev)"/>
            </div>
            <div class="o_caa_pfoot">
                <span class="o_caa_muted">Changing the points changes the scores of past periods too, so compare periods only once the points are settled.</span>
                <button type="button" class="btn btn-secondary" t-on-click="openTeam">Cancel</button>
                <button t-if="state.points.can_edit" type="button" class="btn btn-primary" t-att-disabled="state.busy" t-on-click="savePoints">Save points</button>
            </div>
        </div>
    </t>

</templates>
