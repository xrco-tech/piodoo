<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <menuitem id="menu_comm_billing_root"
              name="Ops Costs"
              sequence="80"
              web_icon="comm_billing_core,static/description/icon.svg"/>

    <menuitem id="menu_comm_billing_reports"
              name="Reports"
              parent="menu_comm_billing_root"
              action="action_comm_billing_reports"
              sequence="5"/>

    <!-- Reports is the app's one everyday screen. Everything else sits under
         Configuration; menus are read in order, so Configuration comes first. -->
    <menuitem id="menu_comm_billing_config"
              name="Configuration"
              parent="menu_comm_billing_root"
              sequence="90"/>

    <menuitem id="menu_comm_billing_dashboard"
              name="Analysis"
              parent="menu_comm_billing_config"
              action="action_comm_billing_dashboard"
              sequence="1"/>

    <menuitem id="menu_comm_billing_events"
              name="Billing Events"
              parent="menu_comm_billing_config"
              action="action_comm_billing_event"
              sequence="0"/>

    <menuitem id="menu_comm_billing_budget"
              name="Budget and Warnings"
              parent="menu_comm_billing_config"
              action="action_comm_billing_budget"
              sequence="2"/>

    <menuitem id="menu_comm_billing_fees"
              name="Fixed Fees"
              parent="menu_comm_billing_config"
              action="action_comm_billing_fee"
              sequence="3"/>

    <menuitem id="menu_comm_billing_invoices"
              name="Provider Invoices"
              parent="menu_comm_billing_config"
              action="action_comm_billing_invoice"
              sequence="4"/>

    <menuitem id="menu_comm_billing_rate_cards"
              name="Rate Cards"
              parent="menu_comm_billing_config"
              action="action_comm_billing_rate_card"
              sequence="10"/>

    <menuitem id="menu_comm_billing_rates"
              name="Rates"
              parent="menu_comm_billing_config"
              action="action_comm_billing_rate"
              sequence="20"/>

    <menuitem id="menu_comm_billing_fx"
              name="Provider Monthly FX"
              parent="menu_comm_billing_config"
              action="action_comm_billing_fx_rate"
              sequence="30"/>

    <menuitem id="menu_comm_billing_free_windows"
              name="Free Windows"
              parent="menu_comm_billing_config"
              action="action_comm_billing_free_window"
              sequence="40"/>

</odoo>
