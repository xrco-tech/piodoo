<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_comm_billing_budget_form" model="ir.ui.view">
        <field name="name">comm.billing.budget.form</field>
        <field name="model">comm.billing.budget</field>
        <field name="arch" type="xml">
            <form string="Budget and warnings" create="0" delete="0">
                <sheet>
                    <field name="currency_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <group string="Monthly budget">
                        <field name="amount"/>
                        <div colspan="2" class="text-muted">
                            Most we want to spend in a month, all channels together, before VAT.
                            The same amount applies every month until you change it.
                        </div>
                    </group>
                    <group string="Limit for each channel (optional)">
                        <group>
                            <field name="limit_whatsapp"/>
                            <field name="limit_voice"/>
                            <field name="limit_ai"/>
                        </group>
                        <group>
                            <field name="limit_sms"/>
                            <field name="limit_ussd"/>
                            <field name="limits_total" string="Limits add up to"/>
                        </group>
                        <field name="limits_note" colspan="2" nolabel="1" class="text-muted"/>
                    </group>
                    <group string="Warn the Ops Costs administrators when">
                        <group>
                            <field name="warn_pct"/>
                            <field name="warn_pct_level" invisible="not warn_pct"/>
                            <field name="warn_forecast"/>
                        </group>
                        <group>
                            <field name="warn_channel"/>
                            <field name="warn_day"/>
                            <field name="warn_day_amount" invisible="not warn_day"/>
                        </group>
                        <div colspan="2" class="text-muted">
                            Each warning is sent once a month, as an Odoo notification or an email
                            depending on each person's own notification setting. Nothing is ever
                            blocked: messages and calls keep going when the budget is used up.
                        </div>
                    </group>
                    <group string="Warnings sent">
                        <field name="alert_ids" nolabel="1" colspan="2">
                            <list>
                                <field name="create_date" string="Sent"/>
                                <field name="name"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_comm_billing_budget" model="ir.actions.server">
        <field name="name">Budget and warnings</field>
        <field name="model_id" ref="model_comm_billing_budget"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>

    <record id="view_comm_billing_invoice_list" model="ir.ui.view">
        <field name="name">comm.billing.invoice.list</field>
        <field name="model">comm.billing.invoice</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="currency_id" column_invisible="1"/>
                <field name="company_id" column_invisible="1"/>
                <field name="month"/>
                <field name="provider"/>
                <field name="amount"/>
                <field name="reference"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="action_comm_billing_invoice" model="ir.actions.act_window">
        <field name="name">Provider Invoices</field>
        <field name="res_model">comm.billing.invoice</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Enter what a provider invoiced for a month</p>
            <p>The monthly statement compares each total with what our own records say.
               Write the provider's name exactly as it appears on the billing events.</p>
        </field>
    </record>

    <record id="action_comm_billing_reports" model="ir.actions.client">
        <field name="name">Reports</field>
        <field name="tag">comm_billing_core.reports</field>
    </record>

</odoo>
