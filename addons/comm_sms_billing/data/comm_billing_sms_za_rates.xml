<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            ZA SMS rates. Infobip domestic outbound is Infobip's published
            South Africa price (USD 0.1012, average across networks, Oct 2026).
            The other Infobip rows are still placeholders. Africa's Talking
            and Connect Mobile rates are their published ZAR prices converted
            at R18.00 = USD 1. Refresh before invoicing.
        -->

        <record id="rate_sms_za_outbound_domestic" model="comm.billing.rate">
            <field name="card_id" ref="rate_card_sms_infobip_default"/>
            <field name="country_id" ref="base.za"/>
            <field name="category">sms_outbound_domestic</field>
            <field name="direction">outbound</field>
            <field name="unit">segment</field>
            <field name="price_usd">0.1012</field>
        </record>

        <record id="rate_sms_za_outbound_intl" model="comm.billing.rate">
            <field name="card_id" ref="rate_card_sms_infobip_default"/>
            <field name="category">sms_outbound_intl</field>
            <field name="direction">outbound</field>
            <field name="unit">segment</field>
            <field name="price_usd">0.05</field>
        </record>

        <record id="rate_sms_za_inbound" model="comm.billing.rate">
            <field name="card_id" ref="rate_card_sms_infobip_default"/>
            <field name="country_id" ref="base.za"/>
            <field name="category">sms_inbound</field>
            <field name="direction">inbound</field>
            <field name="unit">segment</field>
            <field name="price_usd">0.001</field>
        </record>

        <record id="rate_sms_za_two_way" model="comm.billing.rate">
            <field name="card_id" ref="rate_card_sms_infobip_default"/>
            <field name="country_id" ref="base.za"/>
            <field name="category">sms_two_way</field>
            <field name="direction">any</field>
            <field name="unit">segment</field>
            <field name="price_usd">0.012</field>
        </record>

        <!-- Africa's Talking: R0.24 outbound, R0.70 inbound -->
        <record id="rate_sms_za_outbound_domestic_africastalking" model="comm.billing.rate">
            <field name="card_id" ref="rate_card_sms_africastalking_default"/>
            <field name="country_id" ref="base.za"/>
            <field name="category">sms_outbound_domestic</field>
            <field name="direction">outbound</field>
            <field name="unit">segment</field>
            <field name="price_usd">0.013333</field>
        </record>

        <record id="rate_sms_za_inbound_africastalking" model="comm.billing.rate">
            <field name="card_id" ref="rate_card_sms_africastalking_default"/>
            <field name="country_id" ref="base.za"/>
            <field name="category">sms_inbound</field>
            <field name="direction">inbound</field>
            <field name="unit">segment</field>
            <field name="price_usd">0.038889</field>
        </record>

        <!-- Connect Mobile: R0.18 outbound (2023 rate card, ex VAT) -->
        <record id="rate_sms_za_outbound_domestic_connect_mobile" model="comm.billing.rate">
            <field name="card_id" ref="rate_card_sms_connect_mobile_default"/>
            <field name="country_id" ref="base.za"/>
            <field name="category">sms_outbound_domestic</field>
            <field name="direction">outbound</field>
            <field name="unit">segment</field>
            <field name="price_usd">0.01</field>
        </record>

    </data>
</odoo>
