<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_comm_dialer_contact_list" model="ir.ui.view">
        <field name="name">comm.dialer.contact.list</field>
        <field name="model">comm.dialer.contact</field>
        <field name="arch" type="xml">
            <list string="Call List"
                  decoration-success="state == 'contacted'"
                  decoration-danger="state in ('failed','dnc')"
                  decoration-info="state == 'dialing'">
                <field name="campaign_id"/>
                <field name="contact_label" string="Contact"/>
                <field name="number"/>
                <field name="state" widget="badge"/>
                <field name="attempts"/>
                <field name="last_disposition_id" optional="show"/>
                <field name="last_attempt" optional="show"/>
                <field name="next_attempt" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_comm_dialer_contact_form" model="ir.ui.view">
        <field name="name">comm.dialer.contact.form</field>
        <field name="model">comm.dialer.contact</field>
        <field name="arch" type="xml">
            <form string="Call-List Entry">
                <sheet>
                    <group>
                        <group>
                            <field name="campaign_id"/>
                            <field name="partner_id"/>
                            <field name="number"/>
                        </group>
                        <group>
                            <field name="state"/>
                            <field name="attempts"/>
                            <field name="last_disposition_id"/>
                            <field name="last_attempt"/>
                            <field name="next_attempt"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Calls" name="calls">
                            <field name="call_ids">
                                <list>
                                    <field name="start_time"/>
                                    <field name="direction"/>
                                    <field name="to_number"/>
                                    <field name="state" widget="badge"/>
                                    <field name="duration_display" string="Duration"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Notes…"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_comm_dialer_contact_search" model="ir.ui.view">
        <field name="name">comm.dialer.contact.search</field>
        <field name="model">comm.dialer.contact</field>
        <field name="arch" type="xml">
            <search string="Search Call List">
                <field name="contact_label"/>
                <field name="number"/>
                <field name="campaign_id"/>
                <separator/>
                <filter string="Pending" name="pending" domain="[('state','in',('pending','retry'))]"/>
                <filter string="Contacted" name="contacted" domain="[('state','=','contacted')]"/>
                <filter string="Failed / DNC" name="failed" domain="[('state','in',('failed','dnc'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Campaign" name="g_campaign" context="{'group_by':'campaign_id'}"/>
                    <filter string="Status" name="g_state" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_comm_dialer_contact" model="ir.actions.act_window">
        <field name="name">Call Lists</field>
        <field name="res_model">comm.dialer.contact</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_comm_dialer_contact_search"/>
    </record>
</odoo>
