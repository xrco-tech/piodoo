<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Live Calls: supervisor monitor board ───────────────────────────
         Active calls with one-click Listen / Whisper / Barge. -->
    <record id="view_comm_dialer_live_monitor_list" model="ir.ui.view">
        <field name="name">comm.voip.call.live.monitor.list</field>
        <field name="model">comm.voip.call</field>
        <field name="arch" type="xml">
            <list string="Live Calls" create="false" edit="false"
                  default_order="start_time desc">
                <field name="contact_display" string="Contact"/>
                <field name="to_number" optional="show"/>
                <field name="dialer_agent_session_id" string="Agent"/>
                <field name="agent_sip_ext" string="Agent SIP" optional="hide"/>
                <field name="dialer_campaign_id" optional="show"/>
                <field name="duration_display" string="Duration"/>
                <field name="state"/>
                <button name="action_supervisor_listen" type="object" string="Listen"
                        icon="fa-headphones" class="btn-link"
                        help="Silently listen to both sides"/>
                <button name="action_supervisor_whisper" type="object" string="Whisper"
                        icon="fa-comment" class="btn-link"
                        help="Coach the agent — the customer can't hear you"/>
                <button name="action_supervisor_barge" type="object" string="Barge"
                        icon="fa-bullhorn" class="btn-link"
                        help="Join the call — everyone hears you"/>
            </list>
        </field>
    </record>

    <record id="action_comm_dialer_live_monitor" model="ir.actions.act_window">
        <field name="name">Live Calls</field>
        <field name="res_model">comm.voip.call</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_comm_dialer_live_monitor_list"/>
        <field name="domain">[('state', '=', 'in_progress')]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No calls in progress right now</p>
            <p>When agents are on live calls they appear here — pick one to
               Listen, Whisper to the agent, or Barge in.</p>
        </field>
    </record>

    <!-- ── Monitor sessions (audit + stop control) ───────────────────────── -->
    <record id="view_comm_dialer_barge_list" model="ir.ui.view">
        <field name="name">comm.dialer.barge.list</field>
        <field name="model">comm.dialer.barge</field>
        <field name="arch" type="xml">
            <list string="Monitor Sessions" create="false" edit="false">
                <field name="create_date" string="Started"/>
                <field name="supervisor_id"/>
                <field name="call_id"/>
                <field name="agent_ext"/>
                <field name="mode"/>
                <field name="state" decoration-success="state == 'active'"
                       decoration-muted="state == 'ended'"
                       decoration-danger="state == 'failed'"/>
                <field name="error" optional="hide"/>
                <button name="action_stop" type="object" string="Stop"
                        icon="fa-stop" class="btn-link text-danger"
                        invisible="state != 'active'"/>
            </list>
        </field>
    </record>

    <record id="view_comm_dialer_barge_form" model="ir.ui.view">
        <field name="name">comm.dialer.barge.form</field>
        <field name="model">comm.dialer.barge</field>
        <field name="arch" type="xml">
            <form string="Monitor Session">
                <header>
                    <button name="action_stop" type="object" string="Stop"
                            class="btn-danger" invisible="state != 'active'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="requested,active,ended"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="call_id"/>
                            <field name="supervisor_id"/>
                            <field name="mode"/>
                        </group>
                        <group>
                            <field name="supervisor_ext"/>
                            <field name="agent_ext"/>
                            <field name="external_channel_id"/>
                            <field name="error"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_comm_dialer_barge" model="ir.actions.act_window">
        <field name="name">Monitor Sessions</field>
        <field name="res_model">comm.dialer.barge</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
