<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Pacing cron. Disabled by default: turn it on only once a real provider
         is wired into comm.voip.account.originate()/bridge(), otherwise it will
         create call-log rows with no telephony behind them. -->
    <record id="ir_cron_dialer_pace" model="ir.cron">
        <field name="name">Dialer: pace outbound campaigns</field>
        <field name="model_id" ref="model_comm_dialer_campaign"/>
        <field name="state">code</field>
        <field name="code">model._cron_pace()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False"/>
    </record>

    <!-- Dry-run stepper. Safe to leave enabled: _cron_simulate only touches
         campaigns with simulate=True, so it never places real calls. -->
    <record id="ir_cron_dialer_simulate" model="ir.cron">
        <field name="name">Dialer: dry-run simulation tick</field>
        <field name="model_id" ref="model_comm_dialer_campaign"/>
        <field name="state">code</field>
        <field name="code">model._cron_simulate()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!-- Transcribe queued call recordings via the self-hosted Whisper service.
         Enabled; it only touches calls with a recording in 'pending' state, so
         it's inert until recordings exist and Whisper is running. -->
    <record id="ir_cron_dialer_transcribe" model="ir.cron">
        <field name="name">Dialer: transcribe call recordings</field>
        <field name="model_id" ref="comm_chatbot_voip.model_comm_voip_call"/>
        <field name="state">code</field>
        <field name="code">model._cron_transcribe_pending()
env['whatsapp.call.log']._cron_transcribe_pending()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
