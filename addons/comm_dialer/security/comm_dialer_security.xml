<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_dialer" model="ir.module.category">
        <field name="name">Dialer</field>
        <field name="sequence">20</field>
    </record>

    <!-- Supervisors may monitor live calls (Listen / Whisper / Barge). Kept
         separate from agents: monitoring is covert to the customer, so it's
         gated and every session is logged as a comm.dialer.barge record. -->
    <record id="group_dialer_supervisor" model="res.groups">
        <field name="name">Supervisor (Monitor / Barge)</field>
        <field name="category_id" ref="module_category_dialer"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- For the ARI bridge's API user (dialer@bot): sees every VoIP call so it
         can drive calls regardless of which agent they belong to. -->
    <record id="group_dialer_service" model="res.groups">
        <field name="name">Dialer Bridge Service</field>
        <field name="category_id" ref="module_category_dialer"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
