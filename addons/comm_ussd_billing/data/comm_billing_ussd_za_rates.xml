<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Africa's Talking ZA USSD pricing, free to the end user:
            R0.50 for every 20 seconds of a session (confirmed by Africa's
            Talking, November 2026). The shared-cost plan is R0.25 per 20 seconds.
        -->

        <record id="rate_ussd_za_session" model="comm.billing.rate">
            <field name="card_id" ref="rate_card_ussd_africas_talking"/>
            <field name="country_id" ref="base.za"/>
            <field name="category">ussd_session</field>
            <field name="direction">any</field>
            <field name="unit">block_20s</field>
            <field name="price_usd">0.0</field>
            <field name="price_local">0.5</field>
            <field name="local_currency_id" ref="base.ZAR"/>
        </record>

    </data>
</odoo>
