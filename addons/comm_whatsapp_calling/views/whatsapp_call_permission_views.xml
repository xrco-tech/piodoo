<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_whatsapp_call_permission_list" model="ir.ui.view">
        <field name="name">whatsapp.call.permission.list</field>
        <field name="model">whatsapp.call.permission</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="phone"/>
                <field name="partner_id"/>
                <field name="current_state" widget="badge" decoration-success="current_state == 'granted'"
                       decoration-danger="current_state == 'declined'" decoration-warning="current_state in ('pending', 'expired')"/>
                <field name="response_source" optional="show"/>
                <field name="is_permanent" optional="show"/>
                <field name="expires_at" optional="show"/>
                <field name="requested_by_id" optional="show"/>
                <field name="requested_at" optional="show"/>
                <field name="responded_at"/>
            </list>
        </field>
    </record>
    <record id="view_whatsapp_call_permission_search" model="ir.ui.view">
        <field name="name">whatsapp.call.permission.search</field>
        <field name="model">whatsapp.call.permission</field>
        <field name="arch" type="xml">
            <search>
                <field name="phone"/>
                <field name="partner_id"/>
                <filter name="waiting" string="Waiting for reply" domain="[('state', '=', 'pending')]"/>
                <filter name="declined" string="Declined" domain="[('state', '=', 'declined')]"/>
            </search>
        </field>
    </record>
    <record id="action_whatsapp_call_permission" model="ir.actions.act_window">
        <field name="name">Call Permissions</field>
        <field name="res_model">whatsapp.call.permission</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="menu_whatsapp_call_permissions" name="Call Permissions" action="action_whatsapp_call_permission"
              parent="comm_whatsapp.menu_whatsapp_root" sequence="22"/>
</odoo>
