<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Everyone with call-log read access (base.group_user, see
             ir.model.access.csv) can already listen to a recording —
             this group only gates the two elevated actions: forcing a
             download, and deleting a recording. Deliberately separate
             from base.group_system so this right can be handed out
             without full Settings/Administrator access. -->
        <record id="group_whatsapp_call_recording_manager" model="res.groups">
            <field name="name">Call Recording Manager</field>
            <field name="category_id" ref="base.module_category_tools"/>
            <field name="comment">Can download and delete WhatsApp call recordings. Everyone else can only play them back in Odoo.</field>
        </record>

        <!-- Manages the disposition taxonomy (create/edit outcome codes).
             Setting a disposition on a call needs only call-log write
             (base.group_user already has it) — this group gates the
             configuration side. -->
        <record id="group_whatsapp_call_manager" model="res.groups">
            <field name="name">Call Manager</field>
            <field name="category_id" ref="base.module_category_tools"/>
            <field name="comment">Can create and edit call dispositions (outcome codes). Agents can set an existing disposition on a call without this group.</field>
        </record>

        <!-- Can silently monitor (Listen) live WhatsApp calls. Covert to the
             customer, so gated + audited (comm.whatsapp.monitor). -->
        <record id="group_whatsapp_call_supervisor" model="res.groups">
            <field name="name">Call Supervisor (Monitor)</field>
            <field name="category_id" ref="base.module_category_tools"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can listen in on live WhatsApp calls. Every session is logged; pair with a 'calls may be monitored' disclosure.</field>
        </record>
    </data>
</odoo>
