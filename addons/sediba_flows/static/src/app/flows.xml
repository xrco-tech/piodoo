<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="sediba_flows.App">
        <div class="o_sfl" t-ref="root">
            <t t-if="state.view === 'home'" t-call="sediba_flows.Home"/>
            <t t-else="" t-call="sediba_flows.Builder"/>
        </div>
    </t>

    <!-- ── The list of flows ─────────────────────────────────────────────── -->
    <t t-name="sediba_flows.Home">
        <div class="o_sfl_home">
            <div class="o_sfl_head">
                <div class="o_sfl_head_text">
                    <h1>Sediba Flows</h1>
                    <span class="o_sfl_muted">Conversations you design once and run on any channel you have connected.</span>
                </div>
                <button t-if="state.home.can_create" type="button" class="btn btn-primary" t-on-click="newFlow">New flow</button>
            </div>
            <div class="o_sfl_home_body">
                <div class="o_sfl_box o_sfl_flows">
                    <div t-if="!state.home.flows.length" class="o_sfl_empty">
                        No flows yet. A flow is a conversation: what to say, what to ask and where each answer leads.
                    </div>
                    <div t-else="" class="o_sfl_scroll_x">
                        <table class="o_sfl_table">
                            <thead>
                                <tr>
                                    <th scope="col">Flow</th>
                                    <th scope="col">Runs on</th>
                                    <th scope="col" class="o_sfl_num">Steps</th>
                                    <th scope="col">Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="state.home.flows" t-as="flow" t-key="flow.id">
                                    <td>
                                        <button type="button" class="o_sfl_link" t-on-click="() => this.openFlow(flow.id)" t-esc="flow.name"/>
                                    </td>
                                    <td>
                                        <span t-foreach="flow.channels" t-as="name" t-key="name" class="o_sfl_chip" t-esc="name"/>
                                        <span t-if="!flow.channels.length" class="o_sfl_muted">No channel yet</span>
                                    </td>
                                    <td class="o_sfl_num" t-esc="flow.steps"/>
                                    <td>
                                        <b t-if="flow.status === 'live'" t-esc="statusLabel(flow.status)"/>
                                        <span t-else="" class="o_sfl_muted" t-esc="statusLabel(flow.status)"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <t t-if="state.home.legacy and state.home.legacy.length">
                        <h2 class="o_sfl_section">Older bots</h2>
                        <span class="o_sfl_muted o_sfl_small">Bots built in the older WhatsApp chatbot. Bringing one over makes a draft copy here; the older bot is not changed and keeps running.</span>
                        <div class="o_sfl_scroll_x">
                            <table class="o_sfl_table">
                                <thead>
                                    <tr>
                                        <th scope="col">Bot</th>
                                        <th scope="col">Channel</th>
                                        <th scope="col" class="o_sfl_num">Steps</th>
                                        <th scope="col">Status there</th>
                                        <th scope="col"><span class="visually-hidden">Action</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="state.home.legacy" t-as="bot" t-key="bot.id">
                                        <td t-esc="bot.name"/>
                                        <td><span class="o_sfl_chip" t-esc="bot.channel"/></td>
                                        <td class="o_sfl_num" t-esc="bot.steps"/>
                                        <td class="o_sfl_muted" t-esc="bot.status"/>
                                        <td class="o_sfl_num">
                                            <button t-if="bot.flow_id" type="button" class="btn btn-light" t-on-click="() => this.openFlow(bot.flow_id)">Open its flow</button>
                                            <button t-elif="state.home.can_create" type="button" class="btn btn-light" t-att-disabled="state.busy" t-on-click="() => this.importLegacy(bot.id)">Bring over</button>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </t>
                </div>
                <div class="o_sfl_box o_sfl_channels">
                    <h2>Channels</h2>
                    <span class="o_sfl_muted o_sfl_small">Each channel is its own add-on. A flow can use whichever are installed.</span>
                    <div t-foreach="state.home.channels" t-as="channel" t-key="channel.id" class="o_sfl_row">
                        <span t-esc="channel.name"/>
                        <b t-if="channel.connected">Connected</b>
                        <span t-else="" class="o_sfl_muted">Add-on not installed</span>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <!-- ── The builder ───────────────────────────────────────────────────── -->
    <t t-name="sediba_flows.Builder">
        <div class="o_sfl_builder">
            <div class="o_sfl_toolbar">
                <button type="button" class="btn btn-light o_sfl_icon_btn" aria-label="Back to all flows" title="Back to all flows" t-on-click="backHome">
                    <i class="fa fa-chevron-left" aria-hidden="true"/>
                </button>
                <button t-if="canEdit" type="button" class="btn btn-primary" t-on-click="addStepFromToolbar">Add step</button>
                <input type="text" class="o_sfl_title" aria-label="Flow name" t-model="state.flowName"
                       t-att-disabled="!canEdit" t-on-change="renameFlow"/>
                <span class="o_sfl_status" t-att-class="{o_sfl_live: isLive}" t-esc="statusLabel(state.data.flow.status)"/>
                <span class="o_sfl_grow"/>
                <t t-if="flowChannels.length">
                    <span class="o_sfl_muted">Show as</span>
                    <div class="o_sfl_pills" role="group" aria-label="Show as channel">
                        <button type="button" class="o_sfl_pill" t-att-class="{active: state.showAs === 'all'}"
                                t-att-aria-pressed="state.showAs === 'all' ? 'true' : 'false'"
                                t-on-click="() => this.state.showAs = 'all'">All</button>
                        <button t-foreach="flowChannels" t-as="channel" t-key="channel.id" type="button" class="o_sfl_pill"
                                t-att-class="{active: state.showAs === channel.code}"
                                t-att-aria-pressed="state.showAs === channel.code ? 'true' : 'false'"
                                t-on-click="() => this.state.showAs = channel.code" t-esc="channel.name"/>
                    </div>
                </t>
                <button type="button" class="btn btn-light o_sfl_icon_btn" aria-label="Zoom out" t-on-click="() => this.setZoom(-0.1)">−</button>
                <span class="o_sfl_zoom" t-esc="zoomLabel"/>
                <button type="button" class="btn btn-light o_sfl_icon_btn" aria-label="Zoom in" t-on-click="() => this.setZoom(0.1)">+</button>
                <button t-if="canEdit and anyPlaced" type="button" class="btn btn-light" title="Put every card back in its own place" t-on-click="tidy">Tidy layout</button>
                <button t-if="canEdit" type="button" class="btn btn-light" t-on-click="toggleLive">
                    <t t-if="isLive">Pause</t><t t-else="">Go live</t>
                </button>
            </div>

            <div class="o_sfl_body">
                <div class="o_sfl_canvas_wrap" t-on-click.self="() => this.select(false)">
                    <div t-if="!state.data.steps.length" class="o_sfl_empty">
                        This flow has no steps yet. Add the first one.
                    </div>
                    <div t-else="" class="o_sfl_canvas" t-ref="canvas" t-att-style="canvasStyle" t-on-click.self="() => this.select(false)">
                        <svg class="o_sfl_lines" aria-hidden="true" t-att-width="layout.width" t-att-height="layout.height">
                            <defs>
                                <marker id="o_sfl_arrow" orient="auto" markerWidth="6" markerHeight="6" refX="3" refY="3">
                                    <path d="M0 0 L6 3 L0 6 Z"/>
                                </marker>
                            </defs>
                            <path t-foreach="layout.edges" t-as="edge" t-key="edge.key" t-att-d="edge.path" marker-end="url(#o_sfl_arrow)"/>
                        </svg>
                        <t t-foreach="layout.edges" t-as="edge" t-key="edge.key">
                            <div t-if="edge.label" class="o_sfl_edge_label" t-att-style="edge.labelStyle">
                                <span t-esc="edge.label"/>
                            </div>
                        </t>
                        <button t-foreach="layout.nodes" t-as="node" t-key="node.step.id" type="button"
                                t-att-class="cardClass(node)" t-att-style="cardStyle(node)"
                                t-att-data-step="node.step.id"
                                t-att-aria-pressed="node.step.id === state.selectedId ? 'true' : 'false'"
                                t-att-title="hasUsage(node.step) ? usageTitle(node) : ''"
                                t-on-pointerdown="(ev) => this.cardDown(ev, node)" t-on-pointermove="cardMove"
                                t-on-pointerup="cardUp" t-on-pointercancel="cardUp"
                                t-on-click="() => this.cardClick(node.step.id)">
                            <span class="o_sfl_card_top">
                                <i t-att-class="kindIcon(node.step.kind)" aria-hidden="true"/>
                                <span class="o_sfl_card_kind" t-esc="kindLabel(node.step.kind)"/>
                                <span t-if="node.step.id === state.data.flow.entry_id" class="o_sfl_card_tag">Starts here</span>
                                <span t-if="outState(node.step) === 'warn'" class="o_sfl_card_tag o_sfl_warn">
                                    <i class="fa fa-exclamation-triangle" aria-hidden="true"/> Check
                                </span>
                                <span t-if="outState(node.step) === 'skip'" class="o_sfl_card_tag">Skipped</span>
                            </span>
                            <span class="o_sfl_card_name" t-esc="node.step.name"/>
                            <t t-set="out" t-value="cardOut(node.step)"/>
                            <span t-if="out" t-att-class="'o_sfl_as o_sfl_as_' + state.showAs">
                                <span t-if="out.body or out.header or out.footer or out.image" class="o_sfl_as_text">
                                    <img t-if="out.image" class="o_sfl_as_image" t-att-src="out.image" t-att-alt="node.step.image_alt" loading="lazy"/>
                                    <span t-if="out.header" class="o_sfl_as_header" t-esc="out.header"/>
                                    <span t-if="out.body" t-out="channelText(out.body, state.showAs)"/>
                                    <span t-if="out.footer" class="o_sfl_as_footer" t-esc="out.footer"/>
                                </span>
                                <span t-if="out.options.length" class="o_sfl_as_buttons">
                                    <span t-foreach="out.options" t-as="label" t-key="label_index" t-esc="label"/>
                                </span>
                            </span>
                            <span t-elif="!node.back.length" class="o_sfl_card_text" t-esc="cardText(node.step)"/>
                            <span t-if="node.back.length" class="o_sfl_card_text">Then back to: <t t-esc="node.back.join(', ')"/></span>
                            <span t-if="hasUsage(node.step)" class="o_sfl_card_usage">
                                <i class="fa fa-user" aria-hidden="true"/>
                                <span t-esc="node.step.reached"/>
                                <span class="o_sfl_card_bar"><span t-att-style="'width:' + reachPct(node.step) + '%'"/></span>
                                <span t-esc="reachPct(node.step) + '%'"/>
                            </span>
                        </button>
                    </div>
                </div>

                <div t-att-class="'o_sfl_panel' + (state.panel === 'device' ? ' o_sfl_panel_' + state.device : '')">
                    <div class="o_sfl_tabs" role="group" aria-label="Panel">
                        <button type="button" class="o_sfl_tab" t-att-class="{active: state.panel === 'step'}"
                                t-att-aria-pressed="state.panel === 'step' ? 'true' : 'false'"
                                t-on-click="() => this.state.panel = 'step'">
                            <t t-if="state.draft">Step</t><t t-else="">Flow</t>
                        </button>
                        <button type="button" class="o_sfl_tab" t-att-class="{active: state.panel === 'try'}"
                                t-att-aria-pressed="state.panel === 'try' ? 'true' : 'false'"
                                t-on-click="openTry">Try it</button>
                        <button t-if="state.data.flow.device_url" type="button" class="o_sfl_tab" t-att-class="{active: state.panel === 'device'}"
                                t-att-aria-pressed="state.panel === 'device' ? 'true' : 'false'"
                                t-on-click="openDevice">Device</button>
                    </div>
                    <t t-if="state.panel === 'try'" t-call="sediba_flows.Try"/>
                    <t t-elif="state.panel === 'device'" t-call="sediba_flows.Device"/>
                    <t t-elif="state.draft" t-call="sediba_flows.Step"/>
                    <t t-else="" t-call="sediba_flows.Flow"/>
                </div>
            </div>
        </div>
    </t>

    <!-- ── Panel: the flow (nothing selected) ────────────────────────────── -->
    <t t-name="sediba_flows.Flow">
        <fieldset class="o_sfl_form" t-att-disabled="!canEdit">
            <span class="o_sfl_muted">Click a step to change it. These settings are for the whole flow.</span>
            <div t-if="state.data.flow.notes and state.data.flow.notes.length" class="o_sfl_group o_sfl_notes">
                <b>Brought over from an older bot</b>
                <span class="o_sfl_muted o_sfl_small">Read these before going live. The older bot is unchanged.</span>
                <ul>
                    <li t-foreach="state.data.flow.notes" t-as="note" t-key="note_index" t-esc="note"/>
                </ul>
            </div>
            <div class="o_sfl_group">
                <b>Runs on</b>
                <label t-foreach="state.data.channels" t-as="channel" t-key="channel.id" class="o_sfl_check">
                    <input type="checkbox" t-att-checked="state.data.flow.channel_ids.includes(channel.id)"
                           t-on-change="() => this.toggleChannel(channel.id)"/>
                    <span t-esc="channel.name"/>
                    <span t-if="!channel.connected" class="o_sfl_muted o_sfl_small">add-on not installed</span>
                </label>
            </div>
            <div class="o_sfl_field">
                <label for="o_sfl_entry">Starts at</label>
                <select id="o_sfl_entry" class="o_sfl_input" t-on-change="(ev) => this.saveFlow({ entry_id: Number(ev.target.value) || false })">
                    <option value="" t-att-selected="!state.data.flow.entry_id">Not chosen</option>
                    <option t-foreach="state.data.steps" t-as="s" t-key="s.id" t-att-value="s.id"
                            t-att-selected="s.id === state.data.flow.entry_id" t-esc="s.name"/>
                </select>
            </div>
        </fieldset>
    </t>

    <!-- ── Panel: one step ───────────────────────────────────────────────── -->
    <t t-name="sediba_flows.Step">
        <t t-set="d" t-value="state.draft"/>
        <fieldset class="o_sfl_form" t-att-disabled="!canEdit" t-on-input="touch">
            <div class="o_sfl_field">
                <label for="o_sfl_kind">Kind</label>
                <select id="o_sfl_kind" class="o_sfl_input" t-on-change="(ev) => this.setField('kind', ev.target.value)">
                    <option t-foreach="KINDS" t-as="kind" t-key="kind[0]" t-att-value="kind[0]"
                            t-att-selected="kind[0] === d.kind" t-esc="kind[1]"/>
                </select>
            </div>
            <div class="o_sfl_field">
                <label for="o_sfl_name">Name</label>
                <input id="o_sfl_name" type="text" class="o_sfl_input" t-model="d.name" t-on-change="saveStep"/>
            </div>

            <div t-if="d.kind === 'message' or d.kind === 'menu' or d.kind === 'input'" class="o_sfl_field">
                <label for="o_sfl_header">Header, optional</label>
                <input id="o_sfl_header" type="text" class="o_sfl_input" maxlength="60" placeholder="A short line above the text" t-model="d.header" t-on-change="saveStep"/>
            </div>
            <div t-if="d.kind === 'message' or d.kind === 'menu' or d.kind === 'input'" class="o_sfl_field">
                <label for="o_sfl_body">What the flow says</label>
                <textarea id="o_sfl_body" rows="3" class="o_sfl_input" t-model="d.body" t-on-change="saveStep"/>
                <span class="o_sfl_muted o_sfl_small">{{contact.first_name}} puts in the contact's first name.</span>
            </div>
            <t t-if="d.kind === 'message' or d.kind === 'menu' or d.kind === 'input'">
                <div class="o_sfl_field">
                    <label for="o_sfl_footer">Footer, optional</label>
                    <input id="o_sfl_footer" type="text" class="o_sfl_input" maxlength="60" placeholder="A short line under the text" t-model="d.footer" t-on-change="saveStep"/>
                </div>
                <div class="o_sfl_field">
                    <label for="o_sfl_image">Image, optional</label>
                    <input id="o_sfl_image" type="url" class="o_sfl_input" placeholder="https://… the address of a picture" t-model="d.image_url" t-on-change="saveStep"/>
                    <t t-if="d.image_url">
                        <label for="o_sfl_image_alt">What the image shows</label>
                        <input id="o_sfl_image_alt" type="text" class="o_sfl_input" placeholder="for example: our office in Soweto" t-model="d.image_alt" t-on-change="saveStep"/>
                        <span class="o_sfl_muted o_sfl_small">Channels without pictures get these words: USSD and SMS print them, voice reads them out.</span>
                    </t>
                    <span t-else="" class="o_sfl_muted o_sfl_small">Header and footer show as their own lines on WhatsApp and web chat. Elsewhere they are the first and last line of the text.</span>
                </div>
            </t>

            <div t-if="d.kind === 'menu'" class="o_sfl_group">
                <b>Choices</b>
                <div t-foreach="d.options" t-as="option" t-key="option_index" class="o_sfl_choice">
                    <input type="text" class="o_sfl_input" t-att-aria-label="'Choice ' + (option_index + 1)" placeholder="What the contact picks"
                           t-model="option.label" t-on-change="saveStep"/>
                    <div class="o_sfl_choice_then">
                        <select class="o_sfl_input" t-att-aria-label="'Step after choice ' + (option_index + 1)"
                                t-on-change="(ev) => this.setOption(option, 'next_id', ev.target.value, true)">
                            <option value="" t-att-selected="!option.next_id">Then: not chosen</option>
                            <option t-foreach="otherSteps(d.id)" t-as="s" t-key="s.id" t-att-value="s.id"
                                    t-att-selected="s.id === option.next_id">Then: <t t-esc="s.name"/></option>
                        </select>
                        <button t-if="option.id and !option.next_id" type="button" class="btn btn-light" t-on-click="() => this.addStep(false, option.id)">New step</button>
                        <button type="button" class="btn btn-light o_sfl_icon_btn" t-att-aria-label="'Remove choice ' + (option_index + 1)" title="Remove"
                                t-on-click="() => this.removeChoice(option_index)">
                            <i class="fa fa-trash-o" aria-hidden="true"/>
                        </button>
                    </div>
                </div>
                <button type="button" class="btn btn-light o_sfl_start" t-on-click="addChoice">Add a choice</button>
            </div>

            <t t-if="d.kind === 'input'">
                <div class="o_sfl_field">
                    <label for="o_sfl_input_type">The answer should be</label>
                    <select id="o_sfl_input_type" class="o_sfl_input" t-on-change="(ev) => this.setField('input_type', ev.target.value)">
                        <option t-foreach="INPUT_TYPES" t-as="type" t-key="type[0]" t-att-value="type[0]"
                                t-att-selected="type[0] === d.input_type" t-esc="type[1]"/>
                    </select>
                </div>
                <div class="o_sfl_field">
                    <label for="o_sfl_save_to">Keep the answer as</label>
                    <input id="o_sfl_save_to" type="text" class="o_sfl_input" placeholder="for example: province" t-model="d.save_to" t-on-change="saveStep"/>
                    <span class="o_sfl_muted o_sfl_small">Later steps can use it as {{state.province}}.</span>
                </div>
            </t>

            <div t-if="d.kind === 'condition'" class="o_sfl_group">
                <div class="o_sfl_field">
                    <label for="o_sfl_condition">Check</label>
                    <input id="o_sfl_condition" type="text" class="o_sfl_input" placeholder="for example: {{state.province}}" t-model="d.condition" t-on-change="saveStep"/>
                    <span t-if="d.condition_mode !== 'equals'" class="o_sfl_muted o_sfl_small">It has a value when it is not empty, 0, no or false.</span>
                    <span t-else="" class="o_sfl_muted o_sfl_small">Capital letters and spaces around the value do not matter.</span>
                </div>
                <div class="o_sfl_field">
                    <label for="o_sfl_cond_mode">Branch on</label>
                    <select id="o_sfl_cond_mode" class="o_sfl_input" t-on-change="(ev) => this.setField('condition_mode', ev.target.value)">
                        <option value="truthy" t-att-selected="d.condition_mode !== 'equals'">Whether it has a value</option>
                        <option value="equals" t-att-selected="d.condition_mode === 'equals'">Which value it has</option>
                    </select>
                </div>
                <t t-if="d.condition_mode !== 'equals'">
                <div class="o_sfl_field">
                    <label for="o_sfl_if">If so, go to</label>
                    <select id="o_sfl_if" class="o_sfl_input" t-on-change="(ev) => this.setBranch(false, ev.target.value)">
                        <option value="" t-att-selected="!(branch(false) and branch(false).next_id)">Not chosen</option>
                        <option t-foreach="otherSteps(d.id)" t-as="s" t-key="s.id" t-att-value="s.id"
                                t-att-selected="branch(false) and s.id === branch(false).next_id" t-esc="s.name"/>
                    </select>
                </div>
                </t>
                <t t-else="">
                    <b>When it is</b>
                    <div t-foreach="valueBranches" t-as="option" t-key="option_index" class="o_sfl_choice">
                        <input type="text" class="o_sfl_input" t-att-aria-label="'Value ' + (option_index + 1)" placeholder="a value, for example: lead"
                               t-model="option.label" t-on-change="saveStep"/>
                        <div class="o_sfl_choice_then">
                            <select class="o_sfl_input" t-att-aria-label="'Step when it is value ' + (option_index + 1)"
                                    t-on-change="(ev) => this.setOption(option, 'next_id', ev.target.value, true)">
                                <option value="" t-att-selected="!option.next_id">Then: not chosen</option>
                                <option t-foreach="otherSteps(d.id)" t-as="s" t-key="s.id" t-att-value="s.id"
                                        t-att-selected="s.id === option.next_id">Then: <t t-esc="s.name"/></option>
                            </select>
                            <button type="button" class="btn btn-light o_sfl_icon_btn" t-att-aria-label="'Remove value ' + (option_index + 1)" title="Remove"
                                    t-on-click="() => this.removeOption(option)">
                                <i class="fa fa-trash-o" aria-hidden="true"/>
                            </button>
                        </div>
                    </div>
                    <button type="button" class="btn btn-light o_sfl_start" t-on-click="addChoice">Add a value</button>
                </t>
                <div class="o_sfl_field">
                    <label for="o_sfl_else">Otherwise, go to</label>
                    <select id="o_sfl_else" class="o_sfl_input" t-on-change="(ev) => this.setBranch(true, ev.target.value)">
                        <option value="" t-att-selected="!(branch(true) and branch(true).next_id)">Not chosen</option>
                        <option t-foreach="otherSteps(d.id)" t-as="s" t-key="s.id" t-att-value="s.id"
                                t-att-selected="branch(true) and s.id === branch(true).next_id" t-esc="s.name"/>
                    </select>
                </div>
            </div>

            <t t-if="d.kind === 'llm'">
                <div class="o_sfl_field">
                    <label for="o_sfl_prompt">Instructions for the AI</label>
                    <textarea id="o_sfl_prompt" rows="4" class="o_sfl_input" t-model="d.llm_prompt" t-on-change="saveStep"/>
                </div>
                <label class="o_sfl_check">
                    <input type="checkbox" t-att-checked="d.llm_use_sediba" t-on-change="(ev) => this.setField('llm_use_sediba', ev.target.checked)"/>
                    <span>Answer from Sediba</span>
                </label>
            </t>

            <div t-if="d.kind === 'handoff'" class="o_sfl_field">
                <label for="o_sfl_handoff">What the contact is told</label>
                <input id="o_sfl_handoff" type="text" class="o_sfl_input" t-model="d.handoff_message" t-on-change="saveStep"/>
            </div>

            <div t-if="d.kind === 'jump'" class="o_sfl_field">
                <label for="o_sfl_jump">Carry on in the flow</label>
                <select id="o_sfl_jump" class="o_sfl_input" t-on-change="(ev) => this.setField('jump_bot_id', ev.target.value, true)">
                    <option value="" t-att-selected="!d.jump_bot_id">This flow, at the step below</option>
                    <option t-foreach="state.data.flows" t-as="flow" t-key="flow.id" t-att-value="flow.id"
                            t-att-selected="flow.id === d.jump_bot_id" t-esc="flow.name"/>
                </select>
            </div>

            <label t-if="d.kind === 'jump' and d.jump_bot_id" class="o_sfl_check">
                <input type="checkbox" t-att-checked="d.jump_return" t-on-change="(ev) => this.setField('jump_return', ev.target.checked)"/>
                <span>Come back here when that flow ends</span>
            </label>

            <t t-if="d.kind === 'set_variable'">
                <div class="o_sfl_field">
                    <label for="o_sfl_var_name">Keep as</label>
                    <input id="o_sfl_var_name" type="text" class="o_sfl_input" placeholder="for example: province" t-model="d.variable_name" t-on-change="saveStep"/>
                </div>
                <div class="o_sfl_field">
                    <label for="o_sfl_var_value">The value</label>
                    <input id="o_sfl_var_value" type="text" class="o_sfl_input" placeholder="a fixed text, or {{state.other}}" t-model="d.variable_value" t-on-change="saveStep"/>
                    <span class="o_sfl_muted o_sfl_small">Later steps can use it as {{state.province}}.</span>
                </div>
            </t>

            <div t-if="d.kind === 'wait'" class="o_sfl_field">
                <label for="o_sfl_wait">Wait, in seconds</label>
                <input id="o_sfl_wait" type="number" min="0" class="o_sfl_input" t-model="d.wait_seconds" t-on-change="saveStep"/>
            </div>

            <div t-if="d.kind === 'end'" class="o_sfl_field">
                <label for="o_sfl_outcome">How it ended, for reports</label>
                <input id="o_sfl_outcome" type="text" class="o_sfl_input" placeholder="for example: done" t-model="d.end_outcome" t-on-change="saveStep"/>
            </div>

            <div t-if="['message', 'input', 'action', 'llm', 'wait', 'jump', 'channel_switch', 'set_variable'].includes(d.kind) and !(d.kind === 'jump' and d.jump_bot_id and !d.jump_return)" class="o_sfl_field">
                <label for="o_sfl_next">Then</label>
                <div class="o_sfl_choice_then">
                    <select id="o_sfl_next" class="o_sfl_input" t-on-change="(ev) => this.setField(thenField, ev.target.value, true)">
                        <option value="" t-att-selected="!d[thenField]">Nothing: the flow stops here</option>
                        <option t-foreach="otherSteps(d.id)" t-as="s" t-key="s.id" t-att-value="s.id"
                                t-att-selected="s.id === d[thenField]" t-esc="s.name"/>
                    </select>
                    <button t-if="d.kind !== 'jump'" type="button" class="btn btn-light" t-on-click="() => this.addStep(d.id, false)">New step</button>
                </div>
            </div>

            <div t-if="flowChannels.length" class="o_sfl_group o_sfl_out">
                <b>How it comes out</b>
                <div t-foreach="flowChannels" t-as="channel" t-key="channel.id" class="o_sfl_out_row">
                    <t t-set="out" t-value="d.out[channel.code]"/>
                    <div class="o_sfl_row">
                        <span t-esc="channel.name"/>
                        <span class="o_sfl_muted" t-esc="out ? out.how : ''"/>
                    </div>
                    <div t-if="out and out.note" class="o_sfl_note">
                        <i class="fa fa-exclamation-triangle" aria-hidden="true"/> <t t-esc="out.note"/>
                    </div>
                    <div t-elif="out and out.limit and out.chars" class="o_sfl_muted o_sfl_small">
                        <t t-esc="out.chars"/> of <t t-esc="out.limit"/> characters
                    </div>
                </div>
            </div>
            <div t-else="" class="o_sfl_note">
                This flow runs on no channel yet. Click an empty part of the canvas, then tick the channels under Runs on.
            </div>

            <t t-if="flowChannels.length and (d.kind === 'message' or d.kind === 'menu' or d.kind === 'input')">
                <button t-if="!state.wording" type="button" class="btn btn-light o_sfl_start" t-on-click="() => this.state.wording = true">Different wording for one channel</button>
                <div t-else="" class="o_sfl_group">
                    <b>Different wording for one channel</b>
                    <div t-foreach="d.overrides" t-as="row" t-key="row.channel_id" class="o_sfl_field">
                        <t t-set="channel" t-value="state.data.channels.find((c) => c.id === row.channel_id)"/>
                        <label t-att-for="'o_sfl_ov_' + row.channel_id" t-esc="channel.name"/>
                        <textarea t-att-id="'o_sfl_ov_' + row.channel_id" rows="2" class="o_sfl_input" placeholder="Leave empty to use the wording above"
                                  t-model="row.body" t-on-change="saveStep"/>
                        <label class="o_sfl_check">
                            <input type="checkbox" t-att-checked="row.hide" t-on-change="(ev) => this.setHide(row, ev.target.checked)"/>
                            <span>Skip this step on <t t-esc="channel.name"/></span>
                        </label>
                    </div>
                </div>
            </t>

            <div class="o_sfl_foot">
                <button type="button" class="btn btn-light" t-on-click="moreSettings">More settings</button>
                <button type="button" class="btn btn-light o_sfl_danger" t-on-click="deleteStep">Delete step</button>
            </div>
        </fieldset>
    </t>

    <!-- ── Panel: try the flow ───────────────────────────────────────────── -->
    <t t-name="sediba_flows.Try">
        <t t-set="sim" t-value="state.sim"/>
        <div class="o_sfl_form o_sfl_try">
            <div t-if="!flowChannels.length" class="o_sfl_note">Choose a channel for this flow first: open the Flow tab and tick one under Runs on.</div>

            <!-- Before a walk: who the test contact is, and the variables to start with. -->
            <t t-elif="!sim.session">
                <div class="o_sfl_field">
                    <label for="o_sfl_try_channel">Try it on</label>
                    <select id="o_sfl_try_channel" class="o_sfl_input" t-model="sim.channel">
                        <option t-foreach="flowChannels" t-as="channel" t-key="channel.id" t-att-value="channel.code" t-esc="channel.name"/>
                    </select>
                </div>
                <t t-call="sediba_flows.TryContact"/>
                <div t-if="sim.error" class="o_sfl_note" t-esc="sim.error"/>
                <button type="button" class="btn btn-primary" t-att-disabled="sim.busy or !sim.ready" t-on-click="simStart">Start</button>
                <span class="o_sfl_muted o_sfl_small">You walk the flow as this test contact. Nothing is sent and AI steps are not run.</span>
            </t>

            <!-- During a walk. -->
            <t t-else="">
                <div class="o_sfl_try_head">
                    <span class="o_sfl_try_channel" t-esc="simChannelName"/>
                    <button type="button" class="o_sfl_try_who" t-att-aria-expanded="sim.editing ? 'true' : 'false'"
                            title="Change the contact or the variables" t-on-click="() => this.state.sim.editing = !this.state.sim.editing">
                        <i class="fa fa-user" aria-hidden="true"/>
                        <span t-esc="sim.name or sim.mobile"/>
                        <i class="fa fa-pencil" aria-hidden="true"/>
                    </button>
                    <button type="button" class="btn btn-light o_sfl_icon_btn" aria-label="Start again" title="Start again" t-on-click="simRestart">
                        <i class="fa fa-refresh" aria-hidden="true"/>
                    </button>
                </div>

                <t t-if="sim.editing">
                    <b>Change the contact and variables</b>
                    <t t-call="sediba_flows.TryContact"/>
                    <button type="button" class="btn btn-primary" t-att-disabled="sim.busy" t-on-click="simApply">Apply changes</button>
                    <span class="o_sfl_muted o_sfl_small">The walk carries on from where it is, with these values.</span>
                </t>
                <t t-else="">
                    <div t-if="sim.error" class="o_sfl_note" t-esc="sim.error"/>

                    <!-- USSD: one handset screen at a time. -->
                    <div t-if="sim.channel === 'ussd'" class="o_sfl_handset" aria-live="polite">
                        <div class="o_sfl_handset_text" t-esc="simScreen"/>
                        <div t-if="sim.waiting === 'done'" class="o_sfl_handset_end">Session ended.</div>
                    </div>

                    <!-- Every other channel: the conversation so far. -->
                    <div t-else="" t-att-class="'o_sfl_chat o_sfl_chat_' + sim.channel" aria-live="polite">
                        <div t-foreach="sim.messages" t-as="message" t-key="message_index"
                             t-att-class="'o_sfl_bubble ' + (message.direction === 'inbound' ? 'o_sfl_mine' : '')">
                            <img t-if="message.image" class="o_sfl_as_image" t-att-src="message.image" alt=""/>
                            <span t-if="message.header" class="o_sfl_as_header" t-esc="message.header"/>
                            <span t-out="simBody(message)"/>
                            <span t-if="message.footer" class="o_sfl_as_footer" t-esc="message.footer"/>
                        </div>
                        <div t-if="simButtons.length" class="o_sfl_wa_buttons">
                            <button t-foreach="simButtons" t-as="option" t-key="option_index" type="button"
                                    t-att-disabled="sim.busy" t-on-click="() => this.simSend(option.label)" t-esc="option.label"/>
                        </div>
                        <div t-if="sim.waiting === 'done'" class="o_sfl_muted o_sfl_small">The flow has ended.</div>
                    </div>

                    <div t-if="sim.waiting === 'menu' and sim.options.length and !simButtons.length and sim.channel !== 'ussd'" class="o_sfl_quick">
                        <button t-foreach="sim.options" t-as="option" t-key="option_index" type="button" class="btn btn-light"
                                t-att-disabled="sim.busy" t-on-click="() => this.simSend(option.label)" t-esc="option.label"/>
                    </div>
                    <div t-if="sim.waiting !== 'done'" class="o_sfl_choice_then">
                        <input type="text" class="o_sfl_input" aria-label="Your reply"
                               t-att-placeholder="sim.channel === 'ussd' ? 'Type a number or an answer' : 'Reply as the contact'"
                               t-ref="simInput" t-model="sim.input" t-on-keydown="simKey"/>
                        <button type="button" class="btn btn-light" t-att-disabled="sim.busy" t-on-click="() => this.simSend()">Send</button>
                    </div>
                </t>
            </t>
        </div>
    </t>

    <!-- ── Panel: the web chat widget inside a device ────────────────────── -->
    <t t-name="sediba_flows.Device">
        <div class="o_sfl_form o_sfl_device">
            <div class="o_sfl_try_head">
                <div class="o_sfl_pills" role="group" aria-label="Device">
                    <button t-foreach="devices" t-as="device" t-key="device[0]" type="button" class="o_sfl_pill"
                            t-att-class="{active: state.device === device[0]}"
                            t-att-aria-pressed="state.device === device[0] ? 'true' : 'false'"
                            t-on-click="() => this.pickDevice(device[0])" t-esc="device[1]"/>
                </div>
                <span class="o_sfl_grow"/>
                <button type="button" class="btn btn-light o_sfl_icon_btn" aria-label="Start again" title="Start again" t-on-click="openDevice">
                    <i class="fa fa-refresh" aria-hidden="true"/>
                </button>
            </div>
            <span class="o_sfl_muted o_sfl_small">The web chat widget as a visitor sees it. It is a preview: nothing is sent and AI steps are not run.</span>
            <div class="o_sfl_device_scroll">
                <div t-att-class="'o_sfl_device_shell o_sfl_device_' + state.device">
                    <div t-if="state.device === 'desktop'" class="o_sfl_browser_bar" aria-hidden="true"><span/><span/><span/></div>
                    <iframe t-att-src="deviceUrl" t-key="deviceUrl" title="Web chat preview"/>
                </div>
            </div>
        </div>
    </t>

    <!-- The test contact and the variables, before a walk and while changing them. -->
    <t t-name="sediba_flows.TryContact">
        <t t-set="sim" t-value="state.sim"/>
        <div class="o_sfl_field">
            <label for="o_sfl_try_name">Contact's name</label>
            <input id="o_sfl_try_name" type="text" class="o_sfl_input" t-model="sim.name"/>
        </div>
        <div class="o_sfl_field">
            <label for="o_sfl_try_mobile">Mobile number</label>
            <input id="o_sfl_try_mobile" type="tel" class="o_sfl_input" t-model="sim.mobile"/>
        </div>
        <div t-foreach="sim.groups" t-as="group" t-key="group.flow_id" class="o_sfl_group">
            <b>
                <t t-if="group.is_this_flow">Variables</t>
                <t t-else="">Variables of “<t t-esc="group.flow_name"/>”</t>
            </b>
            <div t-foreach="group.variables" t-as="variable" t-key="variable.name" class="o_sfl_field">
                <label t-att-for="'o_sfl_try_var_' + variable.name">
                    <t t-esc="variable.name"/> <span class="o_sfl_small">(<t t-esc="variable.type"/>)</span>
                </label>
                <input t-att-id="'o_sfl_try_var_' + variable.name" class="o_sfl_input"
                       t-att-type="variable.type === 'int' or variable.type === 'float' ? 'number' : 'text'"
                       placeholder="Not set" t-model="variable.value"/>
            </div>
        </div>
    </t>

</templates>
