<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Security Groups -->
        <record id="group_contact_centre_user" model="res.groups">
            <field name="name">Contact Centre User</field>
            <field name="category_id" ref="base.module_category_customer_relationship_management"/>
            <field name="comment">Can view and send messages, use scripts</field>
        </record>

        <record id="group_contact_centre_agent" model="res.groups">
            <field name="name">Contact Centre Agent</field>
            <field name="category_id" ref="base.module_category_customer_relationship_management"/>
            <field name="comment">Can assign messages, use scripts, manage conversations</field>
            <field name="implied_ids" eval="[(4, ref('group_contact_centre_user'))]"/>
        </record>

        <record id="group_contact_centre_manager" model="res.groups">
            <field name="name">Contact Centre Manager</field>
            <field name="category_id" ref="base.module_category_customer_relationship_management"/>
            <field name="comment">Can manage campaigns, scripts, and configurations</field>
            <field name="implied_ids" eval="[(4, ref('group_contact_centre_agent'))]"/>
        </record>

        <record id="group_contact_centre_admin" model="res.groups">
            <field name="name">Contact Centre Administrator</field>
            <field name="category_id" ref="base.module_category_customer_relationship_management"/>
            <field name="comment">Full access including API configuration</field>
            <field name="implied_ids" eval="[(4, ref('group_contact_centre_manager'))]"/>
        </record>

        <!-- Gen-1 inbox: agents see messages assigned to them plus the
             unassigned queue; managers see everything. -->
        <record id="rule_contact_centre_message_agent" model="ir.rule">
            <field name="name">Contact centre message: own or unassigned</field>
            <field name="model_id" ref="model_contact_centre_message"/>
            <field name="domain_force">['|', ('assigned_user_id', '=', False), ('assigned_user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="rule_contact_centre_message_manager" model="ir.rule">
            <field name="name">Contact centre message: managers see all</field>
            <field name="model_id" ref="model_contact_centre_message"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_contact_centre_manager')), (4, ref('base.group_system'))]"/>
        </record>
    </data>
</odoo>
