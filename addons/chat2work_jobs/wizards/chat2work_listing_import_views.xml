<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chat2work_listing_import_form" model="ir.ui.view">
        <field name="name">chat2work.listing.import.form</field>
        <field name="model">chat2work.listing.import</field>
        <field name="arch" type="xml">
            <form string="Import Job Listings">
                <div class="alert alert-success" role="status" invisible="not result">
                    <field name="result"/>
                </div>
                <group invisible="result">
                    <field name="source_id"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                    <field name="close_missing"/>
                </group>
                <p class="text-muted" invisible="result">
                    Columns: title (required), external_ref, employer, location, province, field,
                    employment_type, salary, description, requirements, apply_url, apply_contact,
                    posted_on, closing_on (dates as YYYY-MM-DD). For several provinces, separate them
                    with a semicolon (Gauteng; Limpopo), or use "National" for all. Importing the same listing again updates it.
                </p>
                <footer>
                    <button name="action_import" type="object" string="Import" class="btn-primary" invisible="result"/>
                    <button special="cancel" string="Close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_chat2work_listing_import" model="ir.actions.act_window">
        <field name="name">Import Job Listings</field>
        <field name="res_model">chat2work.listing.import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
