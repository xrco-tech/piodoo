<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chat2work_listing_list" model="ir.ui.view">
        <field name="name">chat2work.listing.list</field>
        <field name="model">chat2work.listing</field>
        <field name="arch" type="xml">
            <list string="Job Listings" decoration-muted="state == 'closed'">
                <header>
                    <button name="action_mark_verified" type="object" string="Mark verified" class="btn-primary"/>
                    <button name="action_mark_invalid" type="object" string="Mark invalid"/>
                    <button name="action_mark_unverified" type="object" string="Back to unverified"/>
                </header>
                <field name="title"/>
                <field name="employer"/>
                <field name="province_ids" widget="many2many_tags"/>
                <field name="location" optional="show"/>
                <field name="field" optional="show"/>
                <field name="occupation_id" optional="show"/>
                <field name="nqf_min" optional="hide"/>
                <field name="closing_on"/>
                <field name="verification_state" widget="badge" decoration-success="verification_state == 'verified'"
                       decoration-danger="verification_state in ('invalid', 'cancelled')" decoration-warning="verification_state == 'unverified'"/>
                <field name="suggested_count"/>
                <field name="source_id" optional="hide"/>
                <field name="content_updated_at" optional="show"/>
                <field name="state" widget="badge" decoration-success="state == 'open'"/>
            </list>
        </field>
    </record>
    <record id="view_chat2work_listing_form" model="ir.ui.view">
        <field name="name">chat2work.listing.form</field>
        <field name="model">chat2work.listing</field>
        <field name="arch" type="xml">
            <form string="Job Listing">
                <header>
                    <button name="action_mark_verified" type="object" string="Mark verified" class="btn-primary"
                            invisible="not id or verification_state == 'verified'"/>
                    <button name="action_mark_invalid" type="object" string="Mark invalid"
                            invisible="not id or verification_state == 'invalid'"/>
                    <button name="action_mark_cancelled" type="object" string="Cancelled by employer"
                            invisible="not id or verification_state == 'cancelled'"/>
                    <button name="action_mark_unverified" type="object" string="Back to unverified"
                            invisible="not id or verification_state == 'unverified'"/>
                    <button name="action_suggest_candidates" type="object" string="Suggest candidates"
                            invisible="state != 'open' or verification_state != 'verified' or not id"/>
                    <field name="state" widget="statusbar" options="{'clickable': '1'}"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="title"/>
                        <h1><field name="title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="employer"/>
                            <field name="province_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="location"/>
                            <field name="field"/>
                            <label for="occupation_id"/>
                            <div class="o_row">
                                <field name="occupation_id" options="{'no_create': True}"/>
                                <button name="action_suggest_occupation" type="object" string="Suggest" icon="fa-magic"
                                        class="btn-link" invisible="not id" help="From the title, then the AI"/>
                            </div>
                            <field name="occupation_source" invisible="not occupation_id"/>
                            <field name="nqf_min"/>
                            <field name="nqf_required" invisible="not nqf_min"/>
                            <field name="employment_type"/>
                            <field name="salary"/>
                        </group>
                        <group>
                            <field name="verification_state" widget="badge" decoration-success="verification_state == 'verified'"
                                   decoration-danger="verification_state in ('invalid', 'cancelled')" decoration-warning="verification_state == 'unverified'"/>
                            <field name="verified_by_id" invisible="not verified_by_id"/>
                            <field name="verified_at" invisible="not verified_at"/>
                            <field name="verification_note"/>
                            <field name="apply_url" widget="url"/>
                            <field name="apply_contact"/>
                            <field name="posted_on"/>
                            <field name="closing_on"/>
                            <field name="source_id"/>
                            <field name="first_seen_at"/>
                            <field name="content_updated_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Candidates" name="candidates">
                            <field name="match_ids">
                                <list editable="bottom" decoration-muted="state == 'rejected'" decoration-success="state == 'approved'">
                                    <field name="candidate_id"/>
                                    <field name="candidate_phone"/>
                                    <field name="candidate_status"/>
                                    <field name="candidate_cv_state"/>
                                    <field name="score"/>
                                    <field name="reason"/>
                                    <field name="note" optional="show"/>
                                    <field name="state" widget="badge" decoration-warning="state == 'suggested'"
                                           decoration-success="state == 'approved'"/>
                                    <field name="notify_state" optional="show" readonly="1"/>
                                    <field name="response" optional="show" readonly="1"/>
                                    <button name="action_approve" type="object" string="Good match" icon="fa-check"
                                            invisible="state == 'approved'"/>
                                    <button name="action_reject" type="object" string="Not a match" icon="fa-times"
                                            invisible="state == 'rejected'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description"/>
                        </page>
                        <page string="Requirements" name="requirements">
                            <field name="requirements"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_chat2work_listing_kanban" model="ir.ui.view">
        <field name="name">chat2work.listing.kanban</field>
        <field name="model">chat2work.listing</field>
        <field name="arch" type="xml">
            <kanban default_group_by="work_state" group_create="false" group_delete="false" group_edit="false"
                    quick_create="false" records_draggable="false" sample="1">
                <field name="suggested_count"/>
                <field name="approved_count"/>
                <field name="closing_on"/>
                <templates>
                    <t t-name="card">
                        <field name="title" class="fw-bold fs-5"/>
                        <field name="employer" class="text-muted"/>
                        <field name="province_ids" widget="many2many_tags"/>
                        <field name="verification_state" widget="badge" decoration-success="verification_state == 'verified'"
                               decoration-danger="verification_state in ('invalid', 'cancelled')" decoration-warning="verification_state == 'unverified'"/>
                        <div class="text-muted">
                            <field name="location"/>
                            <span t-if="record.location.raw_value and record.field.raw_value"> · </span>
                            <field name="field"/>
                        </div>
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            <span t-if="record.suggested_count.raw_value" class="badge text-bg-warning">
                                <t t-out="record.suggested_count.raw_value"/> to review
                            </span>
                            <span t-if="record.approved_count.raw_value" class="badge text-bg-success">
                                <t t-out="record.approved_count.raw_value"/> good match
                            </span>
                        </div>
                        <footer class="pt-1">
                            <span t-if="record.closing_on.raw_value" class="ms-auto text-muted small">
                                Closes <field name="closing_on"/>
                            </span>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="view_chat2work_listing_search" model="ir.ui.view">
        <field name="name">chat2work.listing.search</field>
        <field name="model">chat2work.listing</field>
        <field name="arch" type="xml">
            <search string="Job Listings">
                <field name="title"/>
                <field name="employer"/>
                <field name="location"/>
                <field name="province_ids"/>
                <filter name="open" string="Open" domain="[('state', '=', 'open')]"/>
                <filter name="closed" string="Closed" domain="[('state', '=', 'closed')]"/>
                <separator/>
                <filter name="unverified" string="Unverified" domain="[('verification_state', '=', 'unverified')]"/>
                <filter name="verified" string="Verified" domain="[('verification_state', '=', 'verified')]"/>
                <filter name="invalid" string="Invalid" domain="[('verification_state', '=', 'invalid')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('verification_state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="no_occupation" string="No occupation" domain="[('occupation_id', '=', False)]"/>
                <filter name="to_review" string="Candidates to review" domain="[('match_ids.state', '=', 'suggested')]"/>
                <separator/>
                <filter name="group_work_state" string="Next step" context="{'group_by': 'work_state'}"/>
                <filter name="group_verification" string="Verification" context="{'group_by': 'verification_state'}"/>
                <filter name="group_province" string="Province" context="{'group_by': 'province_ids'}"/>
                <filter name="group_field" string="Type of work" context="{'group_by': 'field'}"/>
                <filter name="group_occupation" string="Occupation" context="{'group_by': 'occupation_id'}"/>
                <filter name="group_source" string="Source" context="{'group_by': 'source_id'}"/>
            </search>
        </field>
    </record>
    <record id="action_chat2work_listing" model="ir.actions.act_window">
        <field name="name">Job Listings</field>
        <field name="res_model">chat2work.listing</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

    <record id="view_chat2work_listing_source_list" model="ir.ui.view">
        <field name="name">chat2work.listing.source.list</field>
        <field name="model">chat2work.listing.source</field>
        <field name="arch" type="xml">
            <list string="Listing Sources">
                <field name="name"/>
                <field name="kind"/>
                <field name="listing_count"/>
                <field name="last_run_at"/>
                <field name="last_result"/>
            </list>
        </field>
    </record>
    <record id="view_chat2work_listing_source_form" model="ir.ui.view">
        <field name="name">chat2work.listing.source.form</field>
        <field name="model">chat2work.listing.source</field>
        <field name="arch" type="xml">
            <form string="Listing Source">
                <header>
                    <button name="action_fetch_now" type="object" string="Fetch now" class="btn-primary"
                            invisible="kind != 'csv_feed' or not id"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="kind"/>
                            <field name="feed_url" widget="url" invisible="kind != 'csv_feed'" required="kind == 'csv_feed'"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="listing_count"/>
                            <field name="last_run_at"/>
                            <field name="last_result"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_chat2work_listing_source" model="ir.actions.act_window">
        <field name="name">Listing Sources</field>
        <field name="res_model">chat2work.listing.source</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_chat2work_candidate_form_matches" model="ir.ui.view">
        <field name="name">chat2work.candidate.form.matches</field>
        <field name="model">chat2work.candidate</field>
        <field name="inherit_id" ref="chat2work.view_chat2work_candidate_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='stage']" position="before">
                <field name="job_match_ready_count" invisible="1"/>
                <button name="action_c2w_send_jobs" type="object" string="Send jobs" class="btn-primary"
                        groups="chat2work.group_agent" invisible="not job_match_ready_count"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <notebook>
                    <page string="Job Matches" name="job_matches">
                        <field name="job_match_review_count" invisible="1"/>
                        <div class="alert alert-warning" role="status" invisible="not job_match_review_count">
                            <field name="job_match_review_count" nolabel="1" class="d-inline"/> job match(es) to review.
                            Mark each one a <strong>Good match</strong> or <strong>Not a match</strong>.
                            Good matches go out in the next job alert, or click <strong>Send jobs</strong> to send them now.
                        </div>
                        <field name="listing_match_ids">
                            <list create="0" delete="0" decoration-muted="state == 'rejected'" decoration-success="state == 'approved'">
                                <field name="listing_id" readonly="1"/>
                                <field name="listing_state" optional="show"/>
                                <field name="listing_verification" widget="badge" decoration-success="listing_verification == 'verified'"
                                       decoration-warning="listing_verification == 'unverified'"
                                       decoration-danger="listing_verification in ('invalid', 'cancelled')"/>
                                <field name="score" readonly="1"/>
                                <field name="reason" readonly="1"/>
                                <field name="note" optional="show"/>
                                <field name="state" readonly="1" widget="badge" decoration-warning="state == 'suggested'"
                                       decoration-success="state == 'approved'"/>
                                <field name="notify_state" readonly="1"/>
                                <field name="response" readonly="1"/>
                                <button name="action_approve" type="object" string="Good match" icon="fa-check"
                                        invisible="state == 'approved' or listing_verification != 'verified'"/>
                                <button name="action_reject" type="object" string="Not a match" icon="fa-times"
                                        invisible="state == 'rejected'"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>

    <record id="view_chat2work_candidate_search_matches" model="ir.ui.view">
        <field name="name">chat2work.candidate.search.matches</field>
        <field name="model">chat2work.candidate</field>
        <field name="inherit_id" ref="chat2work.view_chat2work_candidate_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="job_matches_to_review" string="Job matches to review"
                        domain="[('listing_match_ids', 'any', [('state', '=', 'suggested'), ('listing_id.state', '=', 'open')])]"/>
                <filter name="job_matches_to_send" string="Jobs to send"
                        domain="[('listing_match_ids', 'any', [('state', '=', 'approved'), ('notify_state', '!=', 'sent'), ('listing_id.state', '=', 'open')])]"/>
            </xpath>
        </field>
    </record>

    <record id="view_chat2work_candidate_form_education" model="ir.ui.view">
        <field name="name">chat2work.candidate.form.education</field>
        <field name="model">chat2work.candidate</field>
        <field name="inherit_id" ref="chat2work.view_chat2work_candidate_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='field']" position="after">
                <field name="nqf_level"/>
            </xpath>
        </field>
    </record>

    <record id="view_chat2work_occupation_list" model="ir.ui.view">
        <field name="name">chat2work.occupation.list</field>
        <field name="model">chat2work.occupation</field>
        <field name="arch" type="xml">
            <list string="Occupations">
                <field name="code"/>
                <field name="name"/>
                <field name="level" optional="hide"/>
                <field name="parent_id" optional="show"/>
            </list>
        </field>
    </record>
    <record id="view_chat2work_occupation_form" model="ir.ui.view">
        <field name="name">chat2work.occupation.form</field>
        <field name="model">chat2work.occupation</field>
        <field name="arch" type="xml">
            <form string="Occupation">
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="level"/>
                        <field name="parent_id"/>
                        <field name="examples"/>
                    </group>
                    <p class="text-muted">ISCO-08 (International Labour Organization). South Africa's OFO 2021
                        codes start with these four digits, e.g. 2021-4222xx.</p>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_chat2work_occupation_search" model="ir.ui.view">
        <field name="name">chat2work.occupation.search</field>
        <field name="model">chat2work.occupation</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('code', '=like', self + '%'), ('examples', 'ilike', self)]"/>
                <filter name="unit_groups" string="Unit groups" domain="[('level', '=', 4)]"/>
            </search>
        </field>
    </record>
    <record id="action_chat2work_occupation" model="ir.actions.act_window">
        <field name="name">Occupations</field>
        <field name="res_model">chat2work.occupation</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_unit_groups': 1}</field>
    </record>

    <menuitem id="menu_chat2work_listings" name="Job Listings" parent="chat2work.menu_chat2work_root"
              action="action_chat2work_listing" sequence="7"/>
    <menuitem id="menu_chat2work_listing_import" name="Import Listings" parent="chat2work.menu_chat2work_root"
              action="action_chat2work_listing_import" sequence="8"/>
    <menuitem id="menu_chat2work_listing_sources" name="Listing Sources" parent="chat2work.menu_chat2work_root"
              action="action_chat2work_listing_source" sequence="9"/>
    <menuitem id="menu_chat2work_occupations" name="Occupations" parent="chat2work.menu_chat2work_root"
              action="action_chat2work_occupation" sequence="9"/>
</odoo>
