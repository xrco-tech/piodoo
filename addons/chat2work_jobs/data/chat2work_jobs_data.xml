<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="province_gauteng" model="chat2work.province">
            <field name="code">gauteng</field>
            <field name="name">Gauteng</field>
        </record>
        <record id="province_kzn" model="chat2work.province">
            <field name="code">kzn</field>
            <field name="name">KwaZulu-Natal</field>
        </record>
        <record id="province_western_cape" model="chat2work.province">
            <field name="code">western_cape</field>
            <field name="name">Western Cape</field>
        </record>
        <record id="province_eastern_cape" model="chat2work.province">
            <field name="code">eastern_cape</field>
            <field name="name">Eastern Cape</field>
        </record>
        <record id="province_limpopo" model="chat2work.province">
            <field name="code">limpopo</field>
            <field name="name">Limpopo</field>
        </record>
        <record id="province_mpumalanga" model="chat2work.province">
            <field name="code">mpumalanga</field>
            <field name="name">Mpumalanga</field>
        </record>
        <record id="province_north_west" model="chat2work.province">
            <field name="code">north_west</field>
            <field name="name">North West</field>
        </record>
        <record id="province_free_state" model="chat2work.province">
            <field name="code">free_state</field>
            <field name="name">Free State</field>
        </record>
        <record id="province_northern_cape" model="chat2work.province">
            <field name="code">northern_cape</field>
            <field name="name">Northern Cape</field>
        </record>
        <record id="listing_source_manual" model="chat2work.listing.source">
            <field name="name">Manual import</field>
            <field name="kind">manual</field>
        </record>
        <record id="ir_cron_chat2work_listings" model="ir.cron">
            <field name="name">Chat2Work: refresh job listings and suggest candidates</field>
            <field name="model_id" ref="model_chat2work_listing"/>
            <field name="state">code</field>
            <field name="code">model._cron_daily()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_chat2work_job_alerts" model="ir.cron">
            <field name="name">Chat2Work: tell candidates about their job matches</field>
            <field name="model_id" ref="model_chat2work_listing_match"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_job_alerts()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active" eval="True"/>
        </record>
        <record id="wa_template_job_match" model="whatsapp.template">
            <field name="name">chat2work_job_match</field>
            <field name="language">en</field>
            <field name="category">UTILITY</field>
            <field name="body">Hi {{1}}, good news: our team matched you to work that may suit you on Chat2Work. Tap below to see it and tell us if you're interested.</field>
            <field name="footer">Chat2Work never asks for money.</field>
            <field name="description">Job match alert, sent once an agent marks a candidate as a good match. {{1}} is the first name; the buttons' payloads are set when sending.</field>
        </record>
        <record id="wa_template_job_match_see" model="whatsapp.template.button">
            <field name="template_id" ref="wa_template_job_match"/>
            <field name="button_type">QUICK_REPLY</field>
            <field name="text">See my job matches</field>
        </record>
        <record id="wa_template_job_match_later" model="whatsapp.template.button">
            <field name="template_id" ref="wa_template_job_match"/>
            <field name="button_type">QUICK_REPLY</field>
            <field name="text">Not now</field>
        </record>
    </data>
</odoo>
