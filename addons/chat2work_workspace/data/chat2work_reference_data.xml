<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Reference: the Library's verified findings on the topics marked as shown in
         Chat2Work. Read-only; leads never show. Researchers mark topics in the Library. -->
    <record id="sediba_space_chat2work" model="sediba.space">
        <field name="name">Chat2Work</field>
        <field name="code">chat2work</field>
    </record>

    <record id="chat2work.group_agent" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('sediba.group_reader'))]"/>
    </record>

    <record id="action_chat2work_reference" model="ir.actions.client">
        <field name="name">Reference</field>
        <field name="tag">sediba_workspace</field>
        <field name="params" eval="{'space': 'chat2work'}"/>
    </record>
    <menuitem id="menu_chat2work_reference" name="Reference" parent="chat2work.menu_chat2work_root"
              action="action_chat2work_reference" sequence="4"/>
</odoo>
