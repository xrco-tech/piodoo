<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Emails the "left waiting" group about anyone who has waited too long. -->
    <record id="cron_chat2work_waiting_email" model="ir.cron">
        <field name="name">Chat2Work: email about people left waiting</field>
        <field name="model_id" ref="model_chat2work_workspace"/>
        <field name="state">code</field>
        <field name="code">model._cron_waiting_email()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
    </record>
</odoo>
