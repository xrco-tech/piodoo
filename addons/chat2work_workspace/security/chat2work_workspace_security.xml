<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- No groups: these apply to everyone, administrators included. A sidekick chat is its agent's own. -->
    <record id="rule_chat2work_sidekick_chat_own" model="ir.rule">
        <field name="name">Chat2Work sidekick: own chats only</field>
        <field name="model_id" ref="model_chat2work_sidekick_chat"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
    </record>
    <record id="rule_chat2work_sidekick_message_own" model="ir.rule">
        <field name="name">Chat2Work sidekick: messages of own chats only</field>
        <field name="model_id" ref="model_chat2work_sidekick_message"/>
        <field name="domain_force">[('chat_id.user_id', '=', user.id)]</field>
    </record>
</odoo>
