<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_chat2work_candidate_form_cv_design" model="ir.ui.view">
        <field name="name">chat2work.candidate.form.cv.design</field>
        <field name="model">chat2work.candidate</field>
        <field name="inherit_id" ref="chat2work.view_chat2work_candidate_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='cv_attachment_id']" position="after">
                <field name="cv_template_id" options="{'no_create': True}"/>
                <button name="action_c2w_rebuild_cv" type="object" string="Rebuild CV with this design"
                        class="btn-secondary" colspan="2" invisible="cv_state != 'built'"/>
            </xpath>
        </field>
    </record>

    <record id="view_chat2work_cv_template_list" model="ir.ui.view">
        <field name="name">chat2work.cv.template.list</field>
        <field name="model">chat2work.cv.template</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="best_for"/>
                <field name="active" widget="boolean_toggle"/>
                <button name="action_c2w_preview" type="object" icon="fa-eye" title="Preview" string="Preview"/>
                <field name="key" column_invisible="True"/>
                <field name="layout" column_invisible="True"/>
            </list>
        </field>
    </record>
    <record id="action_chat2work_cv_template" model="ir.actions.act_window">
        <field name="name">CV Designs</field>
        <field name="res_model">chat2work.cv.template</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
    </record>
    <menuitem id="menu_chat2work_cv_templates" name="CV Designs" parent="chat2work.menu_chat2work_root"
              action="action_chat2work_cv_template" sequence="50"/>
</odoo>
