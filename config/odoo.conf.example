[options]
; Copy to config/odoo.conf (gitignored) and fill in the secrets.
; Keep the database manager off: with it on, the master password alone
; can back up or drop the database from the internet.
list_db = False
admin_passwd = CHANGE_ME_long_random_master_password
db_host = db
db_port = 5432
db_user = odoo
db_password = CHANGE_ME_same_as_POSTGRES_PASSWORD_in_.env
addons_path = /usr/lib/python3/dist-packages/odoo/addons,/mnt/extra-addons
proxy_mode = True
workers = 4
gevent_port = 8072
http_interface = 0.0.0.0
limit_time_real = 600
limit_time_cpu = 600
